<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty name="SERVICE_NAME" source="spring.application.name" defaultValue="cowork-unknown"/>
    <property name="LOG_ROOT" value="${COWORK_LOG_DIR:-build/logs/cowork}"/>

    <conversionRule conversionWord="module" class="com.cowork.gateway.logging.ModuleNameConverter"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"${SERVICE_NAME}"}</customFields>
            <decorator class="net.logstash.logback.mask.MaskingJsonGeneratorDecorator">
                <valueMask>
                    <!-- Mask signatures even in rejected, case-varied or percent-encoded request paths. -->
                    <value>(?i)(?:[0-9a-f]|%[0-9a-f]{2}){64}</value>
                    <mask>[REDACTED]</mask>
                </valueMask>
            </decorator>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <includeMdcKeyName>teamId</includeMdcKeyName>
            <provider class="net.logstash.logback.composite.loggingevent.LoggingEventPatternJsonProvider">
                <pattern>{"module":"%module"}</pattern>
            </provider>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_ROOT}/${SERVICE_NAME}/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_ROOT}/${SERVICE_NAME}/app.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>10</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"${SERVICE_NAME}"}</customFields>
            <decorator class="net.logstash.logback.mask.MaskingJsonGeneratorDecorator">
                <valueMask>
                    <value>(?i)(?:[0-9a-f]|%[0-9a-f]{2}){64}</value>
                    <mask>[REDACTED]</mask>
                </valueMask>
            </decorator>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <includeMdcKeyName>teamId</includeMdcKeyName>
            <provider class="net.logstash.logback.composite.loggingevent.LoggingEventPatternJsonProvider">
                <pattern>{"module":"%module"}</pattern>
            </provider>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
