# ── Spring 프로파일 ─────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=local

# ── MySQL ──────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_USER=cowork
MYSQL_PASSWORD=

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=root
POSTGRES_PASSWORD=

# ── MongoDB ────────────────────────────────────────────────────────────────
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=

# ── cowork-github-app (별도 저장소, Eureka 미등록 — 고정 URL로 호출) ──────────
# 서비스 URL은 Config Server에서 관리한다. 로컬 기본값은 host.docker.internal:3000이다.
# cowork-github-app의 INTERNAL_API_KEY와 동일한 값을 입력해야 함
GITHUB_APP_INTERNAL_API_KEY=
# GitHub App의 slug (설치 URL 생성용, cowork-team). 앱 설정 페이지의 URL 마지막 경로.
GITHUB_APP_SLUG=
# 팀 GitHub 연동 state HMAC 서명 키. cowork-team, cowork-project에 동일한 값이 배포돼야 함.
TEAM_GITHUB_STATE_SECRET=

# ── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET=
# Phoenix 세션/쿠키 서명용. `mix phx.gen.secret`으로 생성
SECRET_KEY_BASE=

# ── DataGSM OAuth2 ───────────────
DATAGSM_CLIENT_ID=
# DataGSM webhook 서명 검증용 secret (이벤트 등록 시 발급되는 64자 hex). 미설정 시 webhook 비활성화.
DATAGSM_WEBHOOK_SECRET=

# ── SeaweedFS (S3 호환, production도 SeaweedFS 사용) ─────────────────────────
# 이 값들이 "클라이언트(앱)가 접근 가능한 주소"여야 함.
# - 로컬에서 앱(에뮬레이터/실기기)으로 테스트하면 Mac의 로컬 IP가 Wi-Fi 변경/재접속 등으로 바뀔 수 있음.
# - 그 경우 presigned URL도 예전 IP로 발급되어 업로드가 timeout/실패함.
# - 수동으로 IP를 매번 바꾸기 싫으면 아래처럼 `__LOCAL_IP__` 플레이스홀더를 써도 됨.
#   (로컬 실행 스크립트가 시작 시점에 `__LOCAL_IP__`를 현재 IP로 치환)
S3_ACCESS_KEY=seaweedfsadmin
S3_SECRET_KEY=seaweedfsadmin
S3_BUCKET=cowork-bucket
# 선택값. 비워두면 Compose는 seaweedfs:9000, 호스트 실행 스크립트는 localhost:9000을 사용
# 외부 오브젝트 스토리지를 사용한다면 아래 주석을 해제하고 내부 접근 주소를 지정
# S3_INTERNAL_ENDPOINT=
# 클라이언트(앱/외부)가 접근 가능한 주소 (외부 도메인/URL)
S3_PUBLIC_ENDPOINT=http://__LOCAL_IP__:9000
# 팀 아이콘 등 "공개 URL"로 내려줄 base URL (클라이언트 접근 주소)
S3_PUBLIC_BASE_URL=http://__LOCAL_IP__:9000/cowork-bucket

# ── 공개 주소 (prod 배포 시 필수) ────────────────────────────────────────────
# cowork-config가 prod native 설정의 placeholder를 해석할 때 사용하므로
# Config Server 컨테이너에 주입되어야 한다. local/dev는 configs의 값을 그대로 쓴다.
# 웹 클라이언트 origin (Gateway CORS, AccountShare OAuth redirect)
# PUBLIC_WEB_ORIGIN=https://cowork.gsm.hs.kr
# 외부에 노출되는 Gateway base URL (AccountShare OAuth callback)
# PUBLIC_API_BASE_URL=https://api.cowork.gsm.hs.kr
# GitHub App 연동 서비스 주소
# GITHUB_APP_SERVICE_URL=

# ── Grafana ─────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=admin

# ── 알림 ────────────────────────────────────────────────────────────────────
# 로컬은 비워도 되며 prod에서는 필수
DISCORD_WEBHOOK_URL=

# ── Vault (Config Server local/dev/prod에서 사용) ────────────────────────────────
VAULT_HOST=localhost
VAULT_PORT=8200
VAULT_SCHEME=http
VAULT_TOKEN=dev-root-token

# ── AccountShare (계정 공유 채널) ─────────────────────────────────────────────
# 256-bit AES 키: openssl rand -base64 32
ACCOUNT_CREDENTIAL_ENCRYPTION_KEY=
# OAuth state HMAC 서명 키
ACCOUNT_SHARE_OAUTH_STATE_SECRET=
# OAuth App Client ID / Secret (GitHub, Notion, Jira 등 사용할 provider만 입력)
GITHUB_ACCOUNT_SHARE_CLIENT_ID=
GITHUB_ACCOUNT_SHARE_CLIENT_SECRET=
NOTION_ACCOUNT_SHARE_CLIENT_ID=
NOTION_ACCOUNT_SHARE_CLIENT_SECRET=
JIRA_ACCOUNT_SHARE_CLIENT_ID=
JIRA_ACCOUNT_SHARE_CLIENT_SECRET=
GOOGLE_ACCOUNT_SHARE_CLIENT_ID=
GOOGLE_ACCOUNT_SHARE_CLIENT_SECRET=
FACEBOOK_ACCOUNT_SHARE_CLIENT_ID=
FACEBOOK_ACCOUNT_SHARE_CLIENT_SECRET=

# ── LiveKit ──────────────────────────────────────────────────────────────────
# 로컬 개발: devkey / devsecret 사용 가능
# 운영 환경: lk-cli create-api-key 등으로 생성한 키/시크릿 입력
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
# 로컬: livekit.yaml / 클라우드·운영: livekit-cloud.yaml
LIVEKIT_CONFIG_FILE=livekit.yaml
# 외부 클라이언트가 접속할 TLS WebSocket URL. prod 배포 시 필수
# LIVEKIT_WS_URL=wss://livekit.example.com
