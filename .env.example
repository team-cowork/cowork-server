# ── 앱 프로파일 ─────────────────────────────────────────────────────────
APP_CONFIG_PROFILE=local

# ── MySQL ──────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_USER=cowork
MYSQL_PASSWORD=

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=root
POSTGRES_PASSWORD=

# ── MongoDB ────────────────────────────────────────────────────────────────
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=

# ── cowork-github (`docker compose --profile github up`으로 선택 실행) ──────────
# cowork-project ↔ cowork-github 내부 HTTP API 공유 키
COWORK_GITHUB_INTERNAL_API_KEY=
# GitHub App ID, base64로 인코딩한 PEM 키, Webhook secret
COWORK_GITHUB_APP_ID=
COWORK_GITHUB_PRIVATE_KEY=
COWORK_GITHUB_WEBHOOK_SECRET=
# GitHub App의 slug (설치 URL 생성용, cowork-team). 앱 설정 페이지의 URL 마지막 경로.
COWORK_GITHUB_APP_SLUG=
# cowork-team의 GitHub App callback state HMAC 서명 키
TEAM_GITHUB_STATE_SECRET=

# ── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET=

# ── DataGSM OAuth2 ───────────────
DATAGSM_CLIENT_ID=
# DataGSM webhook 서명 검증용 secret (이벤트 등록 시 발급되는 64자 hex). 미설정 시 webhook 비활성화.
DATAGSM_WEBHOOK_SECRET=

# ── SeaweedFS (S3 호환, production도 SeaweedFS 사용) ─────────────────────────
# 이 값들이 "클라이언트(앱)가 접근 가능한 주소"여야 함.
# - 로컬에서 앱(에뮬레이터/실기기)으로 테스트하면 Mac의 로컬 IP가 Wi-Fi 변경/재접속 등으로 바뀔 수 있음.
# - 그 경우 presigned URL도 예전 IP로 발급되어 업로드가 timeout/실패함.
# - 수동으로 IP를 매번 바꾸기 싫으면 아래처럼 `__LOCAL_IP__` 플레이스홀더를 써도 됨.
#   (로컬 실행 스크립트가 시작 시점에 `__LOCAL_IP__`를 현재 IP로 치환)
# 아래 관리자 키는 스토리지 프로비저닝에만 사용. 서비스는 하단의 prefix 범위 키를 따로 받음.
S3_ACCESS_KEY=seaweedfsadmin
S3_SECRET_KEY=seaweedfsadmin
S3_BUCKET=cowork-bucket
S3_REGION=us-east-1
# S3 CORS의 웹 클라이언트 origin (여러 개는 쉼표로 구분)
PUBLIC_WEB_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
# 선택값. 비워두면 Compose는 seaweedfs:9000, 호스트 실행 스크립트는 localhost:9000을 사용
# 외부 오브젝트 스토리지를 사용한다면 아래 주석을 해제하고 내부 접근 주소를 지정
# S3_INTERNAL_ENDPOINT=
# 클라이언트(앱/외부)가 접근하는 기존 Gateway 주소
PUBLIC_API_BASE_URL=http://__LOCAL_IP__:8080

# ── Grafana ─────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=admin

# ── 알림 ────────────────────────────────────────────────────────────────────
# Chat 런타임 오류 알림 (Kafka·Outbox·검색 색인 등)
DISCORD_CHAT_ERROR_WEBHOOK_URL=
# Alertmanager 장애·복구 경보. 로컬에서는 비워도 됨
DISCORD_MONITORING_ALERT_WEBHOOK_URL=

# ── Vault 개발 도구 (앱 설정 주입에는 사용하지 않음) ─────────────────────────
VAULT_HOST=localhost
VAULT_PORT=8200
VAULT_SCHEME=http
VAULT_TOKEN=dev-root-token

# ── 수신 웹훅 ─────────────────────────────────────────────────────────────
# 웹훅 비밀키 응답 재조회 암호화. 256-bit AES 키: openssl rand -base64 32
# 기존 웹훅의 재시도 응답 복호화에 사용하므로 데이터를 유지하는 동안 키도 보존한다.
WEBHOOK_SECRET_ENCRYPTION_KEY=
# Gateway와 Preference가 공유하는 별도 URL 서명 키: openssl rand -base64 32
# 키를 바꾸면 발급된 URL의 서명이 무효화되므로 같은 값을 유지한다.
WEBHOOK_URL_SIGNING_KEY=

# ── AccountShare (계정 공유 채널) ─────────────────────────────────────────────
# 256-bit AES 키: openssl rand -base64 32
ACCOUNT_CREDENTIAL_ENCRYPTION_KEY=
# OAuth state HMAC 서명 키
ACCOUNT_SHARE_OAUTH_STATE_SECRET=
# OAuth App Client ID / Secret (GitHub, Notion, Jira 등 사용할 provider만 입력)
COWORK_GITHUB_ACCOUNT_SHARE_CLIENT_ID=
COWORK_GITHUB_ACCOUNT_SHARE_CLIENT_SECRET=
NOTION_ACCOUNT_SHARE_CLIENT_ID=
NOTION_ACCOUNT_SHARE_CLIENT_SECRET=
JIRA_ACCOUNT_SHARE_CLIENT_ID=
JIRA_ACCOUNT_SHARE_CLIENT_SECRET=
GOOGLE_ACCOUNT_SHARE_CLIENT_ID=
GOOGLE_ACCOUNT_SHARE_CLIENT_SECRET=
FACEBOOK_ACCOUNT_SHARE_CLIENT_ID=
FACEBOOK_ACCOUNT_SHARE_CLIENT_SECRET=

# ── LiveKit ──────────────────────────────────────────────────────────────────
# 로컬 개발: devkey / devsecret 사용 가능
# 운영 환경: lk-cli create-api-key 등으로 생성한 키/시크릿 입력
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
# 로컬 LiveKit 설정 파일
LIVEKIT_CONFIG_FILE=livekit.yaml
# 서버→LiveKit API 주소. 비워두면 Compose 네트워크의 cowork-livekit:7880을 사용
# LIVEKIT_URL=http://cowork-livekit:7880
# 클라이언트가 접속할 WebSocket URL. 실기기에서는 localhost 대신 호스트의 LAN IP,
# prod에서는 외부에서 접근 가능한 wss:// URL을 사용
LIVEKIT_WS_URL=ws://localhost:7880

# ── 로컬 오버라이드 (선택, 미설정 시 아래 기본값) ─────────────────────────────
# 호스트 포트가 이미 점유된 경우에만 바꾼다.
# MYSQL_HOST_PORT=3306
# KAFKA_EXTERNAL_HOST_PORT=9094
# KAFKA_UI_HOST_PORT=8091
# COWORK_PROJECT_HOST_PORT=8084
# 단일 노드 로컬 Kafka 기준값. 다중 브로커에서만 조정한다.
# KAFKA_TOPIC_PARTITIONS=1
# KAFKA_TOPIC_REPLICATION_FACTOR=1
# LiveKit이 컨테이너 외부 IP를 광고해야 할 때만 true
# LIVEKIT_USE_EXTERNAL_IP=false

# Firebase 서비스 계정 JSON. .env를 shell에서도 읽으므로 JSON 전체를 작은따옴표로 감싼다.
FCM_CREDENTIALS_JSON=
FCM_DATA_ONLY=false

# ── SeaweedFS 서비스별 키 (prefix 범위) ───────────────────────────────────────
S3_TEAM_ACCESS_KEY=local-team
S3_TEAM_SECRET_KEY=local-team-secret

S3_USER_ACCESS_KEY=local-user
S3_USER_SECRET_KEY=local-user-secret

S3_CHAT_ACCESS_KEY=local-chat
S3_CHAT_SECRET_KEY=local-chat-secret
