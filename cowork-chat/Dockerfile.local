FROM node:26.8.2-alpine3.24@sha256:ef24c5053d50fdc3e4e56eb4e7ddb7861874ab0fdc797046ba897581deb8e868 AS builder
WORKDIR /workspace/cowork-chat

COPY cowork-chat/package.json cowork-chat/package-lock.json ./
RUN --mount=type=cache,id=npm-chat-builder,target=/root/.npm \
    npm ci
COPY cowork-chat/tsconfig.json ./
COPY cowork-chat/src src
RUN npm run build

FROM builder AS verification
RUN apk --no-cache add bash python3
COPY cowork-chat/jest.config.js cowork-chat/xo.config.mjs ./
COPY deploy/images/ci /ci
RUN --mount=type=cache,id=npm-chat-builder,target=/root/.npm \
    npm run lint -- --max-warnings=0 \
    && bash /ci/run-native.sh jest cowork-chat /workspace /coverage \
    && python3 /ci/report.py collect --module cowork-chat --snapshot pr --format istanbul --metric line --input /coverage/report.json --output /coverage/coverage.json --exit-code 0

FROM scratch AS verify
COPY --from=verification /coverage /

FROM node:26.8.2-alpine3.24@sha256:ef24c5053d50fdc3e4e56eb4e7ddb7861874ab0fdc797046ba897581deb8e868 AS runtime
RUN addgroup -S -g 10001 app && adduser -S -u 10001 app -G app
WORKDIR /app
COPY cowork-chat/package.json cowork-chat/package-lock.json ./
RUN --mount=type=cache,id=npm-chat-runtime,target=/root/.npm \
    npm ci --omit=dev
COPY --chown=app:app --from=builder /workspace/cowork-chat/dist ./dist
COPY --chown=app:app cowork-chat/public ./public
ENV COWORK_CHAT_LOG_DIR=/var/log/cowork/chat
RUN mkdir -p /var/log/cowork/chat && chown -R app:app /var/log/cowork
USER app
EXPOSE 8087
ENV PORT=8087
ENV NODE_ENV=production
ENTRYPOINT ["node", "dist/main.js"]
