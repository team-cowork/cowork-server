# Config Server (선택: 설정 시 Config Server에서 설정 로드)
CONFIG_SERVER_URL=http://cowork-config:8761
APP_CONFIG_PROFILE=local

# Server
PORT=8086

# Database
DB_HOST=cowork-mysql
DB_PORT=3306
DB_NAME=cowork_notification
DB_USERNAME=cowork
DB_PASSWORD=

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_NOTIFICATION=notification.trigger
KAFKA_GROUP_ID=cowork-notification
KAFKA_PROJECTION_GROUP_ID=cowork-notification-projections
KAFKA_TOPIC_CHANNEL_NOTIFICATION_PREFERENCE=preference.channel-notification.changed
KAFKA_TOPIC_USER_PROFILE=user.profile.event
KAFKA_TOPIC_TEAM_LIFECYCLE=team.lifecycle

# Firebase: Vault secret/cowork-notification/<APP_CONFIG_PROFILE>의 fcm.credentials-json 사용

# Eureka
EUREKA_SERVER_URL=http://cowork-config:8761/eureka
EUREKA_APP_NAME=cowork-notification
APP_ADVERTISE_ADDRESS=cowork-notification
APP_ADVERTISE_PORT=8086
