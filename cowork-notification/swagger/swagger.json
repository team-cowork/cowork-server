{
    "swagger": "2.0",
    "info": {
        "description": "Firebase 설치(FID) 관리 및 푸시 알림 서비스",
        "title": "cowork Notification API",
        "contact": {},
        "version": "20261030.0"
    },
    "basePath": "/api/notification",
    "paths": {
        "/notifications/installations": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Firebase installation ID(FID)를 현재 계정에 등록합니다. 다른 계정이 소유한 FID면 현재 계정으로 원자적으로 이전합니다",
                "consumes": [
                    "application/json"
                ],
                "tags": [
                    "installations"
                ],
                "summary": "Firebase 설치 등록",
                "parameters": [
                    {
                        "type": "integer",
                        "format": "int64",
                        "description": "사용자 ID (Gateway 주입)",
                        "name": "X-User-Id",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "설치 등록 요청",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_domain_installation.registerInstallationRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created"
                    },
                    "400": {
                        "description": "잘못된 요청",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "인증 실패",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "내부 서버 오류",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/notifications/installations/{fid}": {
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "로그아웃, 계정 전환 또는 FID 변경 시 현재 계정과 FID의 연결을 해제합니다",
                "tags": [
                    "installations"
                ],
                "summary": "Firebase 설치 해제",
                "parameters": [
                    {
                        "type": "integer",
                        "format": "int64",
                        "description": "사용자 ID (Gateway 주입)",
                        "name": "X-User-Id",
                        "in": "header",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Firebase installation ID",
                        "name": "fid",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "400": {
                        "description": "잘못된 요청",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "인증 실패",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "설치 없음",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "내부 서버 오류",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/notifications/stream": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "인증된 사용자의 실시간 알림 이벤트를 Server-Sent Events(SSE)로 스트리밍합니다. 30초마다 keepalive ping을 전송합니다. 같은 알림이 다시 전달될 수 있으므로(at-least-once) 클라이언트는 eventId로 중복을 제거합니다.",
                "produces": [
                    "text/event-stream"
                ],
                "tags": [
                    "notifications"
                ],
                "summary": "SSE 알림 스트림 구독",
                "parameters": [
                    {
                        "type": "integer",
                        "format": "int64",
                        "description": "사용자 ID (Gateway 주입)",
                        "name": "X-User-Id",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "data: {eventId, type, title, body, channelId, teamId}",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "인증 실패",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "SSE not supported",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "internal_domain_installation.registerInstallationRequest": {
            "type": "object",
            "properties": {
                "fid": {
                    "type": "string",
                    "example": "cXk9Y2Rl-ZWZnaGlqa2xt_"
                },
                "platform": {
                    "type": "string",
                    "enum": [
                        "IOS",
                        "ANDROID",
                        "WEB"
                    ]
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "\"Bearer {access_token}\" 형식으로 Gateway에 전달하세요.",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}