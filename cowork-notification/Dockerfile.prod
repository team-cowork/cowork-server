FROM golang:1.27.1-alpine3.24@sha256:cf6fca6641884b8433441b2b0652976f975e1d0fdd26d177eaaf8596087f3125 AS builder
WORKDIR /workspace/cowork-notification

COPY cowork-notification/go.mod cowork-notification/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download
COPY cowork-notification/ ./
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/cowork-notification ./cmd/server


FROM builder AS verification
RUN apk --no-cache add bash python3 git build-base
COPY deploy/images/ci /ci
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.13.2 \
    && golangci-lint run \
    && go vet ./... \
    && bash /ci/run-native.sh go cowork-notification /workspace /coverage \
        ./internal/domain/installation \
    && python3 /ci/report.py collect --module cowork-notification --snapshot pr --format go --metric statement --input /coverage/report.out --output /coverage/coverage.json --exit-code 0

FROM scratch AS verify
COPY --from=verification /coverage /

FROM alpine:3.24.1@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b AS runtime
RUN apk --no-cache add ca-certificates tzdata \
    && addgroup -S -g 10001 app \
    && adduser -S -u 10001 app -G app
WORKDIR /app
COPY --chown=app:app --from=builder /out/cowork-notification /usr/local/bin/cowork-notification
COPY --chown=app:app cowork-notification/src/main/resources/db/migration ./db/migration
RUN test -n "$(find /app/db/migration -name 'V*__*.sql' -print -quit)"
USER app
EXPOSE 8086
ENV PORT=8086
ENTRYPOINT ["cowork-notification"]
