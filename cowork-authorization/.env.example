# Server
PORT=8081

# Database
DB_DSN=user:password@tcp(cowork-mysql:3306)/cowork_authorization?charset=utf8mb4&parseTime=true&loc=UTC&time_zone=%27%2B00%3A00%27

# DataGSM OAuth2
DATAGSM_CLIENT_ID=your_client_id
DATAGSM_TOKEN_URL=https://oauth.authorization.datagsm.kr/v1/oauth/token
DATAGSM_USERINFO_URL=https://oauth.resource.datagsm.kr/userinfo
# DataGSM webhook 서명 검증용 secret (이벤트 등록 시 발급되는 64자 hex). 미설정 시 /events/datagsm 비활성화.
DATAGSM_WEBHOOK_SECRET=

# Kafka owner command, result, webhook sync, and presence topics
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_USER_SYNC=user.data.sync
KAFKA_TOPIC_USER_IDENTITY_COMMAND=user.identity.command
KAFKA_TOPIC_USER_IDENTITY_COMMAND_RESULT=user.identity.command-result
KAFKA_TOPIC_USER_IDENTITY_COMMAND_RESULT_DLT=user.identity.command-result-dlt
KAFKA_GROUP_ID_USER_IDENTITY_COMMAND_RESULT=cowork-authorization.user-identity-command-result
KAFKA_IDENTITY_COMMAND_TIMEOUT=5s
KAFKA_TOPIC_USER_PRESENCE=user.presence.event

# JWT (HS256, cowork-gateway와 동일한 값 사용)
JWT_SECRET=your_jwt_secret_shared_with_gateway
JWT_ACCESS_EXPIRE=30m
JWT_REFRESH_EXPIRE=2160h

# Eureka
EUREKA_SERVER_URL=http://cowork-config:8761/eureka
EUREKA_APP_NAME=cowork-authorization
EUREKA_INSTANCE_HOST=cowork-authorization
EUREKA_INSTANCE_PORT=8081
