{
  "title": "cowork / Authorization",
  "uid": "cowork-authorization",
  "tags": ["cowork", "service", "authorization"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "메트릭 수집 상태",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "min(up{job=~\"cowork-.*\",service=\"authorization\"})",
          "legendFormat": "authorization",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": { "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "auto", "orientation": "auto" },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "noValue": "N/A",
          "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}] }
        }
      },
      "description": "애플리케이션 메트릭 수집 결과입니다. 서비스가 요청을 처리할 준비가 됐는지는 준비 상태 카드에서 확인합니다. 인스턴스 하나라도 수집에 실패하면 DOWN입니다."
    },
    {
      "id": 100,
      "title": "서비스 준비 상태",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "min(probe_success{job=\"blackbox\",service=\"authorization\"})",
          "legendFormat": "authorization",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "noValue": "N/A",
          "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}] }
        }
      },
      "description": "준비 상태 점검 결과입니다. 점검 대상이 없거나 결과가 누락되면 N/A입니다.",
      "options": { "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "auto", "orientation": "auto" }
    },
    {
      "id": 101,
      "title": "현재 초당 요청 수",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(cowork_authorization_http_requests_total{service=\"authorization\",job=~\"cowork-.*\"}[$__rate_interval]))",
          "legendFormat": "요청",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": { "defaults": {"unit": "reqps", "min": 0, "noValue": "N/A", "color": {"mode": "fixed", "fixedColor": "blue"}} },
      "options": { "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "colorMode": "value", "graphMode": "none", "textMode": "auto" }
    },
    {
      "id": 102,
      "title": "현재 HTTP 5xx 오류 비율",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "((sum(rate(cowork_authorization_http_requests_total{service=\"authorization\",job=~\"cowork-.*\",status=~\"5..\"}[$__rate_interval]))) or (0 * (sum(rate(cowork_authorization_http_requests_total{service=\"authorization\",job=~\"cowork-.*\"}[$__rate_interval]))))) / ((sum(rate(cowork_authorization_http_requests_total{service=\"authorization\",job=~\"cowork-.*\"}[$__rate_interval]))) > 0) * 100",
          "legendFormat": "5xx",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": { "defaults": {"unit": "percent", "min": 0, "noValue": "N/A", "max": 100, "decimals": 1, "color": {"mode": "fixed", "fixedColor": "blue"}} },
      "description": "요청이 발생한 구간의 5xx 비율입니다. 요청이 없거나 메트릭이 없으면 N/A로 표시합니다.",
      "options": { "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "colorMode": "value", "graphMode": "none", "textMode": "auto" }
    },
    {
      "id": 2,
      "title": "초당 API 요청 수 (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum by (route)(rate(cowork_authorization_http_requests_total{service=\"authorization\",job=~\"cowork-.*\"}[$__rate_interval]))",
          "legendFormat": "{{route}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "min": 0,
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        }
      },
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 3,
      "title": "초당 API 4xx/5xx 응답 수 (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "sum by (route, status)(rate(cowork_authorization_http_requests_total{service=\"authorization\",job=~\"cowork-.*\",status=~\"4..|5..\"}[$__rate_interval]))",
          "legendFormat": "{{route}} {{status}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "min": 0,
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        }
      },
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 4,
      "title": "API 응답 시간 P95 / P99 (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, route) (rate(cowork_authorization_http_request_duration_seconds_bucket{service=\"authorization\",job=~\"cowork-.*\"}[$__rate_interval]))) * 1000",
          "legendFormat": "P99 {{route}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(cowork_authorization_http_request_duration_seconds_bucket{service=\"authorization\",job=~\"cowork-.*\"}[$__rate_interval]))) * 1000",
          "legendFormat": "P95 {{route}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "noValue": "N/A", "min": 0, "color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never"} }
      },
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 5,
      "title": "진행 중 요청 수",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "sum by (method) (cowork_authorization_http_requests_in_flight{service=\"authorization\",job=~\"cowork-.*\"})",
          "legendFormat": "{{method}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "min": 0,
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        }
      },
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 6,
      "title": "Go 힙 메모리 사용량",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "go_memstats_heap_inuse_bytes{service=\"authorization\"}",
          "legendFormat": "사용 중인 힙 영역",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "expr": "go_memstats_heap_alloc_bytes{service=\"authorization\"}",
          "legendFormat": "객체에 할당된 힙 메모리",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "N/A",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        }
      },
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 7,
      "title": "Go 고루틴 수",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 20 },
      "targets": [
        {
          "expr": "go_goroutines{service=\"authorization\"}",
          "legendFormat": "고루틴 수",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "min": 0,
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        }
      },
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 103,
      "title": "분당 GC 횟수",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 20 },
      "targets": [
        {
          "expr": "rate(go_gc_duration_seconds_count{service=\"authorization\"}[$__rate_interval]) * 60",
          "legendFormat": "분당 GC 횟수",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:회/min",
          "min": 0,
          "noValue": "N/A",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        }
      },
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 8,
      "title": "웹훅 발행 대기 건수",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "targets": [
        {
          "expr": "max(cowork_authorization_webhook_outbox_pending{service=\"authorization\"} and on (instance) (cowork_authorization_webhook_observation_success{service=\"authorization\"} == 1))",
          "legendFormat": "발행 대기",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "N/A",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        }
      },
      "description": "최근 DB 관측에 성공한 인스턴스의 공유 대기열 최댓값입니다.",
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 9,
      "title": "가장 오래된 웹훅 대기 시간",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [
        {
          "expr": "max(cowork_authorization_webhook_outbox_oldest_seconds{service=\"authorization\"} and on (instance) (cowork_authorization_webhook_observation_success{service=\"authorization\"} == 1))",
          "legendFormat": "최장 대기",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0, "noValue": "N/A", "color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never"} }
      },
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "label": "데이터 소스"
      }
    ]
  }
}
