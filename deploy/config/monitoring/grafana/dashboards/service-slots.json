{
  "uid": "cowork-service-slots",
  "title": "cowork Service Slots",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "cowork",
    "slots"
  ],
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "cowork-prometheus"
        },
        "query": "label_values(probe_success{job=\"blackbox\"}, service)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Readiness",
      "datasource": {
        "type": "prometheus",
        "uid": "cowork-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "probe_success{job=\"blackbox\",service=~\"$service\"}",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Metrics collection",
      "datasource": {
        "type": "prometheus",
        "uid": "cowork-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "up{job=\"cowork-services\",service=~\"$service\"}",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Readiness response time",
      "datasource": {
        "type": "prometheus",
        "uid": "cowork-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "probe_duration_seconds{job=\"blackbox\",service=~\"$service\"}",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Active alerts",
      "datasource": {
        "type": "prometheus",
        "uid": "cowork-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "ALERTS{alertstate=\"firing\",service=~\"$service\"}",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Public Gateway HTTPS API",
      "description": "Public /api/health reachability and JSON response identity. Downstream readiness is shown separately.",
      "datasource": {
        "type": "prometheus",
        "uid": "cowork-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "probe_success{job=\"public-gateway\"}",
          "refId": "A",
          "legendFormat": "Public JSON API"
        },
        {
          "expr": "up{job=\"public-gateway\"}",
          "refId": "B",
          "legendFormat": "Probe collection"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    }
  ]
}
