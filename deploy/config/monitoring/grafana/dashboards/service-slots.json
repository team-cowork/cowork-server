{
  "uid": "cowork-service-slots",
  "title": "cowork 서비스 운영 현황",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "cowork",
    "slots"
  ],
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "서비스",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "cowork-prometheus"
        },
        "query": "label_values(probe_success{job=\"blackbox\"}, service)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "서비스 준비 상태",
      "datasource": {
        "type": "prometheus",
        "uid": "cowork-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "probe_success{job=\"blackbox\",service=~\"$service\"}",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "메트릭 수집 상태",
      "datasource": {
        "type": "prometheus",
        "uid": "cowork-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "up{job=\"cowork-services\",service=~\"$service\"}",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "서비스 준비 상태 확인 응답 시간",
      "datasource": {
        "type": "prometheus",
        "uid": "cowork-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "probe_duration_seconds{job=\"blackbox\",service=~\"$service\"}",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "조치가 필요한 알림",
      "datasource": {
        "type": "prometheus",
        "uid": "cowork-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "ALERTS{alertstate=\"firing\",service=~\"$service\"}",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "외부 공개 게이트웨이 HTTPS API",
      "description": "외부에서 /api/health에 접속할 수 있는지와 JSON 응답이 올바른지 확인합니다. 내부 서비스의 준비 상태는 별도로 표시합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "cowork-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "probe_success{job=\"public-gateway\"}",
          "refId": "A",
          "legendFormat": "외부 공개 JSON API"
        },
        {
          "expr": "up{job=\"public-gateway\"}",
          "refId": "B",
          "legendFormat": "상태 점검 결과 수집"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    }
  ]
}
