{
  "title": "cowork / Channel",
  "uid": "cowork-channel",
  "tags": ["cowork", "service", "channel"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "서비스 상태",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "up{service=\"channel\"}",
          "legendFormat": "channel",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "value": 0, "color": "red" }, { "value": 1, "color": "green" }] }
        }
      }
    },
    {
      "id": 2,
      "title": "초당 HTTP 요청 수 (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{application=\"cowork-channel\"}[1m]))",
          "legendFormat": "{{uri}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP 응답 시간 P99 (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, uri) (rate(http_server_requests_seconds_bucket{application=\"cowork-channel\"}[5m]))) * 1000",
          "legendFormat": "P99 {{uri}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{application=\"cowork-channel\"}[5m]))) * 1000",
          "legendFormat": "P95 {{uri}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 4,
      "title": "HTTP 5xx 오류 비율 (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"cowork-channel\", status=~\"5..\"}[1m])) / sum(rate(http_server_requests_seconds_count{application=\"cowork-channel\"}[1m])) * 100",
          "legendFormat": "5xx 오류 비율",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "id": 5,
      "title": "JVM 힙 메모리",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{application=\"cowork-channel\", area=\"heap\"}",
          "legendFormat": "사용량 {{id}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        },
        {
          "expr": "jvm_memory_max_bytes{application=\"cowork-channel\", area=\"heap\"}",
          "legendFormat": "최대 용량 {{id}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 6,
      "title": "JVM GC 일시정지 시간 (ms/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum{application=\"cowork-channel\"}[1m]) * 1000",
          "legendFormat": "{{action}} {{cause}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 7,
      "title": "JVM 스레드",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "expr": "jvm_threads_live_threads{application=\"cowork-channel\"}",
          "legendFormat": "전체 스레드",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        },
        {
          "expr": "jvm_threads_daemon_threads{application=\"cowork-channel\"}",
          "legendFormat": "데몬 스레드",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 8,
      "title": "DB 커넥션 풀 사용량",
      "type": "timeseries",
      "description": "사용 중인 커넥션 수가 최대치에 가까워지면 커넥션 풀이 고갈될 수 있습니다.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "targets": [
        {
          "expr": "hikaricp_connections_active{service=\"channel\"}",
          "legendFormat": "사용 중",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        },
        {
          "expr": "hikaricp_connections_idle{service=\"channel\"}",
          "legendFormat": "유휴",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        },
        {
          "expr": "hikaricp_connections_max{service=\"channel\"}",
          "legendFormat": "최대 커넥션 수",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 9,
      "title": "DB 커넥션 대기 스레드 수",
      "type": "timeseries",
      "description": "0보다 크면 커넥션을 기다리는 요청 스레드가 있다는 뜻입니다. 커넥션 풀 고갈의 초기 징후입니다.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [
        {
          "expr": "hikaricp_connections_pending{service=\"channel\"}",
          "legendFormat": "대기 중",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 10,
      "title": "DB 커넥션 획득 시간 P99 (ms)",
      "type": "timeseries",
      "description": "커넥션 풀이 고갈되기 시작하면 커넥션을 얻는 데 걸리는 시간이 늘어납니다.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(hikaricp_connections_acquire_seconds_bucket{service=\"channel\"}[5m]))) * 1000",
          "legendFormat": "P99",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 11,
      "title": "OAuth 외부 호출 응답 시간 P99 (ms)",
      "type": "timeseries",
      "description": "트랜잭션 밖에서 실행하는 외부 OAuth 제공자 호출의 응답 시간입니다.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, provider, stage) (rate(channel_oauth_external_call_seconds_bucket{service=\"channel\"}[5m]))) * 1000",
          "legendFormat": "{{provider}}/{{stage}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "label": "데이터 소스"
      }
    ]
  }
}

