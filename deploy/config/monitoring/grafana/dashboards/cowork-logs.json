{
  "__inputs": [],
  "__requires": [
    { "type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    { "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "id": 10, "title": "전체 현황", "type": "row" },
    {
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never"}, "unit": "ops", "noValue": "N/A", "min": 0 }
      },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 1 },
      "id": 1,
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "sum by (service) (rate({env=\"$env\", service=~\"$service\"} | label_format level=\"{{ .level | upper }}\" | level=\"ERROR\" [$__auto]))",
          "legendFormat": "{{service}}",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "title": "서비스별 초당 오류 로그 수",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": {"mode": "palette-classic"}, "unit": "short", "decimals": 0, "noValue": "N/A", "min": 0 },
        "overrides": [
          { "matcher": {"id": "byName", "options": "ERROR"}, "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}] },
          { "matcher": {"id": "byName", "options": "WARN"}, "properties": [{"id": "color", "value": {"fixedColor": "orange", "mode": "fixed"}}] },
          { "matcher": {"id": "byName", "options": "INFO"}, "properties": [{"id": "color", "value": {"fixedColor": "green", "mode": "fixed"}}] }
        ]
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 2,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": false,
        "valueMode": "color"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "sum by (level) (count_over_time({env=\"$env\", service=~\"$service\"} | label_format level=\"{{ .level | upper }}\" [$__auto]))",
          "legendFormat": "{{level}}",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "title": "선택 기간의 로그 수준별 건수",
      "type": "bargauge",
      "description": "선택한 전체 시간 범위를 한 번 집계하며 로그 수준은 대소문자를 구분하지 않습니다. 로그 수준 필터는 아래 원문 로그에 적용됩니다."
    },
    { "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9}, "id": 11, "title": "실시간 로그", "type": "row" },
    {
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 15, "w": 24, "x": 0, "y": 10 },
      "id": 3,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [{"datasource": {"type": "loki", "uid": "${datasource}"}, "expr": "{env=\"$env\", service=~\"$service\"} | label_format level=\"{{ .level | upper }}\" | level=~\"$level\"", "legendFormat": "", "refId": "A"}],
      "title": "실시간 로그",
      "type": "logs"
    },
    { "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 25}, "id": 12, "title": "Vault 감사 로그", "type": "row" },
    {
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "description": "로그인 실패는 로그인 응답에 token이 없거나 token 조회가 거부된 경우입니다. 기타 오류 응답은 그 밖의 권한 거부와 요청 오류입니다. 서비스 필터와 관계없이 Vault 로그만 집계합니다.",
      "fieldConfig": {
        "defaults": { "color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never", "drawStyle": "bars"}, "unit": "short", "decimals": 0, "noValue": "0", "min": 0 },
        "overrides": [
          { "matcher": {"id": "byName", "options": "로그인 실패"}, "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}] },
          { "matcher": {"id": "byName", "options": "기타 오류 응답"}, "properties": [{"id": "color", "value": {"fixedColor": "orange", "mode": "fixed"}}] }
        ]
      },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 26 },
      "id": 4,
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["sum", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "sum(count_over_time({env=\"$env\", service=\"vault\"} |= `\"type\":\"response\"` | json path=\"request.path\", token=\"response.auth.client_token\", error=\"error\" | (path=~\"auth/[^/]+/login(/.*)?\" and token=\"\") or (path=\"auth/token/lookup-self\" and error!=\"\") [$__auto]))",
          "legendFormat": "로그인 실패",
          "refId": "A",
          "queryType": "range"
        },
        {
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "sum(count_over_time({env=\"$env\", service=\"vault\"} |= `\"type\":\"response\"` | json path=\"request.path\", error=\"error\" | error!=\"\" and path!~\"auth/[^/]+/login(/.*)?\" and path!=\"auth/token/lookup-self\" [$__auto]))",
          "legendFormat": "기타 오류 응답",
          "refId": "B",
          "queryType": "range"
        }
      ],
      "title": "Vault 로그인 실패와 오류 응답 건수",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "description": "선택한 전체 시간 범위에서 요청이 많은 Vault API 경로 10개입니다.",
      "fieldConfig": {
        "defaults": { "color": {"mode": "continuous-BlYlRd"}, "unit": "short", "decimals": 0, "noValue": "N/A", "min": 0 }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 26 },
      "id": 5,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": false,
        "valueMode": "color"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "expr": "topk(10, sum by (path) (count_over_time({env=\"$env\", service=\"vault\"} |= `\"type\":\"request\"` | json path=\"request.path\" [$__auto])))",
          "legendFormat": "{{path}}",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "title": "선택 기간의 Vault 요청 경로별 건수",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "description": "요청마다 응답 기록 한 줄을 표시합니다. 공개 도메인을 거친 요청의 출발지는 모두 프록시(10.0.0.117)로 표시되며, 실제 클라이언트 IP는 GSM SV 입구 라우터가 출발지를 바꾸면서 남지 않습니다. token과 요청 값은 HMAC 처리되어 원문이 남지 않습니다.",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 34 },
      "id": 6,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [{"datasource": {"type": "loki", "uid": "${datasource}"}, "expr": "{env=\"$env\", service=\"vault\"} |= `\"type\":\"response\"` | json operation=\"request.operation\", path=\"request.path\", remote=\"request.remote_address\", actor=\"auth.display_name\", error=\"error\", data_error=\"response.data.error\" | line_format `{{ .operation }} {{ .path }} / 출발지 {{ .remote }}{{ if .actor }} / 주체 {{ .actor }}{{ end }}{{ if .error }} / 오류 {{ .error | replace \"\\n\" \" \" | replace \"\\t\" \"\" }}{{ else if .data_error }} / 오류 응답{{ end }}`", "legendFormat": "", "refId": "A"}],
      "title": "Vault 감사 로그",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["logs", "loki", "cowork"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "name": "datasource",
        "options": [],
        "query": "loki",
        "refresh": 1,
        "type": "datasource",
        "label": "데이터 소스"
      },
      {
        "current": { "selected": false, "text": "prod", "value": "prod" },
        "datasource": { "type": "loki", "uid": "${datasource}" },
        "definition": "label_values(env)",
        "hide": 0,
        "includeAll": false,
        "name": "env",
        "query": { "label": "env", "stream": "{env=~\".+\"}", "type": 1 },
        "refresh": 2,
        "sort": 1,
        "type": "query",
        "label": "환경"
      },
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "loki", "uid": "${datasource}" },
        "definition": "label_values(service)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "name": "service",
        "query": { "label": "service", "stream": "{env=\"$env\"}", "type": 1 },
        "refresh": 2,
        "sort": 1,
        "type": "query",
        "label": "서비스"
      },
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "name": "level",
        "options": [
          { "selected": false, "text": "INFO",  "value": "INFO" },
          { "selected": false, "text": "WARN",  "value": "WARN" },
          { "selected": false, "text": "ERROR", "value": "ERROR" },
          { "selected": false, "text": "DEBUG", "value": "DEBUG" }
        ],
        "query": "INFO,WARN,ERROR,DEBUG",
        "type": "custom",
        "label": "로그 수준"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "cowork / Logs",
  "uid": "cowork-logs",
  "version": 1
}
