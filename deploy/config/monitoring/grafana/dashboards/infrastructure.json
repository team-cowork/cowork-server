{
  "title": "cowork / Infrastructure",
  "uid": "cowork-infrastructure",
  "tags": ["cowork", "infrastructure"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "MySQL - 초당 쿼리 수 (QPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(mysql_global_status_queries{service=\"mysql\"}[1m])",
          "legendFormat": "{{module}} QPS",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 2,
      "title": "MySQL - 연결 수와 실행 중인 스레드 수",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "mysql_global_status_threads_connected{service=\"mysql\"}",
          "legendFormat": "{{module}} 연결 수",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        },
        {
          "expr": "mysql_global_status_threads_running{service=\"mysql\"}",
          "legendFormat": "{{module}} 실행 중인 스레드 수",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 3,
      "title": "Redis - 캐시 적중률 (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rate(redis_keyspace_hits_total{service=\"redis\"}[1m]) / (rate(redis_keyspace_hits_total{service=\"redis\"}[1m]) + rate(redis_keyspace_misses_total{service=\"redis\"}[1m])) * 100",
          "legendFormat": "캐시 적중률",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "id": 4,
      "title": "Redis - 메모리 사용량",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "redis_memory_used_bytes{service=\"redis\"}",
          "legendFormat": "사용량",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        },
        {
          "expr": "redis_memory_max_bytes{service=\"redis\"}",
          "legendFormat": "최대 용량",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 5,
      "title": "Kafka - 소비 대기 메시지 수",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum by (consumergroup, topic) (kafka_consumergroup_lag{service=\"kafka\"})",
          "legendFormat": "{{consumergroup}} / {{topic}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 6,
      "title": "Kafka - 초당 메시지 수",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum by (topic) (rate(kafka_topic_partition_current_offset{service=\"kafka\"}[1m]))",
          "legendFormat": "{{topic}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 7,
      "title": "PostgreSQL - 활성 커넥션",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "pg_stat_activity_count{service=\"postgres\", state=\"active\"}",
          "legendFormat": "{{module}} / {{datname}} 활성 연결",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        },
        {
          "expr": "pg_stat_activity_count{service=\"postgres\", state=\"idle\"}",
          "legendFormat": "{{module}} / {{datname}} 유휴 연결",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 8,
      "title": "PostgreSQL - 초당 트랜잭션",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit{service=\"postgres\", datname=\"cowork_preference\"}[1m])",
          "legendFormat": "{{module}} 초당 커밋 수",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        },
        {
          "expr": "rate(pg_stat_database_xact_rollback{service=\"postgres\", datname=\"cowork_preference\"}[1m])",
          "legendFormat": "{{module}} 초당 롤백 수",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 9,
      "title": "모듈 DB - 메트릭 수집 상태",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "targets": [
        {
          "expr": "up{job=\"infrastructure\", module!=\"\"}",
          "legendFormat": "{{module}} / {{service}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "fieldConfig": { "defaults": { "min": 0, "max": 1 } }
    },
    {
      "id": 10,
      "title": "모듈 DB - 연결 상태",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [
        {
          "expr": "mysql_up{job=\"infrastructure\", module!=\"\"} or pg_up{job=\"infrastructure\", module!=\"\"} or mongodb_up{job=\"infrastructure\", module!=\"\"}",
          "legendFormat": "{{module}} / {{service}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "fieldConfig": { "defaults": { "min": 0, "max": 1 } }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "label": "데이터 소스"
      }
    ]
  }
}
