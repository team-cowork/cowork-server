{
  "title": "cowork / Config Server",
  "uid": "cowork-config",
  "tags": ["cowork", "service", "config"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "메트릭 수집 상태",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "min(up{job=~\"cowork-.*\",service=\"config\"})",
          "legendFormat": "config",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": { "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "auto", "orientation": "auto" },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "noValue": "N/A",
          "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}] }
        }
      },
      "description": "Config Server의 인증된 메트릭 수집 결과입니다. 수집 실패 시 DOWN으로 표시합니다."
    },
    {
      "id": 100,
      "title": "메트릭 수집 소요 시간",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "max(scrape_duration_seconds{job=\"cowork-external-services\",service=\"config\"})",
          "legendFormat": "수집 시간",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": { "defaults": {"unit": "s", "min": 0, "noValue": "N/A", "color": {"mode": "fixed", "fixedColor": "blue"}} },
      "description": "Config Server는 별도 readiness probe 없이 인증된 메트릭 엔드포인트를 수집합니다.",
      "options": { "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "colorMode": "value", "graphMode": "none", "textMode": "auto" }
    },
    {
      "id": 101,
      "title": "현재 초당 요청 수",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{service=\"config\",job=~\"cowork-.*\",uri!~\"/actuator.*|/metrics|/health|/api/health\"}[$__rate_interval]))",
          "legendFormat": "요청",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": { "defaults": {"unit": "reqps", "min": 0, "noValue": "N/A", "color": {"mode": "fixed", "fixedColor": "blue"}} },
      "options": { "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "colorMode": "value", "graphMode": "none", "textMode": "auto" }
    },
    {
      "id": 102,
      "title": "현재 HTTP 5xx 오류 비율",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "((sum(rate(http_server_requests_seconds_count{service=\"config\",job=~\"cowork-.*\",uri!~\"/actuator.*|/metrics|/health|/api/health\",status=~\"5..\"}[$__rate_interval]))) or (0 * (sum(rate(http_server_requests_seconds_count{service=\"config\",job=~\"cowork-.*\",uri!~\"/actuator.*|/metrics|/health|/api/health\"}[$__rate_interval]))))) / ((sum(rate(http_server_requests_seconds_count{service=\"config\",job=~\"cowork-.*\",uri!~\"/actuator.*|/metrics|/health|/api/health\"}[$__rate_interval]))) > 0) * 100",
          "legendFormat": "5xx",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": { "defaults": {"unit": "percent", "min": 0, "noValue": "N/A", "max": 100, "decimals": 1, "color": {"mode": "fixed", "fixedColor": "blue"}} },
      "description": "요청이 발생한 구간의 5xx 비율입니다. 요청이 없거나 메트릭이 없으면 N/A로 표시합니다.",
      "options": { "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "colorMode": "value", "graphMode": "none", "textMode": "auto" }
    },
    {
      "id": 2,
      "title": "초당 HTTP 요청 수 (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum by (uri)(rate(http_server_requests_seconds_count{service=\"config\",job=~\"cowork-.*\",uri!~\"/actuator.*|/metrics|/health|/api/health\"}[$__rate_interval]))",
          "legendFormat": "{{uri}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "min": 0,
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        }
      },
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 3,
      "title": "HTTP 응답 시간 평균 / P95 / P99 (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, uri) (rate(http_server_requests_seconds_bucket{service=\"config\",job=~\"cowork-.*\",uri!~\"/actuator.*|/metrics|/health|/api/health\"}[$__rate_interval]))) * 1000",
          "legendFormat": "P99 {{uri}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{service=\"config\",job=~\"cowork-.*\",uri!~\"/actuator.*|/metrics|/health|/api/health\"}[$__rate_interval]))) * 1000",
          "legendFormat": "P95 {{uri}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "B",
          "instant": false,
          "range": true
        },
        {
          "expr": "sum by (uri)(rate(http_server_requests_seconds_sum{service=\"config\",job=~\"cowork-.*\",uri!~\"/actuator.*|/metrics|/health|/api/health\"}[$__rate_interval])) / (sum by (uri)(rate(http_server_requests_seconds_count{service=\"config\",job=~\"cowork-.*\",uri!~\"/actuator.*|/metrics|/health|/api/health\"}[$__rate_interval])) > 0) * 1000",
          "legendFormat": "평균 {{uri}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "C",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "noValue": "N/A", "min": 0, "color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never"} }
      },
      "description": "평균은 응답 시간 합계 증가량을 요청 수 증가량으로 나누어 계산합니다. P95/P99는 해당 서비스가 히스토그램 버킷을 제공할 때 표시됩니다.",
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 4,
      "title": "HTTP 5xx 오류 비율 (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "((sum(rate(http_server_requests_seconds_count{service=\"config\",job=~\"cowork-.*\",uri!~\"/actuator.*|/metrics|/health|/api/health\",status=~\"5..\"}[$__rate_interval]))) or (0 * (sum(rate(http_server_requests_seconds_count{service=\"config\",job=~\"cowork-.*\",uri!~\"/actuator.*|/metrics|/health|/api/health\"}[$__rate_interval]))))) / ((sum(rate(http_server_requests_seconds_count{service=\"config\",job=~\"cowork-.*\",uri!~\"/actuator.*|/metrics|/health|/api/health\"}[$__rate_interval]))) > 0) * 100",
          "legendFormat": "5xx 오류 비율",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "N/A",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" },
          "max": 100
        }
      },
      "description": "요청이 발생한 구간의 5xx 비율입니다. 요청이 없거나 메트릭이 없으면 N/A로 표시합니다.",
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 5,
      "title": "JVM 힙 메모리",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{application=\"cowork-config\", area=\"heap\"}",
          "legendFormat": "사용량 {{id}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "expr": "jvm_memory_max_bytes{application=\"cowork-config\", area=\"heap\"}",
          "legendFormat": "최대 용량 {{id}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "N/A",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        }
      },
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 6,
      "title": "JVM GC 일시정지 시간 (ms/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum{application=\"cowork-config\"}[$__rate_interval]) * 1000",
          "legendFormat": "{{action}} {{cause}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:ms/s",
          "noValue": "N/A",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        }
      },
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 7,
      "title": "JVM 스레드",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "expr": "jvm_threads_live_threads{application=\"cowork-config\"}",
          "legendFormat": "전체 스레드",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "expr": "jvm_threads_daemon_threads{application=\"cowork-config\"}",
          "legendFormat": "데몬 스레드",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "min": 0,
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        }
      },
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "label": "데이터 소스"
      }
    ]
  }
}
