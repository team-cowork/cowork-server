{
  "title": "cowork / Infrastructure",
  "uid": "cowork-infrastructure",
  "tags": ["cowork", "infrastructure"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 9,
      "title": "모듈 DB - 메트릭 수집 상태",
      "type": "state-timeline",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "up{job=\"infrastructure\",service=~\"mysql|postgres|mongodb\"}",
          "legendFormat": "{{module}} / {{service}} / {{instance}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "noValue": "N/A",
          "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}] },
          "custom": { "fillOpacity": 80, "lineWidth": 0 }
        }
      },
      "options": { "mergeValues": true, "rowHeight": 0.8, "showValue": "auto", "alignValue": "left", "legend": {"showLegend": false}, "tooltip": {"mode": "single", "sort": "none"} },
      "description": "DB별 UP/DOWN 상태와 중단 시점을 표시합니다. 데이터가 없는 구간은 비워 둡니다."
    },
    {
      "id": 10,
      "title": "모듈 DB - 연결 상태",
      "type": "state-timeline",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "mysql_up{job=\"infrastructure\"} or pg_up{job=\"infrastructure\"} or mongodb_up{job=\"infrastructure\"}",
          "legendFormat": "{{module}} / {{service}} / {{instance}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "noValue": "N/A",
          "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}] },
          "custom": { "fillOpacity": 80, "lineWidth": 0 }
        }
      },
      "options": { "mergeValues": true, "rowHeight": 0.8, "showValue": "auto", "alignValue": "left", "legend": {"showLegend": false}, "tooltip": {"mode": "single", "sort": "none"} },
      "description": "DB별 UP/DOWN 상태와 중단 시점을 표시합니다. 데이터가 없는 구간은 비워 둡니다."
    },
    {
      "id": 1,
      "title": "MySQL - 초당 쿼리 수 (QPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rate(mysql_global_status_queries{service=\"mysql\"}[$__rate_interval])",
          "legendFormat": "{{module}} QPS",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": { "noValue": "N/A", "min": 0, "unit": "ops", "color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never"} }
      },
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 2,
      "title": "MySQL - 연결 수와 실행 중인 스레드 수",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "mysql_global_status_threads_connected{service=\"mysql\"}",
          "legendFormat": "{{module}} 연결 수",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "expr": "mysql_global_status_threads_running{service=\"mysql\"}",
          "legendFormat": "{{module}} 실행 중인 스레드 수",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "min": 0,
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        }
      },
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 3,
      "title": "Redis - 캐시 적중률 (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "rate(redis_keyspace_hits_total{service=\"redis\"}[$__rate_interval]) / (rate(redis_keyspace_hits_total{service=\"redis\"}[$__rate_interval]) + rate(redis_keyspace_misses_total{service=\"redis\"}[$__rate_interval])) * 100",
          "legendFormat": "캐시 적중률",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "N/A",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" },
          "max": 100
        }
      },
      "description": "조회가 없는 구간에는 적중률이 정의되지 않아 N/A로 표시합니다.",
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 4,
      "title": "Redis - 메모리 사용량",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "redis_memory_used_bytes{service=\"redis\"}",
          "legendFormat": "사용량",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "expr": "redis_memory_max_bytes{service=\"redis\"} > 0",
          "legendFormat": "최대 용량",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "N/A",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        }
      },
      "description": "최대 메모리 제한이 설정된 경우에만 최대 용량 선을 표시합니다.",
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 5,
      "title": "Kafka - 소비 지연 (오프셋)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "sum by (consumergroup, topic) (kafka_consumergroup_lag{service=\"kafka\"}) and on (consumergroup) kafka_consumergroup_members{service=\"kafka\"} @ end()",
          "legendFormat": "{{consumergroup}} / {{topic}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "min": 0,
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        }
      },
      "description": "조회 종료 시점에 수집된 그룹의 오프셋 차이입니다. 압축된 토픽은 실제 메시지 수와 다를 수 있습니다.",
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 6,
      "title": "Kafka - 초당 오프셋 증가량",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "sum by (topic) (clamp_min(deriv(kafka_topic_partition_current_offset{service=\"kafka\"}[$__rate_interval]), 0))",
          "legendFormat": "{{topic}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "description": "파티션 현재 오프셋은 gauge이므로 기울기로 증가 속도를 추정합니다. 정확한 처리 완료 메시지 수가 아닌 오프셋 증가 추세입니다.",
      "fieldConfig": {
        "defaults": { "noValue": "N/A", "min": 0, "unit": "ops", "color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never"} }
      },
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 7,
      "title": "PostgreSQL - 활성·유휴 커넥션",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "targets": [
        {
          "expr": "pg_stat_activity_count{service=\"postgres\", state=\"active\"}",
          "legendFormat": "{{module}} / {{datname}} 활성 연결",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "expr": "pg_stat_activity_count{service=\"postgres\", state=\"idle\"}",
          "legendFormat": "{{module}} / {{datname}} 유휴 연결",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "min": 0,
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        }
      },
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 8,
      "title": "PostgreSQL - 초당 트랜잭션",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit{service=\"postgres\", datname!~\"template.*|\"}[$__rate_interval])",
          "legendFormat": "{{module}} 초당 커밋 수",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "expr": "rate(pg_stat_database_xact_rollback{service=\"postgres\", datname!~\"template.*|\"}[$__rate_interval])",
          "legendFormat": "{{module}} 초당 롤백 수",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": { "noValue": "N/A", "min": 0, "unit": "ops", "color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never"} }
      },
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 14,
      "title": "모듈 DB - 애플리케이션 커넥션 풀 사용량",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "targets": [
        {
          "expr": "sum by (service) (hikaricp_connections_active)",
          "legendFormat": "{{service}} 사용 중",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "expr": "sum by (service) (hikaricp_connections_max)",
          "legendFormat": "{{service}} 최대 커넥션 수",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "B",
          "instant": false,
          "range": true
        },
        {
          "expr": "sum by (service) (go_sql_in_use_connections)",
          "legendFormat": "{{service}} 사용 중",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "C",
          "instant": false,
          "range": true
        },
        {
          "expr": "sum by (service) (go_sql_max_open_connections)",
          "legendFormat": "{{service}} 최대 커넥션 수",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "D",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "min": 0,
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        }
      },
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} },
      "description": "애플리케이션이 DB에 연결할 때 쓰는 커넥션 풀입니다. 사용 중인 커넥션 수가 최대치에 가까워지면 커넥션 풀이 고갈될 수 있습니다. SQLite는 쓰기를 한 번에 하나만 처리하므로 최대 커넥션 수가 1입니다."
    },
    {
      "id": 15,
      "title": "모듈 DB - 커넥션 대기",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "targets": [
        {
          "expr": "sum by (service) (hikaricp_connections_pending)",
          "legendFormat": "{{service}} 대기 중인 스레드 수",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "expr": "sum by (service) (rate(go_sql_wait_count_total[$__rate_interval]))",
          "legendFormat": "{{service}} 초당 대기 횟수",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "min": 0,
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        }
      },
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} },
      "description": "0보다 크면 커넥션을 기다리는 요청이 있다는 뜻입니다. 커넥션 풀 고갈의 초기 징후입니다. HikariCP는 지금 대기 중인 스레드 수를, Go 서비스는 초당 대기 횟수를 표시합니다."
    },
    {
      "id": 16,
      "title": "모듈 DB - 커넥션 획득 시간 (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, service) (rate(hikaricp_connections_acquire_seconds_bucket[$__rate_interval]))) * 1000",
          "legendFormat": "{{service}} P99",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "expr": "sum by (service) (rate(go_sql_wait_duration_seconds_total[$__rate_interval])) / (sum by (service) (rate(go_sql_wait_count_total[$__rate_interval])) > 0) * 1000",
          "legendFormat": "{{service}} 평균 대기 시간",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "noValue": "N/A", "min": 0, "color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never"} }
      },
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} },
      "description": "커넥션 풀이 고갈되기 시작하면 커넥션을 얻는 데 걸리는 시간이 늘어납니다. Go 서비스는 히스토그램이 없어 커넥션을 기다린 요청의 평균 대기 시간을 표시하고, 대기가 없던 구간은 비워 둡니다."
    },
    {
      "id": 17,
      "title": "SQLite - 파일 크기",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "targets": [
        {
          "expr": "cowork_notification_sqlite_file_size_bytes{file=\"db\"}",
          "legendFormat": "{{service}} DB 파일",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "expr": "cowork_notification_sqlite_file_size_bytes{file=\"wal\"}",
          "legendFormat": "{{service}} WAL 파일",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "N/A",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        }
      },
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} },
      "description": "WAL 파일이 줄지 않고 계속 커지면 체크포인트가 밀리고 있다는 뜻입니다. 볼륨이 있는 호스트의 디스크 사용률은 아래 파일시스템 사용률에서 확인합니다."
    },
    {
      "id": 11,
      "title": "호스트 CPU 사용률",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 56 },
      "targets": [
        {
          "expr": "100 * (1 - avg by (host, instance) (rate(node_cpu_seconds_total{service=\"host\",mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "{{host}} / {{instance}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "noValue": "N/A",
          "max": 100,
          "decimals": 1,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        }
      },
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 12,
      "title": "호스트 메모리 사용률",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 56 },
      "targets": [
        {
          "expr": "(1 - node_memory_MemAvailable_bytes{service=\"host\"} / node_memory_MemTotal_bytes{service=\"host\"}) * 100",
          "legendFormat": "{{host}} / {{instance}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
