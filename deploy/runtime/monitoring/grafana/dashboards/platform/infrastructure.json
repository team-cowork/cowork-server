{
  "title": "cowork / Infrastructure",
  "uid": "cowork-infrastructure",
  "tags": ["cowork", "infrastructure"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 9,
      "title": "모듈 DB - 메트릭 수집 상태",
      "type": "state-timeline",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "up{job=~\"infrastructure(-discovery)?\",service=~\"mysql|postgres|mongodb|surrealdb\"}",
          "legendFormat": "{{module}} / {{service}} / {{instance}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "noValue": "N/A",
          "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}] },
          "custom": { "fillOpacity": 80, "lineWidth": 0 }
        }
      },
      "options": { "mergeValues": true, "rowHeight": 0.8, "showValue": "auto", "alignValue": "left", "legend": {"showLegend": false}, "tooltip": {"mode": "single", "sort": "none"} },
      "description": "DB별 메트릭 수집 성공 여부입니다. 데이터가 없는 구간은 비워 둡니다."
    },
    {
      "id": 10,
      "title": "모듈 DB - 연결 상태",
      "type": "state-timeline",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "mysql_up{job=~\"infrastructure(-discovery)?\"} or pg_up{job=~\"infrastructure(-discovery)?\"} or mongodb_up{job=~\"infrastructure(-discovery)?\"} or up{job=\"infrastructure-discovery\",service=\"surrealdb\"}",
          "legendFormat": "{{module}} / {{service}} / {{instance}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "noValue": "N/A",
          "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}] },
          "custom": { "fillOpacity": 80, "lineWidth": 0 }
        }
      },
      "options": { "mergeValues": true, "rowHeight": 0.8, "showValue": "auto", "alignValue": "left", "legend": {"showLegend": false}, "tooltip": {"mode": "single", "sort": "none"} },
      "description": "DB별 연결 성공 여부입니다. 데이터가 없는 구간은 비워 둡니다."
    },
    {
      "id": 1,
      "title": "MySQL - 초당 쿼리 수 (QPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rate(mysql_global_status_queries{service=\"mysql\"}[$__rate_interval])",
          "legendFormat": "{{module}} QPS",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": { "noValue": "N/A", "min": 0, "unit": "ops", "color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never"} }
      },
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 2,
      "title": "MySQL - 연결 수와 실행 중인 스레드 수",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "mysql_global_status_threads_connected{service=\"mysql\"}",
          "legendFormat": "{{module}} 연결 수",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "expr": "mysql_global_status_threads_running{service=\"mysql\"}",
          "legendFormat": "{{module}} 실행 중인 스레드 수",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "min": 0,
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        }
      },
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 3,
      "title": "Redis - 캐시 적중률 (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "rate(redis_keyspace_hits_total{service=\"redis\"}[$__rate_interval]) / (rate(redis_keyspace_hits_total{service=\"redis\"}[$__rate_interval]) + rate(redis_keyspace_misses_total{service=\"redis\"}[$__rate_interval])) * 100",
          "legendFormat": "캐시 적중률",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "N/A",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" },
          "max": 100
        }
      },
      "description": "Redis 조회 중 캐시에 적중한 비율입니다. 조회가 없는 구간은 N/A입니다.",
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 4,
      "title": "Redis - 메모리 사용량",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "redis_memory_used_bytes{service=\"redis\"}",
          "legendFormat": "사용량",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "expr": "redis_memory_max_bytes{service=\"redis\"} > 0",
          "legendFormat": "최대 용량",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "N/A",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        }
      },
      "description": "Redis의 현재 메모리 사용량과 설정된 최대 메모리 용량입니다. 최대 용량은 제한이 설정된 경우에만 표시합니다.",
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 5,
      "title": "Kafka - 소비 지연 (오프셋)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "sum by (consumergroup, topic) (kafka_consumergroup_lag{service=\"kafka\"}) and on (consumergroup) kafka_consumergroup_members{service=\"kafka\"} @ end()",
          "legendFormat": "{{consumergroup}} / {{topic}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "min": 0,
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        }
      },
      "description": "조회 종료 시점에 수집된 소비자 그룹의 토픽별 오프셋 지연 합계입니다. 압축된 토픽에서는 실제 메시지 수와 다를 수 있습니다.",
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 6,
      "title": "Kafka - 초당 오프셋 증가량",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "sum by (topic) (clamp_min(deriv(kafka_topic_partition_current_offset{service=\"kafka\"}[$__rate_interval]), 0))",
          "legendFormat": "{{topic}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "description": "Kafka 파티션별 현재 오프셋의 초당 증가량을 추정해 토픽별로 합산한 값입니다.",
      "fieldConfig": {
        "defaults": { "noValue": "N/A", "min": 0, "unit": "ops", "color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never"} }
      },
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 7,
      "title": "PostgreSQL - 활성·유휴 커넥션",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "targets": [
        {
          "expr": "pg_stat_activity_count{service=\"postgres\", state=\"active\"}",
          "legendFormat": "{{module}} / {{datname}} 활성 연결",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "expr": "pg_stat_activity_count{service=\"postgres\", state=\"idle\"}",
          "legendFormat": "{{module}} / {{datname}} 유휴 연결",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "min": 0,
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        }
      },
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 8,
      "title": "PostgreSQL - 초당 트랜잭션",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit{service=\"postgres\", datname!~\"template.*|\"}[$__rate_interval])",
          "legendFormat": "{{module}} 초당 커밋 수",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "expr": "rate(pg_stat_database_xact_rollback{service=\"postgres\", datname!~\"template.*|\"}[$__rate_interval])",
          "legendFormat": "{{module}} 초당 롤백 수",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": { "noValue": "N/A", "min": 0, "unit": "ops", "color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never"} }
      },
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 18,
      "title": "MongoDB - 초당 작업 수",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "targets": [
        {
          "expr": "sum by (module, type) (rate(mongodb_op_counters_total{service=\"mongodb\"}[$__rate_interval]))",
          "legendFormat": "{{module}} / {{type}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "min": 0,
          "unit": "ops",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        }
      },
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} },
      "description": "insert, query, update, delete, getmore, command 작업의 초당 처리 횟수입니다."
    },
    {
      "id": 19,
      "title": "MongoDB - 작업 평균 지연",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "targets": [
        {
          "expr": "sum by (module, type) (rate(mongodb_mongod_op_latencies_latency_total{service=\"mongodb\",type=~\"read|write|command\"}[$__rate_interval])) / (sum by (module, type) (rate(mongodb_mongod_op_latencies_ops_total{service=\"mongodb\",type=~\"read|write|command\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{module}} / {{type}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "min": 0,
          "unit": "µs",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        }
      },
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} },
      "description": "읽기, 쓰기, 명령 작업 1건의 서버 내부 평균 처리 시간입니다. 해당 구간에 작업이 없으면 비워 둡니다."
    },
    {
      "id": 20,
      "title": "MongoDB - 연결 수",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "targets": [
        {
          "expr": "mongodb_connections{service=\"mongodb\",state=\"current\"}",
          "legendFormat": "{{module}} 현재 연결",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "expr": "mongodb_connections{service=\"mongodb\",state=\"active\"}",
          "legendFormat": "{{module}} 작업 중인 연결",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "min": 0,
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        }
      },
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} },
      "description": "현재 열린 클라이언트 연결 수와 그중 작업을 실행 중인 연결 수입니다."
    },
    {
      "id": 21,
      "title": "MongoDB - WiredTiger 캐시 사용량",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "targets": [
        {
          "expr": "mongodb_mongod_wiredtiger_cache_bytes{service=\"mongodb\",type=\"total\"}",
          "legendFormat": "{{module}} 사용량",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "expr": "mongodb_mongod_wiredtiger_cache_max_bytes{service=\"mongodb\"}",
          "legendFormat": "{{module}} 최대 용량",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "min": 0,
          "unit": "bytes",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        }
      },
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} },
      "description": "WiredTiger 캐시의 현재 사용량과 설정된 최대 용량입니다. 사용량이 최대 용량에 가까우면 디스크 읽기와 축출이 늘어납니다."
    },
    {
      "id": 22,
      "title": "MongoDB - 프로세스 상주 메모리",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 56 },
      "targets": [
        {
          "expr": "mongodb_memory{service=\"mongodb\",type=\"resident\"}",
          "legendFormat": "{{module}} 상주 메모리",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "min": 0,
          "unit": "mbytes",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        }
      },
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} },
      "description": "mongod 프로세스가 실제로 점유한 물리 메모리입니다."
    },
    {
      "id": 23,
      "title": "MongoDB - 컬렉션 전체 스캔 (회/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 56 },
      "targets": [
        {
          "expr": "sum by (module) (rate(mongodb_ss_metrics_queryExecutor_collectionScans_total{service=\"mongodb\"}[$__rate_interval]))",
          "legendFormat": "{{module}} 전체 스캔",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "min": 0,
          "unit": "ops",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        }
      },
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} },
      "description": "인덱스를 쓰지 않고 컬렉션 전체를 읽은 쿼리의 초당 횟수입니다. 이 값이 계속 높으면 인덱스가 빠졌을 수 있습니다."
    },
    {
      "id": 24,
      "title": "SurrealDB - 메모리 사용량",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 64 },
      "targets": [
        {
          "expr": "surrealdb_process_memory_bytes{service=\"surrealdb\"}",
          "legendFormat": "{{module}} 메모리",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "min": 0,
          "unit": "bytes",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        }
      },
