  "panels": [
    {
      "id": 1,
      "title": "관리 VM — API 지표 수집",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "cowork-prometheus"
      },
      "description": "관리 VM의 Nomad·Consul HTTPS 메트릭 수집 결과입니다. UP은 수집 성공을 뜻하며, 클러스터 건강은 옆 Autopilot 패널에서 확인합니다.",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "up{job=~\"nomad|consul\",host=\"control\"}",
          "legendFormat": "{{service}}",
          "datasource": {
            "type": "prometheus",
            "uid": "cowork-prometheus"
          },
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "min": 0,
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 2,
      "title": "관리 VM — 클러스터 건강",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "cowork-prometheus"
      },
      "description": "각 서버의 Autopilot 건강 판정입니다. 현재 Nomad·Consul 서버는 cowork-control 한 대에 있으므로 관리 VM 장애를 견디는 구성이 아닙니다.",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "nomad_nomad_autopilot_healthy{job=\"nomad\",host=\"control\"}",
          "legendFormat": "Nomad",
          "datasource": {
            "type": "prometheus",
            "uid": "cowork-prometheus"
          },
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "expr": "consul_autopilot_healthy{job=\"consul\",host=\"control\"}",
          "legendFormat": "Consul",
          "datasource": {
            "type": "prometheus",
            "uid": "cowork-prometheus"
          },
          "refId": "B",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "min": 0,
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "이상",
                  "color": "red"
                },
                "1": {
                  "text": "정상",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "title": "Consul 리더",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "cowork-prometheus"
      },
      "description": "cowork-control이 Consul 리더이면 1입니다. 현재 단일 서버 구성에서는 이 서버가 리더여야 합니다.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "expr": "consul_server_isLeader{job=\"consul\",host=\"control\"}",
          "legendFormat": "cowork-control",
          "datasource": {
            "type": "prometheus",
            "uid": "cowork-prometheus"
          },
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "min": 0,
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "리더 아님",
                  "color": "red"
                },
                "1": {
                  "text": "리더",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 4,
      "title": "Consul 허용 서버 장애 수",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "cowork-prometheus"
      },
      "description": "합의를 유지하면서 추가로 장애가 나도 되는 서버 수입니다. 단일 서버인 현재 구성의 0은 예상값이며 이중화가 없다는 뜻입니다.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "targets": [
        {
          "expr": "consul_autopilot_failure_tolerance{job=\"consul\",host=\"control\"}",
          "legendFormat": "서버 수",
          "datasource": {
            "type": "prometheus",
            "uid": "cowork-prometheus"
          },
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "min": 0,
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 5,
      "title": "관리 VM — CPU 사용률",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "cowork-prometheus"
      },
      "description": "Nomad·Consul 서버와 배포 runner가 함께 사용하는 관리 VM의 전체 CPU 사용률입니다.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{job=\"hosts\",host=\"control\",mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "cowork-control",
          "datasource": {
            "type": "prometheus",
            "uid": "cowork-prometheus"
          },
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "min": 0,
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          },
          "max": 100,
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "관리 VM — 메모리 사용률",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "cowork-prometheus"
      },
      "description": "사용 가능한 메모리를 기준으로 계산합니다. 배포 시 runner와 제어 서비스가 같은 메모리를 사용합니다.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 5
      },
      "targets": [
        {
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"hosts\",host=\"control\"} / node_memory_MemTotal_bytes{job=\"hosts\",host=\"control\"})",
          "legendFormat": "cowork-control",
          "datasource": {
            "type": "prometheus",
            "uid": "cowork-prometheus"
          },
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "min": 0,
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          },
          "max": 100,
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "관리 VM — 파일시스템 사용률",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "cowork-prometheus"
      },
      "description": "관리 VM의 영구 파일시스템 사용률입니다. 85%부터 주의, 93%부터 위험으로 표시합니다. 임시·컨테이너 파일시스템은 제외합니다.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "targets": [
        {
          "expr": "sort_desc(100 * (1 - node_filesystem_avail_bytes{job=\"hosts\",host=\"control\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs\"} / (node_filesystem_size_bytes{job=\"hosts\",host=\"control\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs\"} > 0)))",
          "legendFormat": "{{mountpoint}}",
          "datasource": {
            "type": "prometheus",
            "uid": "cowork-prometheus"
          },
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "min": 0,
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 85
              },
              {
                "color": "red",
                "value": 93
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "color"
      }
    },
    {
      "id": 8,
      "title": "관리 VM — 가동 시간",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "cowork-prometheus"
      },
      "description": "VM이 마지막으로 부팅된 뒤 경과한 시간입니다. Nomad·Consul 프로세스의 개별 실행 시간은 아닙니다.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "expr": "time() - node_boot_time_seconds{job=\"hosts\",host=\"control\"}",
          "legendFormat": "부팅 후 경과",
          "datasource": {
            "type": "prometheus",
            "uid": "cowork-prometheus"
          },
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "min": 0,
          "unit": "dtdurations",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
