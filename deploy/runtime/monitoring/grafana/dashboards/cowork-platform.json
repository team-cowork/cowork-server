    {
      "id": 5,
      "title": "관리 VM CPU 사용률",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "cowork-prometheus"
      },
      "description": "관리 VM의 전체 CPU 코어 평균 사용률입니다.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{job=\"hosts\",host=\"control\",mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "cowork-control",
          "datasource": {
            "type": "prometheus",
            "uid": "cowork-prometheus"
          },
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "min": 0,
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          },
          "max": 100,
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "관리 VM 메모리 사용률",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "cowork-prometheus"
      },
      "description": "사용 가능한 메모리를 기준으로 계산한 관리 VM의 메모리 사용률입니다.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 5
      },
      "targets": [
        {
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"hosts\",host=\"control\"} / node_memory_MemTotal_bytes{job=\"hosts\",host=\"control\"})",
          "legendFormat": "cowork-control",
          "datasource": {
            "type": "prometheus",
            "uid": "cowork-prometheus"
          },
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "min": 0,
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          },
          "max": 100,
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "관리 VM 파일시스템 사용률",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "cowork-prometheus"
      },
      "description": "임시·컨테이너 파일시스템을 제외한 관리 VM의 마운트 지점별 사용률입니다.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "targets": [
        {
          "expr": "sort_desc(100 * (1 - node_filesystem_avail_bytes{job=\"hosts\",host=\"control\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs\"} / (node_filesystem_size_bytes{job=\"hosts\",host=\"control\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs\"} > 0)))",
          "legendFormat": "{{mountpoint}}",
          "datasource": {
            "type": "prometheus",
            "uid": "cowork-prometheus"
          },
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "min": 0,
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 85
              },
              {
                "color": "red",
                "value": 93
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "color"
      }
    },
    {
      "id": 8,
      "title": "관리 VM 가동 시간",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "cowork-prometheus"
