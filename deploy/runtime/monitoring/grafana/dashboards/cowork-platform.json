    {
      "id": 10,
      "title": "Nomad 준비 클라이언트",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "cowork-prometheus"
      },
      "description": "수집된 Nomad 클라이언트 중 node_status가 ready인 노드 수입니다. 준비된 노드가 없으면 0, 클라이언트 지표가 없으면 N/A입니다.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 9,
        "y": 13
      },
      "targets": [
        {
          "expr": "count(max by (node_id) (nomad_client_allocations_running{job=\"nomad\",role=\"client\",node_status=\"ready\"})) or (0 * count(max by (node_id) (nomad_client_allocations_running{job=\"nomad\",role=\"client\"})))",
          "legendFormat": "ready 노드",
          "datasource": {
            "type": "prometheus",
            "uid": "cowork-prometheus"
          },
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "min": 0,
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
