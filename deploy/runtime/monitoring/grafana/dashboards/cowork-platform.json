    {
      "id": 13,
      "title": "Nomad 현재 할당 상태",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "cowork-prometheus"
      },
      "description": "지표가 수집된 Nomad 클라이언트의 현재 할당 수를 상태별로 합산한 값입니다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "expr": "sum(nomad_client_allocations_running{job=\"nomad\",role=\"client\"})",
          "legendFormat": "실행 중",
          "datasource": {
            "type": "prometheus",
            "uid": "cowork-prometheus"
          },
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "expr": "sum(nomad_client_allocations_pending{job=\"nomad\",role=\"client\"})",
          "legendFormat": "시작 대기",
          "datasource": {
            "type": "prometheus",
            "uid": "cowork-prometheus"
          },
          "refId": "B",
          "instant": false,
          "range": true
        },
        {
          "expr": "sum(nomad_client_allocations_blocked{job=\"nomad\",role=\"client\"})",
          "legendFormat": "차단",
          "datasource": {
            "type": "prometheus",
            "uid": "cowork-prometheus"
          },
          "refId": "C",
          "instant": false,
          "range": true
        },
        {
          "expr": "sum(nomad_client_allocations_migrating{job=\"nomad\",role=\"client\"})",
