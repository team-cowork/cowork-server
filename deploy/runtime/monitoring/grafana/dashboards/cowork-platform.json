    {
      "id": 10,
      "title": "Nomad 준비 클라이언트",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "cowork-prometheus"
      },
      "description": "지표를 수집한 클라이언트 중 node_status가 ready인 노드 수입니다. 알려진 클라이언트가 모두 ready가 아니면 0, 클라이언트 지표 자체가 없으면 N/A입니다. 아래 수집 상태도 함께 확인하세요.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 9,
        "y": 13
      },
      "targets": [
        {
          "expr": "count(max by (node_id) (nomad_client_allocations_running{job=\"nomad\",role=\"client\",node_status=\"ready\"})) or (0 * count(max by (node_id) (nomad_client_allocations_running{job=\"nomad\",role=\"client\"})))",
          "legendFormat": "ready 노드",
          "datasource": {
            "type": "prometheus",
            "uid": "cowork-prometheus"
          },
          "refId": "A",
          "instant": true,
          "range": false
