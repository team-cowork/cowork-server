{
  "title": "cowork / Gateway",
  "uid": "cowork-gateway",
  "tags": ["cowork", "service", "gateway"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "메트릭 수집 상태",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "min(up{job=\"cowork-services\",service=\"gateway\"})",
          "legendFormat": "gateway",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": { "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "auto", "orientation": "auto" },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "noValue": "N/A",
          "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}] }
        }
      },
      "description": "인스턴스 하나라도 수집에 실패하면 DOWN입니다."
    },
    {
      "id": 100,
      "title": "서비스 준비 상태",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [
        {
          "expr": "min(probe_success{job=\"blackbox\",service=\"gateway\"})",
          "legendFormat": "gateway",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "noValue": "N/A",
          "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}] }
        }
      },
      "description": "점검 대상이나 결과가 없으면 N/A입니다.",
      "options": { "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "auto", "orientation": "auto" }
    },
    {
      "id": 200,
      "title": "Envoy 연결 상태",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "cowork_envoy_proxy_reachable{service=\"gateway\"}",
          "legendFormat": "Envoy",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": { "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "auto", "orientation": "auto" },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "noValue": "N/A",
          "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}] }
        }
      },
      "description": "프록시 포트의 TCP 연결을 점검합니다. Nomad 지표는 수집되지만 프록시 등록이 없으면 DOWN입니다."
    },
    {
      "id": 101,
      "title": "현재 초당 요청 수",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{service=\"gateway\",job=~\"cowork-.*\",uri!~\"/actuator.*|/metrics|/health|/api/health|/api/[^/]+/health(/.*)?\"}[$__rate_interval]))",
          "legendFormat": "요청",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": { "defaults": {"unit": "reqps", "min": 0, "noValue": "N/A", "color": {"mode": "fixed", "fixedColor": "blue"}} },
      "options": { "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "colorMode": "value", "graphMode": "none", "textMode": "auto" }
    },
    {
      "id": 102,
      "title": "현재 HTTP 5xx 오류 비율",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "((sum(rate(http_server_requests_seconds_count{service=\"gateway\",job=~\"cowork-.*\",uri!~\"/actuator.*|/metrics|/health|/api/health|/api/[^/]+/health(/.*)?\",status=~\"5..\"}[$__rate_interval]))) or (0 * (sum(rate(http_server_requests_seconds_count{service=\"gateway\",job=~\"cowork-.*\",uri!~\"/actuator.*|/metrics|/health|/api/health|/api/[^/]+/health(/.*)?\"}[$__rate_interval]))))) / ((sum(rate(http_server_requests_seconds_count{service=\"gateway\",job=~\"cowork-.*\",uri!~\"/actuator.*|/metrics|/health|/api/health|/api/[^/]+/health(/.*)?\"}[$__rate_interval]))) > 0) * 100",
          "legendFormat": "5xx",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": { "defaults": {"unit": "percent", "min": 0, "noValue": "N/A", "max": 100, "decimals": 1, "color": {"mode": "fixed", "fixedColor": "blue"}} },
      "description": "요청이나 지표가 없으면 N/A입니다.",
      "options": { "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "colorMode": "value", "graphMode": "none", "textMode": "auto" }
    },
    {
      "id": 201,
      "title": "배포 상태 초기 동기화",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
      "targets": [
        {
          "expr": "min(gateway_deployment_state_initialized{job=\"cowork-services\",service=\"gateway\"}) and (min(up{job=\"cowork-services\",service=\"gateway\"}) == 1) and on () (count(gateway_deployment_state_initialized{job=\"cowork-services\",service=\"gateway\"}) == count(up{job=\"cowork-services\",service=\"gateway\"}))",
          "legendFormat": "초기 동기화",
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "auto", "orientation": "auto"},
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "noValue": "N/A",
          "mappings": [{"type": "value", "options": {"0": {"text": "미완료", "color": "red"}, "1": {"text": "완료", "color": "green"}}}],
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        }
      },
      "description": "모든 인스턴스가 Redis에서 배포 상태를 한 번 이상 읽으면 완료입니다. 수집에 실패하거나 지표가 누락되면 N/A입니다."
    },
    {
      "id": 2,
      "title": "경로별 HTTP 요청 수 (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum by (uri)(rate(http_server_requests_seconds_count{service=\"gateway\",job=~\"cowork-.*\",uri!~\"/actuator.*|/metrics|/health|/api/health|/api/[^/]+/health(/.*)?\"}[$__rate_interval]))",
          "legendFormat": "{{uri}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "min": 0,
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        }
      },
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 3,
      "title": "HTTP 응답 시간 평균 / P95 / P99 (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, uri) (rate(http_server_requests_seconds_bucket{service=\"gateway\",job=~\"cowork-.*\",uri!~\"/actuator.*|/metrics|/health|/api/health|/api/[^/]+/health(/.*)?\"}[$__rate_interval]))) * 1000",
          "legendFormat": "P99 {{uri}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{service=\"gateway\",job=~\"cowork-.*\",uri!~\"/actuator.*|/metrics|/health|/api/health|/api/[^/]+/health(/.*)?\"}[$__rate_interval]))) * 1000",
          "legendFormat": "P95 {{uri}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "B",
          "instant": false,
          "range": true
        },
        {
          "expr": "sum by (uri)(rate(http_server_requests_seconds_sum{service=\"gateway\",job=~\"cowork-.*\",uri!~\"/actuator.*|/metrics|/health|/api/health|/api/[^/]+/health(/.*)?\"}[$__rate_interval])) / (sum by (uri)(rate(http_server_requests_seconds_count{service=\"gateway\",job=~\"cowork-.*\",uri!~\"/actuator.*|/metrics|/health|/api/health|/api/[^/]+/health(/.*)?\"}[$__rate_interval])) > 0) * 1000",
          "legendFormat": "평균 {{uri}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "C",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "noValue": "N/A", "min": 0, "color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never"} }
      },
      "description": "P95와 P99는 히스토그램 버킷이 있는 경로에 표시합니다.",
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 4,
      "title": "HTTP 5xx 오류 비율 (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "((sum(rate(http_server_requests_seconds_count{service=\"gateway\",job=~\"cowork-.*\",uri!~\"/actuator.*|/metrics|/health|/api/health|/api/[^/]+/health(/.*)?\",status=~\"5..\"}[$__rate_interval]))) or (0 * (sum(rate(http_server_requests_seconds_count{service=\"gateway\",job=~\"cowork-.*\",uri!~\"/actuator.*|/metrics|/health|/api/health|/api/[^/]+/health(/.*)?\"}[$__rate_interval]))))) / ((sum(rate(http_server_requests_seconds_count{service=\"gateway\",job=~\"cowork-.*\",uri!~\"/actuator.*|/metrics|/health|/api/health|/api/[^/]+/health(/.*)?\"}[$__rate_interval]))) > 0) * 100",
          "legendFormat": "5xx 오류 비율",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "N/A",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" },
          "max": 100
        }
      },
      "description": "요청이나 지표가 없으면 N/A입니다.",
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 5,
      "title": "JVM 힙 메모리",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{application=\"cowork-gateway\", area=\"heap\"}",
          "legendFormat": "사용량 {{id}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "expr": "jvm_memory_max_bytes{application=\"cowork-gateway\", area=\"heap\"}",
          "legendFormat": "최대 용량 {{id}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "N/A",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        }
      },
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 6,
      "title": "JVM GC 일시정지 시간 (ms/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum{application=\"cowork-gateway\"}[$__rate_interval]) * 1000",
          "legendFormat": "{{action}} {{cause}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:ms/s",
          "noValue": "N/A",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        }
      },
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 7,
      "title": "JVM 스레드",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "expr": "jvm_threads_live_threads{application=\"cowork-gateway\"}",
          "legendFormat": "전체 스레드",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "expr": "jvm_threads_daemon_threads{application=\"cowork-gateway\"}",
          "legendFormat": "데몬 스레드",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "min": 0,
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        }
      },
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 8,
      "title": "요청 한도 초과와 제한기 오류 (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "targets": [
        {
          "expr": "sum by (route)(rate(gateway_ratelimit_events_total{service=\"gateway\",job=~\"cowork-.*\",outcome=\"rejected\"}[$__rate_interval]))",
          "legendFormat": "한도 초과 {{route}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "expr": "sum by (route)(rate(gateway_ratelimit_events_total{service=\"gateway\",job=~\"cowork-.*\",outcome=\"redis_error\"}[$__rate_interval]))",
          "legendFormat": "제한기 오류 {{route}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "B",
          "instant": false,
          "range": true
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{service=\"gateway\",job=~\"cowork-.*\",uri!~\"/actuator.*|/metrics|/health|/api/health|/api/[^/]+/health(/.*)?\",status=\"429\"}[$__rate_interval]))",
          "legendFormat": "HTTP 429 전체",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "C",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "min": 0,
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        }
      },
      "description": "Redis 호출에 실패하면 요청을 허용하고 제한기 오류로 집계합니다. 전체 429에는 백엔드 응답도 포함됩니다.",
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 9,
      "title": "웹훅 서명 거부 (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [
        {
          "expr": "sum by (reason)(rate(gateway_webhook_signature_rejections_total{service=\"gateway\",job=~\"cowork-.*\"}[$__rate_interval]))",
          "legendFormat": "{{reason}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "min": 0,
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        }
      },
      "description": "invalid는 서명 오류(403), unavailable은 서명 키 설정 오류(503)입니다.",
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 13,
      "title": "서비스별 배포 상태",
      "type": "stat",
      "gridPos": {"h": 5, "w": 24, "x": 0, "y": 36},
      "targets": [
        {
          "expr": "max by (target_service) (gateway_deployment_state{job=\"cowork-services\",service=\"gateway\"}) and on () (min(gateway_deployment_state_initialized{job=\"cowork-services\",service=\"gateway\"}) == 1) and on () (min(up{job=\"cowork-services\",service=\"gateway\"}) == 1) and on () (count(gateway_deployment_state_initialized{job=\"cowork-services\",service=\"gateway\"}) == count(up{job=\"cowork-services\",service=\"gateway\"}))",
          "legendFormat": "{{target_service}}",
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "auto", "orientation": "auto"},
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 2,
          "noValue": "N/A",
          "mappings": [{"type": "value", "options": {"0": {"text": "정상", "color": "green"}, "1": {"text": "배포 중", "color": "blue"}, "2": {"text": "복구 중", "color": "orange"}}}],
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "blue", "value": 1}, {"color": "orange", "value": 2}]}
        }
      },
      "description": "인스턴스별 상태가 다르면 복구 중, 배포 중, 정상 순으로 표시합니다. 초기 동기화 전이거나 수집 실패 또는 지표 누락이 있으면 N/A입니다."
    },
    {
      "id": 10,
      "title": "서비스별 배포 안내 503 (req/s)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 41},
      "targets": [
        {
          "expr": "sum by (exported_service, reason) (rate(gateway_deployment_guidance_requests_total{job=\"cowork-services\",service=\"gateway\"}[$__rate_interval]))",
          "legendFormat": "{{exported_service}} {{reason}}",
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "refId": "A",
