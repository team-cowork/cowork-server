{
  "uid": "cowork-service-slots",
  "title": "cowork / Service Health",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "cowork",
    "health"
  ],
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "서비스",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "cowork-prometheus"
        },
        "query": "label_values(up{job=\"cowork-services\",service!~\".*-sidecar-proxy\"}, service)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "state-timeline",
      "title": "원본 애플리케이션 준비 상태",
      "datasource": {
        "type": "prometheus",
        "uid": "cowork-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "min by (service) (probe_success{job=\"blackbox\",service!~\".*-sidecar-proxy\",service=~\"$service\"})",
          "refId": "A",
          "legendFormat": "{{service}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "noValue": "N/A",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        }
      },
      "options": {
        "mergeValues": true,
        "rowHeight": 0.8,
        "showValue": "auto",
        "alignValue": "left",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "description": "각 VM의 Alloy가 Envoy를 거치지 않고 앱의 readiness 엔드포인트를 직접 확인합니다. 앱이 반환하는 준비 상태이며, 관측 데이터가 없는 구간은 비워 둡니다."
    },
    {
      "id": 2,
      "type": "state-timeline",
      "title": "애플리케이션 메트릭 수집 상태",
      "datasource": {
        "type": "prometheus",
        "uid": "cowork-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "min by (service) (up{job=\"cowork-services\",service!~\".*-sidecar-proxy\",service=~\"$service\"})",
          "refId": "A",
          "legendFormat": "{{service}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "noValue": "N/A",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        }
      },
      "options": {
        "mergeValues": true,
        "rowHeight": 0.8,
        "showValue": "auto",
        "alignValue": "left",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "description": "Envoy의 메트릭 노출 경로를 통한 수집 성공 여부입니다. Envoy 장애로 수집이 실패해도 원본 애플리케이션 준비 상태는 별도로 확인합니다."
    },
    {
      "id": 7,
      "type": "state-timeline",
      "title": "Envoy 프록시 연결 상태",
      "datasource": {
        "type": "prometheus",
        "uid": "cowork-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "expr": "cowork_envoy_proxy_reachable{service=~\"$service\"}",
          "refId": "A",
          "legendFormat": "{{service}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "noValue": "N/A",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        }
      },
      "options": {
        "mergeValues": true,
        "rowHeight": 0.8,
        "showValue": "auto",
        "alignValue": "left",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "description": "Envoy 프록시 포트의 TCP 연결 결과입니다. 프록시 등록이 없고 Nomad 지표를 수집할 수 있으면 DOWN입니다."
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "서비스 준비 상태 확인 응답 시간",
      "description": "각 VM의 Alloy가 원본 앱의 readiness 엔드포인트를 직접 확인하는 데 걸린 시간입니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "cowork-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "max by (service) (probe_duration_seconds{job=\"blackbox\",service!~\".*-sidecar-proxy\",service=~\"$service\"})",
          "refId": "A",
          "legendFormat": "{{service}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "N/A",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "title": "현재 활성 알림",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "ALERTS{alertstate=\"firing\",service=~\"$service\"}",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "cowork-prometheus"
          },
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "N/A"
        }
      },
      "description": "현재 발생 중인 알림의 이름·심각도·서비스·대상을 표시합니다. All을 선택하면 서비스 라벨이 없는 검색·호스트 메트릭 누락 알림도 포함합니다. 활성 알림이 없으면 결과가 비어 있습니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "cowork-prometheus"
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "심각도",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "alertstate": true,
              "job": true
            },
            "indexByName": {
              "severity": 0,
              "service": 1,
              "alertname": 2,
              "instance": 3,
              "module": 4
            },
            "renameByName": {
              "alertname": "알림",
              "severity": "심각도",
              "service": "서비스",
              "instance": "대상",
              "module": "모듈"
            }
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "state-timeline",
      "title": "외부 공개 게이트웨이 HTTPS API",
      "description": "외부 /api/health의 HTTPS 연결·JSON 응답과 점검 결과 수집 상태입니다. 내부 서비스 준비 상태는 위 타임라인에서 확인합니다. 데이터가 없는 구간은 비워 둡니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "cowork-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "probe_success{job=\"public-gateway\"}",
          "refId": "A",
          "legendFormat": "외부 공개 JSON API",
          "instant": false,
          "range": true
        },
        {
          "expr": "up{job=\"public-gateway\"}",
          "refId": "B",
          "legendFormat": "상태 점검 결과 수집",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "noValue": "N/A",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        }
      },
      "options": {
        "mergeValues": true,
        "rowHeight": 0.8,
        "showValue": "auto",
        "alignValue": "left",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 6,
      "type": "state-timeline",
      "title": "게이트웨이 경유 업무 API",
      "description": "게이트웨이를 거친 서비스별 대표 API의 무인증 요청 결과와 CORS preflight 결과입니다. 공개 API가 downstream 응답을 돌려주면 정상으로 봅니다. 데이터가 없는 구간은 비워 둡니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "cowork-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "min by (service) (probe_success{job=\"gateway-api\",service=~\"$service\"})",
          "refId": "A",
          "legendFormat": "{{service}}",
          "instant": false,
          "range": true
        },
        {
          "expr": "probe_success{job=\"gateway-cors\"}",
          "refId": "B",
          "legendFormat": "CORS preflight",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "noValue": "N/A",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        }
      },
      "options": {
        "mergeValues": true,
        "rowHeight": 0.8,
        "showValue": "auto",
        "alignValue": "left",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    }
  ]
}
