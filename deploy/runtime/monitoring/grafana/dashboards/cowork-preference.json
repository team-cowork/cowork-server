{
  "title": "cowork / Preference",
  "uid": "cowork-preference",
  "tags": ["cowork", "service", "preference"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "메트릭 수집 상태",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "min(up{job=\"cowork-services\",service=\"preference\"})",
          "legendFormat": "preference",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": { "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "auto", "orientation": "auto" },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "noValue": "N/A",
          "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}] }
        }
      },
      "description": "애플리케이션 메트릭 수집 성공 여부입니다. 인스턴스 하나라도 수집에 실패하면 DOWN입니다."
    },
    {
      "id": 100,
      "title": "서비스 준비 상태",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [
        {
          "expr": "min(probe_success{job=\"blackbox\",service=\"preference\"})",
          "legendFormat": "preference",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "noValue": "N/A",
          "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}] }
        }
      },
      "description": "준비 상태 점검 결과입니다. 점검 대상이 없거나 결과가 누락되면 N/A입니다.",
      "options": { "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "auto", "orientation": "auto" }
    },
    {
      "id": 200,
      "title": "Envoy 실행 상태",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "cowork_envoy_task_running{service=\"preference\"}",
          "legendFormat": "Envoy",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": { "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "auto", "orientation": "auto" },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "noValue": "N/A",
          "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}] }
        }
      },
      "description": "Nomad가 보고한 Envoy 사이드카 작업의 실행 상태입니다. Nomad 지표를 수집하지 못하면 N/A입니다."
    },
    {
      "id": 101,
      "title": "현재 초당 요청 수",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(vertx_http_server_requests_total{route!~\"/health(/.*)?|/metrics\",service=\"preference\",job=~\"cowork-.*\"}[$__rate_interval]))",
          "legendFormat": "요청",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": { "defaults": {"unit": "reqps", "min": 0, "noValue": "N/A", "color": {"mode": "fixed", "fixedColor": "blue"}} },
      "options": { "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "colorMode": "value", "graphMode": "none", "textMode": "auto" }
    },
    {
      "id": 102,
      "title": "현재 HTTP 5xx 오류 비율",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "((sum(rate(vertx_http_server_requests_total{route!~\"/health(/.*)?|/metrics\",service=\"preference\",job=~\"cowork-.*\",code=~\"5..\"}[$__rate_interval]))) or (0 * (sum(rate(vertx_http_server_requests_total{route!~\"/health(/.*)?|/metrics\",service=\"preference\",job=~\"cowork-.*\"}[$__rate_interval]))))) / ((sum(rate(vertx_http_server_requests_total{route!~\"/health(/.*)?|/metrics\",service=\"preference\",job=~\"cowork-.*\"}[$__rate_interval]))) > 0) * 100",
          "legendFormat": "5xx",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": { "defaults": {"unit": "percent", "min": 0, "noValue": "N/A", "max": 100, "decimals": 1, "color": {"mode": "fixed", "fixedColor": "blue"}} },
      "description": "요청이 발생한 구간의 5xx 비율입니다. 요청이 없거나 메트릭이 없으면 N/A로 표시합니다.",
      "options": { "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "colorMode": "value", "graphMode": "none", "textMode": "auto" }
    },
    {
      "id": 2,
      "title": "초당 HTTP 요청 수 (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum by (method)(rate(vertx_http_server_requests_total{route!~\"/health(/.*)?|/metrics\",service=\"preference\",job=~\"cowork-.*\"}[$__rate_interval]))",
          "legendFormat": "{{method}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "min": 0,
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        }
      },
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 3,
      "title": "HTTP 평균 응답 시간 (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "sum by (method)(rate(vertx_http_server_response_time_seconds_sum{route!~\"/health(/.*)?|/metrics\",service=\"preference\",job=~\"cowork-.*\"}[$__rate_interval])) / (sum by (method)(rate(vertx_http_server_response_time_seconds_count{route!~\"/health(/.*)?|/metrics\",service=\"preference\",job=~\"cowork-.*\"}[$__rate_interval])) > 0) * 1000",
          "legendFormat": "{{method}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "noValue": "N/A", "min": 0, "color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never"} }
      },
      "description": "응답 시간 합계의 증가량을 요청 수 증가량으로 나눈 평균입니다.",
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 4,
      "title": "HTTP 5xx 오류 비율 (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "((sum(rate(vertx_http_server_requests_total{route!~\"/health(/.*)?|/metrics\",service=\"preference\",job=~\"cowork-.*\",code=~\"5..\"}[$__rate_interval]))) or (0 * (sum(rate(vertx_http_server_requests_total{route!~\"/health(/.*)?|/metrics\",service=\"preference\",job=~\"cowork-.*\"}[$__rate_interval]))))) / ((sum(rate(vertx_http_server_requests_total{route!~\"/health(/.*)?|/metrics\",service=\"preference\",job=~\"cowork-.*\"}[$__rate_interval]))) > 0) * 100",
          "legendFormat": "5xx",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "noValue": "N/A",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" },
          "max": 100
        }
      },
      "description": "요청이 발생한 구간의 5xx 비율입니다. 요청이 없거나 메트릭이 없으면 N/A로 표시합니다.",
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 5,
      "title": "캐시 복구 대기 건수",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "sum(preference_cache_repair_pending{service=\"preference\"})",
          "legendFormat": "복구 대기",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "N/A",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        }
      },
      "description": "인스턴스마다 따로 쌓이는 캐시 복구 대기 건수를 합한 값입니다.",
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 6,
      "title": "초당 캐시 작업 실패 수",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "sum by (operation)(rate(preference_cache_failures_total{service=\"preference\"}[$__rate_interval]))",
          "legendFormat": "{{operation}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "min": 0, "noValue": "N/A", "color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never"} }
      },
      "options": { "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"} }
    },
    {
      "id": 7,
      "title": "캐시 회로 차단 상태",
      "type": "state-timeline",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "expr": "max(preference_cache_circuit_open{service=\"preference\"})",
          "legendFormat": "Redis 캐시",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "noValue": "N/A",
          "mappings": [{"type": "value", "options": {"0": {"text": "CLOSED", "color": "green"}, "1": {"text": "OPEN", "color": "red"}}}],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 1, "color": "red"}] },
          "custom": { "fillOpacity": 80, "lineWidth": 0 }
        }
      },
      "description": "CLOSED는 Redis 호출을 허용하고, OPEN은 연속 실패로 호출을 일시 중단한 상태입니다. 인스턴스 하나라도 OPEN이면 OPEN입니다.",
      "options": { "mergeValues": true, "rowHeight": 0.8, "showValue": "auto", "alignValue": "left", "legend": {"showLegend": false}, "tooltip": {"mode": "single", "sort": "none"} }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "label": "데이터 소스"
      }
    ]
  }
}
