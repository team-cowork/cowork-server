map $http_upgrade $cowork_connection_upgrade {
    default upgrade;
    '' close;
}

# Query parameters can carry the loopback / dev-signin credential.
log_format cowork_gateway '$remote_addr - $remote_user [$time_local] "$request_method $uri $server_protocol" '
                          '$status $body_bytes_sent "$http_user_agent"';

server {
    access_log /var/log/nginx/access.log cowork_gateway;
    listen {{ private_ip }}:8080;
    listen 127.0.0.1:8080;
    server_name _;
    server_tokens off;
    add_header X-Cowork-Gateway-Proxy 1 always;
    client_max_body_size 0;

    allow 10.0.0.117/32;
    allow 127.0.0.1/32;
    allow {{ private_ip }}/32;
    deny all;

    include /etc/cowork/gateway-upstream.conf;

    location = /internal/deployment-state { return 404; }

    location / {
        proxy_pass $cowork_gateway_target;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $cowork_connection_upgrade;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
