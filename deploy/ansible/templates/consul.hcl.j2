datacenter = "gsm"
node_name = "cowork-{{ inventory_hostname }}"
data_dir = "/var/lib/consul"
bind_addr = "{{ private_ip }}"
advertise_addr = "{{ private_ip }}"
client_addr = "127.0.0.1 {{ private_ip }}"
server = {{ (inventory_hostname in groups['control_plane']) | lower }}
{% if inventory_hostname in groups['control_plane'] %}
bootstrap_expect = 1
ui_config { enabled = true }
{% else %}
retry_join = ["{{ platform_control_ip }}"]
{% endif %}
encrypt = "{{ lookup('ansible.builtin.file', platform_state_dir ~ '/consul-gossip.key') | trim }}"
encrypt_verify_incoming = true
encrypt_verify_outgoing = true
ports {
  http = -1
  https = 8501
  grpc = -1
  grpc_tls = 8503
  dns = -1
}
connect { enabled = true }
acl {
  enabled = true
  default_policy = "deny"
  enable_token_persistence = true
  tokens {
{% if inventory_hostname in groups['control_plane'] %}
    initial_management = "{{ lookup('ansible.builtin.file', platform_state_dir ~ '/consul-bootstrap.token') | trim }}"
{% endif %}
{% set agent_token = lookup('ansible.builtin.file', platform_state_dir ~ '/tokens/' ~ inventory_hostname ~ '.consul', errors='ignore') %}
{% if agent_token %}
    agent = "{{ agent_token | trim }}"
{% endif %}
  }
}
tls {
  defaults {
    ca_file = "/etc/cowork/ca/ca.crt"
    cert_file = "/etc/cowork/tls/host.crt"
    key_file = "/etc/cowork/tls/host.key"
    tls_min_version = "TLSv1_2"
  }
  internal_rpc {
    verify_incoming = true
    verify_outgoing = true
    verify_server_hostname = true
  }
  https { verify_incoming = false }
  grpc { verify_incoming = false }
}
telemetry {
  # Retain hourly mesh CA expiry samples between emissions on servers.
  prometheus_retention_time = "{{ '2h' if inventory_hostname in groups['control_plane'] else '1m' }}"
  disable_hostname = true
}
