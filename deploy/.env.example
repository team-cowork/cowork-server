# 운영 서버(EC2)의 deploy/.env 예시. 실제 값은 서버에서만 관리한다.
ECR_REGISTRY=123456789012.dkr.ecr.ap-northeast-2.amazonaws.com
PUBLIC_BASE_URL=https://api.cowork.team
CORS_ALLOWED_ORIGINS=https://cowork.team

DB_URL=jdbc:mysql://cowork-prod.xxxxxxxx.ap-northeast-2.rds.amazonaws.com:3306/cowork?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=cowork
DB_PASSWORD=

JWT_SECRET=
DATAGSM_CLIENT_ID=
DATAGSM_TOKEN_URL=
DATAGSM_USERINFO_URL=

# S3는 EC2 인스턴스 역할로 인증하므로 액세스 키를 비워 둔다.
STORAGE_ENDPOINT=
STORAGE_BUCKET=cowork-prod-files
STORAGE_PATH_STYLE_ACCESS=false
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
