{
  "schema_version": 1,
  "service": "user",
  "kind": "application",
  "runtime": {
    "APP_CONFIG_PROFILE": "prod",
    "CONFIG_SERVER_URL": "http://10.0.0.169:8761",
    "EUREKA_SERVER_URL": "http://10.0.0.169:8761/eureka/",
    "KAFKA_BOOTSTRAP_SERVERS": "10.0.0.93:9094",
    "PUBLIC_API_BASE_URL": "https://cowork.https.gsmsv.site",
    "REDIS_HOST": "10.0.0.93",
    "REDIS_PORT": "6379",
    "S3_BUCKET": "cowork-bucket",
    "S3_INTERNAL_ENDPOINT": "http://10.0.0.93:9000",
    "S3_REGION": "us-east-1",
    "DB_HOST": "10.0.0.93",
    "DB_PORT": "3306",
    "DB_USERNAME": "cowork",
    "DB_NAME": "cowork_user"
  },
  "secrets": {
    "runtime": {
      "CONFIG_CLIENT_PASSWORD": {
        "key": "CONFIG_CLIENT_PASSWORD",
        "path": "control-plane/prod/user"
      },
      "CONFIG_CLIENT_USERNAME": {
        "key": "CONFIG_CLIENT_USERNAME",
        "path": "control-plane/prod/user"
      },
      "DB_PASSWORD": {
        "path": "slot-secrets/user",
        "key": "DB_PASSWORD"
      }
    }
  },
  "container": {
    "port": 8082,
    "host_port": 8082,
    "bind_address": "10.0.0.144",
    "advertise_address": "10.0.0.144",
    "readiness": {
      "path": "/actuator/health/readiness",
      "timeout_seconds": 900
    },
    "metrics_path": "/actuator/prometheus",
    "limits": {
      "memory": "1024m",
      "cpus": 2,
      "pids": 512
    },
    "stop_timeout_seconds": 30,
    "mounts": []
  },
  "peers": [
    "10.0.0.127/32",
    "10.0.0.137/32"
  ]
}
