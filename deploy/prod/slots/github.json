{
  "schema_version": 1,
  "service": "github",
  "kind": "application",
  "runtime": {
    "APP_CONFIG_PROFILE": "prod",
    "CONFIG_SERVER_URL": "http://10.0.0.144:8761",
    "EUREKA_SERVER_URL": "http://10.0.0.144:8761/eureka/",
    "KAFKA_BOOTSTRAP_SERVERS": "10.0.0.167:9094",
    "REDIS_HOST": "10.0.0.145",
    "REDIS_PORT": "6379"
  },
  "secrets": {
    "runtime": {
      "CONFIG_CLIENT_PASSWORD": {
        "key": "CONFIG_CLIENT_PASSWORD",
        "path": "control-plane/prod/github"
      },
      "CONFIG_CLIENT_USERNAME": {
        "key": "CONFIG_CLIENT_USERNAME",
        "path": "control-plane/prod/github"
      }
    }
  },
  "container": {
    "port": 8090,
    "host_port": 8090,
    "bind_address": "10.0.0.150",
    "advertise_address": "10.0.0.150",
    "readiness": {
      "path": "/health",
      "timeout_seconds": 420
    },
    "metrics_path": "/metrics",
    "limits": {
      "memory": "512m",
      "cpus": 1,
      "pids": 256
    },
    "stop_timeout_seconds": 30,
    "mounts": []
  },
  "peers": [
    "10.0.0.127/32",
    "10.0.0.88/32",
    "10.0.0.137/32"
  ]
}
