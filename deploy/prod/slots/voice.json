{
  "schema_version": 1,
  "service": "voice",
  "kind": "application",
  "runtime": {
    "APP_CONFIG_PROFILE": "prod",
    "CONFIG_SERVER_URL": "http://10.0.0.169:8761",
    "EUREKA_SERVER_URL": "http://10.0.0.169:8761/eureka/",
    "KAFKA_BOOTSTRAP_SERVERS": "10.0.0.167:9094",
    "LIVEKIT_URL": "http://10.0.0.172:7880",
    "LIVEKIT_WS_URL": "wss://cowork-livekit.https.gsmsv.site",
    "DB_HOST": "cowork-voice-db",
    "DB_PORT": "27017",
    "DB_USERNAME": "cowork_voice",
    "DB_NAME": "cowork_voice"
  },
  "secrets": {
    "runtime": {
      "CONFIG_CLIENT_PASSWORD": {
        "key": "CONFIG_CLIENT_PASSWORD",
        "path": "control-plane/prod/voice"
      },
      "CONFIG_CLIENT_USERNAME": {
        "key": "CONFIG_CLIENT_USERNAME",
        "path": "control-plane/prod/voice"
      },
      "LIVEKIT_API_KEY": {
        "path": "slot-secrets/voice",
        "key": "LIVEKIT_API_KEY"
      },
      "LIVEKIT_API_SECRET": {
        "path": "slot-secrets/voice",
        "key": "LIVEKIT_API_SECRET"
      },
      "DB_PASSWORD": {
        "path": "slot-secrets/voice",
        "key": "DB_PASSWORD"
      }
    }
  },
  "container": {
    "port": 8089,
    "host_port": 8089,
    "bind_address": "10.0.0.90",
    "advertise_address": "10.0.0.90",
    "readiness": {
      "path": "/health/ready",
      "timeout_seconds": 420
    },
    "metrics_path": "/metrics",
    "limits": {
      "memory": "1024m",
      "cpus": 2,
      "pids": 512
    },
    "stop_timeout_seconds": 30,
    "mounts": []
  },
  "peers": [
    "10.0.0.127/32",
    "10.0.0.137/32",
    "10.0.0.172/32"
  ]
}
