{
  "schema_version": 1,
  "service": "preference",
  "kind": "application",
  "runtime": {
    "APP_CONFIG_PROFILE": "prod",
    "CONFIG_SERVER_URL": "http://10.0.0.169:8761",
    "EUREKA_SERVER_URL": "http://10.0.0.169:8761/eureka/",
    "KAFKA_BOOTSTRAP_SERVERS": "10.0.0.93:9094",
    "REDIS_HOST": "10.0.0.93",
    "REDIS_PORT": "6379",
    "DB_HOST": "cowork-preference-db",
    "DB_PORT": "5432",
    "DB_USERNAME": "cowork_preference",
    "DB_NAME": "cowork_preference"
  },
  "secrets": {
    "runtime": {
      "CONFIG_CLIENT_PASSWORD": {
        "key": "CONFIG_CLIENT_PASSWORD",
        "path": "control-plane/prod/preference"
      },
      "CONFIG_CLIENT_USERNAME": {
        "key": "CONFIG_CLIENT_USERNAME",
        "path": "control-plane/prod/preference"
      },
      "DB_PASSWORD": {
        "path": "slot-secrets/preference",
        "key": "DB_PASSWORD"
      }
    }
  },
  "container": {
    "port": 9001,
    "host_port": 9001,
    "bind_address": "10.0.0.89",
    "advertise_address": "10.0.0.89",
    "readiness": {
      "path": "/health/ready",
      "timeout_seconds": 420
    },
    "metrics_path": "/metrics",
    "limits": {
      "memory": "2048m",
      "cpus": 2,
      "pids": 512
    },
    "stop_timeout_seconds": 30,
    "mounts": []
  },
  "peers": [
    "10.0.0.127/32",
    "10.0.0.137/32"
  ]
}
