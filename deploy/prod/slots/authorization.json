{
  "schema_version": 1,
  "service": "authorization",
  "kind": "application",
  "runtime": {
    "APP_CONFIG_PROFILE": "prod",
    "CONFIG_SERVER_URL": "http://10.0.0.169:8761",
    "EUREKA_SERVER_URL": "http://10.0.0.169:8761/eureka/",
    "JWT_ACCESS_EXPIRE": "30m",
    "JWT_REFRESH_EXPIRE": "2160h",
    "KAFKA_BOOTSTRAP_SERVERS": "10.0.0.93:9094",
    "DB_HOST": "cowork-authorization-db",
    "DB_PORT": "3306",
    "DB_USERNAME": "cowork_authorization",
    "DB_NAME": "cowork_authorization"
  },
  "secrets": {
    "runtime": {
      "CONFIG_CLIENT_PASSWORD": {
        "key": "CONFIG_CLIENT_PASSWORD",
        "path": "control-plane/prod/authorization"
      },
      "CONFIG_CLIENT_USERNAME": {
        "key": "CONFIG_CLIENT_USERNAME",
        "path": "control-plane/prod/authorization"
      },
      "DB_PASSWORD": {
        "path": "slot-secrets/authorization",
        "key": "DB_PASSWORD"
      }
    }
  },
  "container": {
    "port": 8081,
    "host_port": 8081,
    "bind_address": "10.0.0.140",
    "advertise_address": "10.0.0.140",
    "readiness": {
      "path": "/health",
      "timeout_seconds": 420
    },
    "metrics_path": "/metrics",
    "limits": {
      "memory": "1024m",
      "cpus": 2,
      "pids": 512
    },
    "stop_timeout_seconds": 30,
    "mounts": []
  },
  "peers": [
    "10.0.0.127/32",
    "10.0.0.137/32"
  ]
}
