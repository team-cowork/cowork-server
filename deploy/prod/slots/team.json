{
  "schema_version": 1,
  "service": "team",
  "kind": "application",
  "runtime": {
    "APP_CONFIG_PROFILE": "prod",
    "CONFIG_SERVER_URL": "http://10.0.0.144:8761",
    "EUREKA_SERVER_URL": "http://10.0.0.144:8761/eureka/",
    "KAFKA_BOOTSTRAP_SERVERS": "10.0.0.167:9094",
    "PUBLIC_API_BASE_URL": "https://cowork.https.gsmsv.site",
    "S3_BUCKET": "cowork-bucket",
    "S3_INTERNAL_ENDPOINT": "http://cowork-team-storage:9000",
    "S3_REGION": "us-east-1",
    "DB_HOST": "cowork-team-db",
    "DB_PORT": "3306",
    "DB_USERNAME": "cowork_team",
    "DB_NAME": "cowork_team"
  },
  "secrets": {
    "runtime": {
      "CONFIG_CLIENT_PASSWORD": {
        "key": "CONFIG_CLIENT_PASSWORD",
        "path": "control-plane/prod/team"
      },
      "CONFIG_CLIENT_USERNAME": {
        "key": "CONFIG_CLIENT_USERNAME",
        "path": "control-plane/prod/team"
      },
      "DB_PASSWORD": {
        "path": "slot-secrets/team",
        "key": "DB_PASSWORD"
      },
      "S3_ACCESS_KEY": {
        "path": "slot-secrets/team",
        "key": "S3_ACCESS_KEY"
      },
      "S3_SECRET_KEY": {
        "path": "slot-secrets/team",
        "key": "S3_SECRET_KEY"
      }
    }
  },
  "container": {
    "port": 8085,
    "host_port": 8085,
    "bind_address": "10.0.0.97",
    "advertise_address": "10.0.0.97",
    "readiness": {
      "path": "/actuator/health/readiness",
      "timeout_seconds": 420
    },
    "metrics_path": "/actuator/prometheus",
    "limits": {
      "memory": "2048m",
      "cpus": 2,
      "pids": 512
    },
    "stop_timeout_seconds": 30,
    "mounts": []
  },
  "peers": [
    "10.0.0.127/32",
    "10.0.0.137/32"
  ]
}
