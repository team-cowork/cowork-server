# Existing topology defaults. Override each endpoint independently in /etc/cowork/*.env.
# SSH routing belongs in inventory.json; these are service-to-service addresses.
INFRA_HOST=${INFRA_HOST:-10.0.0.93}
CONFIG_SERVER_URL=${CONFIG_SERVER_URL:-http://${INFRA_HOST}:8761}
EUREKA_SERVER_URL=${EUREKA_SERVER_URL:-${CONFIG_SERVER_URL%/}/eureka/}
KAFKA_BOOTSTRAP_SERVERS=${KAFKA_BOOTSTRAP_SERVERS:-${INFRA_HOST}:9094}
MYSQL_HOST=${MYSQL_HOST:-${INFRA_HOST}}
MYSQL_PORT=${MYSQL_PORT:-3306}
MYSQL_USER=${MYSQL_USER:-cowork}
POSTGRES_HOST=${POSTGRES_HOST:-${INFRA_HOST}}
POSTGRES_PORT=${POSTGRES_PORT:-5432}
POSTGRES_USER=${POSTGRES_USER:-root}
MONGO_HOST=${MONGO_HOST:-${INFRA_HOST}}
MONGO_PORT=${MONGO_PORT:-27017}
MONGO_USER=${MONGO_USER:-root}
REDIS_HOST=${REDIS_HOST:-${INFRA_HOST}}
REDIS_PORT=${REDIS_PORT:-6379}
ELASTICSEARCH_URL=${ELASTICSEARCH_URL:-http://${INFRA_HOST}:9200}
S3_INTERNAL_ENDPOINT=${S3_INTERNAL_ENDPOINT:-http://${INFRA_HOST}:9000}
S3_PUBLIC_ENDPOINT=${S3_PUBLIC_ENDPOINT:-http://ssh.gsmsv.site:22108}
S3_PUBLIC_BASE_URL=${S3_PUBLIC_BASE_URL:-${S3_PUBLIC_ENDPOINT}/cowork-bucket}
S3_BUCKET=${S3_BUCKET:-cowork-bucket}
LIVEKIT_URL=${LIVEKIT_URL:-http://${INFRA_HOST}:7880}
LIVEKIT_WS_URL=${LIVEKIT_WS_URL:-ws://141.164.42.34:7880}
GITHUB_APP_SERVICE_URL=${GITHUB_APP_SERVICE_URL:-http://10.0.0.150:3000/}
