# Copy as /etc/cowork/<service>.env on that service's VM. Overrides common.env.
# Assign the IP through which gateway/monitoring/other VMs can reach this VM.
ADVERTISE_IP=10.0.1.12
BIND_IP=10.0.1.12
# Override only when needed. project currently uses 8089 on host -> 8084 in container.
# HOST_PORT=8089
# Readiness budget includes projection catch-up; size the SSH command timeout for pull + rollback too.
# HEALTH_TIMEOUT_SECONDS=420
# Notification only; absolute path on the notification VM.
# FIREBASE_CREDENTIALS=/etc/cowork/secrets/firebase-credentials.json
# Config Server only: public URLs, Vault connection and token belong on its VM.
