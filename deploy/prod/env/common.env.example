# Copy to /etc/cowork/common.env (chmod 600). Trusted Bash assignments, not a Compose env file.
# CI image identity comes from DEPLOY_IMAGE_OWNER / DEPLOY_IMAGE_TAG.
# Existing inventory explicitly requests local; select prod once Config/Vault/public URLs are ready.
# APP_CONFIG_PROFILE=prod
CONFIG_SERVER_URL=http://config.internal:8761
EUREKA_SERVER_URL=http://config.internal:8761/eureka/
KAFKA_BOOTSTRAP_SERVERS=kafka.internal:9094
MYSQL_HOST=mysql.internal
POSTGRES_HOST=postgres.internal
MONGO_HOST=mongo.internal
REDIS_HOST=redis.internal
ELASTICSEARCH_URL=http://search.internal:9200
S3_INTERNAL_ENDPOINT=http://storage.internal:9000
S3_PUBLIC_ENDPOINT=https://storage.example.com
S3_PUBLIC_BASE_URL=https://storage.example.com/cowork-bucket
LIVEKIT_URL=http://media.internal:7880
LIVEKIT_WS_URL=wss://media.example.com
GITHUB_APP_SERVICE_URL=http://github-app.internal:3000/
PUBLIC_WEB_ORIGIN=https://cowork.example.com
PUBLIC_API_BASE_URL=https://api.cowork.example.com
# Secrets may arrive from CI or this restricted file. Only the service's own secrets are needed.
# COWORK_MYSQL_PASSWORD='...'
# COWORK_POSTGRES_PASSWORD='...'
# COWORK_MONGO_PASSWORD='...'
# JWT_SECRET='...'
# COWORK_GITHUB_APP_INTERNAL_API_KEY='...'
# LIVEKIT_API_KEY='...'
# LIVEKIT_API_SECRET='...'
# VAULT_EXTERNAL_HOST=vault.example.com
# VAULT_PORT=443
# VAULT_TOKEN='...'
# GHCR_READ_TOKEN='...'
