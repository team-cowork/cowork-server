# /etc/cowork/monitoring.env on the monitoring VM. No application images or Vault tokens required.
MONITORING_BIND_IP=10.0.1.30
MONITORING_ADMIN_BIND_IP=127.0.0.1
MONITORING_COMPOSE_PROJECT=cowork-monitoring
# Inspect the existing volumes first; preserve their data during the one-time project migration.
MONITORING_VOLUME_PREFIX=cowork-server
GRAFANA_ADMIN_PASSWORD=''
DISCORD_WEBHOOK_URL=''
MYSQL_EXPORTER_USER=root
MYSQL_EXPORTER_PASSWORD=''
KAFKA_EXPORTER_SERVER=kafka.internal:9094
POSTGRES_EXPORTER_DSN='postgresql://metrics:password@postgres.internal:5432/postgres?sslmode=disable'
MONGO_EXPORTER_URI='mongodb://metrics:password@mongo.internal:27017/admin'
