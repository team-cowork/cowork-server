# /etc/cowork/vault.env. External HTTPS reverse proxy must reach VAULT_BIND_IP:8200.
VAULT_EXTERNAL_HOST=vault.example.com
VAULT_BIND_IP=10.0.1.20
# Confirm with docker inspect cowork-vault-prod before setting this value.
# The old ops/vault project normally used vault_vault-data.
VAULT_DATA_VOLUME=vault_vault-data
VAULT_COMPOSE_PROJECT=vault
# VAULT_UNSEAL_KEY='...'
