local.file_match "docker_logs" {
  path_targets = [{
    "__path__" = "/var/lib/docker/containers/*/*-json.log",
    "env"      = "prod",
    "host"     = sys.env("LOG_HOST"),
  }]
}

loki.source.file "docker_logs" {
  targets    = local.file_match.docker_logs.targets
  forward_to = [loki.process.docker_logs.receiver]
}

loki.process "docker_logs" {
  stage.docker {}
  stage.json {
    expressions = { level = "level", service = "service", timestamp = "\"@timestamp\"" }
  }
  stage.labels {
    values = { level = "", service = "" }
  }
  // 앱이 기록한 시각을 쓴다. 없으면(plain text 등) Docker 기록 시각을 그대로 둔다.
  stage.timestamp {
    source            = "timestamp"
    format            = "RFC3339Nano"
    action_on_failure = "skip"
  }
  forward_to = [loki.write.central.receiver]
}

loki.write "central" {
  endpoint {
    url = sys.env("LOKI_PUSH_URL")
  }
}
