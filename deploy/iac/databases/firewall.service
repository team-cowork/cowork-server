[Unit]
Description=Restore cowork module database ingress before Docker
Before=docker.service
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 -I /usr/local/libexec/cowork-module-database-firewall.py restore
ExecReload=/usr/bin/python3 -I /usr/local/libexec/cowork-module-database-firewall.py restore
TimeoutStartSec=90

[Install]
RequiredBy=docker.service
