[Unit]
Description=Restore cowork dedicated service ingress before Docker
Before=docker.service
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 -I /usr/local/libexec/cowork-shared-firewall.py restore
ExecReload=/usr/bin/python3 -I /usr/local/libexec/cowork-shared-firewall.py restore
TimeoutStartSec=90

[Install]
RequiredBy=docker.service
