{
  "mount": "github-actions",
  "config": {
    "oidc_discovery_url": "https://token.actions.githubusercontent.com",
    "bound_issuer": "https://token.actions.githubusercontent.com"
  },
  "role_name": "prod-iac",
  "role": {
    "role_type": "jwt",
    "user_claim": "repository_id",
    "bound_audiences": ["https://cowork-vault.https.gsmsv.site"],
    "bound_subject": "repo:team-cowork/cowork-server:environment:Prod-IaC",
    "bound_claims": {
      "repository_id": "1208653612",
      "ref": "refs/heads/main"
    },
    "token_policies": ["cowork-iac-read"],
    "token_no_default_policy": true,
    "token_ttl": 1200,
    "token_max_ttl": 1200
  },
  "policies": {
    "cowork-iac-read": {
      "secret/data/iac/hosts": ["read"],
      "secret/data/deploy/monitoring": ["read"],
      "secret/data/slot-secrets/monitoring": ["read"]
    }
  }
}
