      }
    },
    "/preferences/project/{projectId}/roles/{roleName}/members": {
      "post": {
        "tags": ["project-role"],
        "summary": "멤버에게 역할 부여",
        "description": "프로젝트 생성자 또는 프로젝트가 속한 팀의 OWNER·ADMIN이 역할을 관리할 수 있습니다. 부여 대상도 해당 팀 멤버여야 합니다.",
        "parameters": [
