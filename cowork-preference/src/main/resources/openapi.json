{
  "openapi": "3.0.3",
  "info": {
    "title": "cowork Preference API",
    "description": "구성 가능한 설정 서비스 — 계정/팀/프로젝트/채널 설정과 프로젝트 역할 관리",
    "version": "20260719.0"
  },
  "servers": [
    { "url": "/api/preference", "description": "Gateway" }
  ],
  "security": [{ "BearerAuth": [] }],
  "tags": [
    { "name": "preference", "description": "리소스별 설정 조회/수정" },
    { "name": "project-role", "description": "프로젝트 역할 관리" },
    { "name": "notification", "description": "채널 알림 설정" }
  ],
  "paths": {
      "/channels/{channelId}/webhooks": {
        "servers": [
          {
            "url": "/api/channel",
            "description": "기존 Channel 관리 URL을 Preference로 라우팅"
          }
        ],
        "get": {
          "tags": [
            "webhook"
          ],
          "summary": "웹훅 목록 조회",
          "parameters": [
            {
              "name": "channelId",
              "in": "path",
              "required": true,
              "schema": {
                "type": "integer",
                "format": "int64",
                "minimum": 1
              }
            }
          ],
          "responses": {
            "200": {
              "description": "관리 가능한 웹훅 목록. token은 항상 null입니다.",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Webhook"
                    }
                  }
                }
              }
            },
            "400": {
              "description": "잘못된 입력"
            },
            "403": {
              "description": "channel_manage 권한 없음"
            },
            "404": {
              "description": "채널 또는 웹훅 없음"
            },
            "503": {
              "description": "마이그레이션 또는 projection 준비 중"
            }
          }
        },
        "post": {
          "tags": [
            "webhook"
          ],
          "summary": "웹훅 생성",
          "parameters": [
            {
              "name": "channelId",
              "in": "path",
              "required": true,
              "schema": {
                "type": "integer",
                "format": "int64",
                "minimum": 1
              }
            },
            {
              "name": "Idempotency-Key",
              "in": "header",
              "required": true,
              "schema": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "description": "요청자별 고유 키. 같은 요청의 결과를 재생하며 비밀키는 발급 후 24시간 미만에만 다시 반환합니다. 이후 token은 null이고 요청 기록은 유지됩니다. 다른 요청에 재사용하거나 저장된 실행 ID가 재발급·삭제로 폐기되었으면 409입니다."
            }
          ],
          "responses": {
            "201": {
              "description": "성공. GET/PATCH에서는 token이 항상 null입니다.",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Webhook"
                  }
                }
              }
            },
            "400": {
              "description": "잘못된 입력"
            },
            "403": {
              "description": "channel_manage 권한 없음"
            },
            "404": {
              "description": "채널 또는 웹훅 없음"
            },
            "409": {
              "description": "Idempotency-Key 재사용 또는 재발급·삭제로 폐기된 요청 결과"
            },
            "503": {
              "description": "마이그레이션 또는 projection 준비 중"
            }
          },
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "avatarUrl": {
                      "type": "string",
                      "nullable": true,
                      "maxLength": 512
                    },
                    "isActive": {
                      "type": "boolean",
                      "default": true
                    },
                    "isSecure": {
                      "type": "boolean",
                      "default": false
                    }
                  }
                }
              }
            }
          },
          "description": "수신 요청에는 서명을 포함한 executionPath를 그대로 사용하고 관리 URL에는 숫자 id를 사용합니다. executionId만 포함한 서명 없는 URL은 지원하지 않습니다. 공개 모드는 별도 비밀키가 없으며 보안 모드는 발급된 token을 X-Webhook-Secret 헤더로 전달합니다. token 원문은 생성 또는 실제 보안 모드 전환 성공 응답과 발급 후 24시간 미만의 동일 요청 재생에서만 반환됩니다."
        }
      },
      "/channels/{channelId}/webhooks/{webhookId}": {
        "servers": [
          {
            "url": "/api/channel"
          }
        ],
        "patch": {
          "tags": [
            "webhook"
          ],
          "summary": "웹훅 이름·아바타·활성 상태 수정",
          "parameters": [
            {
              "name": "channelId",
              "in": "path",
              "required": true,
              "schema": {
                "type": "integer",
                "format": "int64",
                "minimum": 1
              }
            },
            {
              "name": "webhookId",
              "in": "path",
              "required": true,
              "schema": {
                "type": "integer",
                "format": "int64",
                "minimum": 1
              }
            }
          ],
          "responses": {
            "200": {
              "description": "성공. GET/PATCH에서는 token이 항상 null입니다.",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Webhook"
                  }
                }
              }
            },
            "400": {
              "description": "잘못된 입력"
            },
            "403": {
              "description": "channel_manage 권한 없음"
            },
            "404": {
              "description": "채널 또는 웹훅 없음"
            },
            "503": {
              "description": "마이그레이션 또는 projection 준비 중"
            }
          },
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "avatarUrl": {
                      "type": "string",
                      "nullable": true,
                      "maxLength": 512
                    },
                    "isActive": {
                      "type": "boolean",
                      "default": true
                    }
                  }
                }
              }
            }
          },
          "description": "isSecure 키를 포함하면 null이어도 400입니다. avatarUrl:null은 아바타를 제거합니다."
        },
        "delete": {
          "tags": [
            "webhook"
          ],
          "summary": "웹훅 삭제",
          "parameters": [
            {
              "name": "channelId",
              "in": "path",
              "required": true,
              "schema": {
                "type": "integer",
                "format": "int64",
                "minimum": 1
              }
            },
            {
              "name": "webhookId",
              "in": "path",
              "required": true,
              "schema": {
                "type": "integer",
                "format": "int64",
                "minimum": 1
              }
            }
          ],
          "responses": {
            "204": {
              "description": "삭제 완료"
            },
            "400": {
              "description": "잘못된 입력"
            },
            "403": {
              "description": "channel_manage 권한 없음"
            },
            "404": {
              "description": "채널 또는 웹훅 없음"
            },
            "503": {
              "description": "마이그레이션 또는 projection 준비 중"
            }
          }
        }
      },
      "/channels/{channelId}/webhooks/{webhookId}/security-mode": {
        "servers": [
          {
            "url": "/api/channel"
          }
        ],
        "put": {
          "tags": [
            "webhook"
          ],
          "summary": "웹훅 보안 모드 변경",
          "parameters": [
            {
              "name": "channelId",
              "in": "path",
              "required": true,
              "schema": {
                "type": "integer",
                "format": "int64",
                "minimum": 1
              }
            },
            {
              "name": "webhookId",
              "in": "path",
              "required": true,
              "schema": {
                "type": "integer",
                "format": "int64",
                "minimum": 1
              }
            },
            {
              "name": "Idempotency-Key",
              "in": "header",
              "required": true,
              "schema": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "description": "요청자별 고유 키. 같은 요청의 결과를 재생하며 비밀키는 발급 후 24시간 미만에만 다시 반환합니다. 이후 token은 null이고 요청 기록은 유지됩니다. 다른 요청에 재사용하거나 저장된 실행 ID가 재발급·삭제로 폐기되었으면 409입니다."
            }
          ],
          "responses": {
            "200": {
              "description": "성공. GET/PATCH에서는 token이 항상 null입니다.",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Webhook"
                  }
                }
              }
            },
            "400": {
              "description": "잘못된 입력"
            },
            "403": {
              "description": "channel_manage 권한 없음"
            },
            "404": {
              "description": "채널 또는 웹훅 없음"
            },
            "409": {
              "description": "Idempotency-Key 재사용 또는 재발급·삭제로 폐기된 요청 결과"
            },
            "503": {
              "description": "마이그레이션 또는 projection 준비 중"
            },
            "429": {
              "description": "보안 모드 변경 간격 제한. data.reason=MODE_CHANGE_COOLDOWN, data.nextAllowedAt=ISO datetime, data.retryAfterSeconds=남은 초.",
              "headers": {
                "Retry-After": {
                  "schema": {
                    "type": "integer"
                  },
                  "description": "다음 새 변경 요청까지 남은 초"
                }
              }
            }
          },
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "isSecure"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "isSecure": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "description": "channel_manage가 필요합니다. 최초 전환은 즉시 가능하며 실제 모드 변경 사이에는 30초가 필요합니다. 같은 모드 요청은 비밀키나 제한 시간을 바꾸지 않습니다. 제한에 거절된 Idempotency-Key는 이후에도 같은 거절을 재생하므로 새 요청에는 새 키가 필요합니다."
        }
      },
      "/channels/{channelId}/webhooks/{webhookId}/execution-id": {
        "servers": [
          {
            "url": "/api/channel"
          }
        ],
        "post": {
          "tags": [
            "webhook"
          ],
          "summary": "웹훅 실행 ID 재발급",
          "parameters": [
            {
              "name": "channelId",
              "in": "path",
              "required": true,
              "schema": {
                "type": "integer",
                "format": "int64",
                "minimum": 1
              }
            },
            {
              "name": "webhookId",
              "in": "path",
              "required": true,
              "schema": {
                "type": "integer",
                "format": "int64",
                "minimum": 1
              }
            },
            {
              "name": "Idempotency-Key",
              "in": "header",
              "required": true,
              "schema": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "description": "요청자별 고유 키. 같은 요청은 같은 실행 ID를 재생하고 다시 발급하지 않습니다. 다른 요청에 재사용하거나 이전 결과가 폐기되었으면 409입니다."
            }
          ],
          "responses": {
            "200": {
              "description": "새 실행 ID를 포함한 웹훅입니다. token은 항상 null입니다.",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Webhook"
                  }
                }
              }
            },
            "400": {
              "description": "잘못된 입력"
            },
            "403": {
              "description": "channel_manage 권한 없음"
            },
            "404": {
              "description": "채널 또는 웹훅 없음"
            },
            "409": {
              "description": "Idempotency-Key 재사용 또는 재발급·삭제로 폐기된 요청 결과"
            },
            "503": {
              "description": "마이그레이션 또는 projection 준비 중"
            }
          },
          "description": "channel_manage 권한과 Idempotency-Key가 필요하며 요청 본문은 없습니다. 숫자 id, 이름·설정, 보안 비밀키와 보안 모드 변경 제한 시간을 유지하고 실행 ID와 이에 대응하는 서명 경로를 재발급합니다. 별도 재발급 cooldown은 없습니다. 같은 키로 재시도하면 다시 발급하지 않으며, 이후 재발급 또는 삭제로 해당 결과가 폐기되었으면 409입니다. 이전 URL은 Kafka 상태가 Chat에 반영된 뒤 무효화되며 반영 전에 시작한 요청은 완료될 수 있습니다."
        }
      },
    "/preferences/account/{id}": {
      "get": {
        "tags": ["preference"],
        "summary": "계정 설정 조회",
        "description": "본인 계정만 조회할 수 있으며 전역 ADMIN도 타인 계정에는 접근할 수 없습니다.",
        "parameters": [{ "$ref": "#/components/parameters/ResourceId" }],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccountSettings" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "put": {
        "tags": ["preference"],
        "summary": "계정 설정 수정",
        "description": "본인 계정만 수정할 수 있으며 전역 ADMIN도 타인 계정에는 접근할 수 없습니다.",
        "parameters": [{ "$ref": "#/components/parameters/ResourceId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccountSettings" } } } },
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccountSettings" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/preferences/team/{id}": {
      "get": {
        "tags": ["preference"],
        "summary": "팀 설정 조회",
        "parameters": [{ "$ref": "#/components/parameters/ResourceId" }],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TeamSettings" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "put": {
        "tags": ["preference"],
        "summary": "팀 설정 수정",
        "description": "팀 OWNER·ADMIN이 수정할 수 있습니다. 닉네임 형식 키만 바꾸는 요청은 manage_nickname_format 권한이 있는 역할 보유자도 수정할 수 있습니다.",
        "parameters": [{ "$ref": "#/components/parameters/ResourceId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TeamSettings" } } } },
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TeamSettings" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/preferences/project/{id}": {
      "get": {
        "tags": ["preference"],
        "summary": "프로젝트 설정 조회",
        "description": "팀 멤버 중 프로젝트 read 권한이 있는 사용자, 프로젝트 생성자 또는 팀 OWNER·ADMIN이 조회할 수 있습니다.",
        "parameters": [{ "$ref": "#/components/parameters/ResourceId" }],
        "responses": {
