{
  "openapi": "3.0.3",
  "info": {
    "title": "cowork Preference API",
    "description": "구성 가능한 설정 서비스 — 계정/팀/프로젝트/채널 설정과 프로젝트 역할 관리",
    "version": "20260719.0"
  },
  "servers": [
    { "url": "/api/preference", "description": "Gateway" }
  ],
  "security": [{ "BearerAuth": [] }],
  "tags": [
    { "name": "preference", "description": "리소스별 설정 조회/수정" },
    { "name": "project-role", "description": "프로젝트 역할 관리" },
    { "name": "notification", "description": "채널 알림 설정" }
  ],
  "paths": {
    "/preferences/account/{id}": {
      "get": {
        "tags": ["preference"],
        "summary": "계정 설정 조회",
        "description": "본인 계정만 조회할 수 있으며 전역 ADMIN도 타인 계정에는 접근할 수 없습니다.",
        "parameters": [{ "$ref": "#/components/parameters/ResourceId" }],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccountSettings" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "put": {
        "tags": ["preference"],
        "summary": "계정 설정 수정",
        "description": "본인 계정만 수정할 수 있으며 전역 ADMIN도 타인 계정에는 접근할 수 없습니다.",
        "parameters": [{ "$ref": "#/components/parameters/ResourceId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccountSettings" } } } },
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccountSettings" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/preferences/team/{id}": {
      "get": {
        "tags": ["preference"],
        "summary": "팀 설정 조회",
        "parameters": [{ "$ref": "#/components/parameters/ResourceId" }],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TeamSettings" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "put": {
        "tags": ["preference"],
        "summary": "팀 설정 수정",
        "parameters": [{ "$ref": "#/components/parameters/ResourceId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TeamSettings" } } } },
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TeamSettings" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/preferences/project/{id}": {
      "get": {
        "tags": ["preference"],
        "summary": "프로젝트 설정 조회",
        "description": "팀 멤버 중 프로젝트 read 권한이 있는 사용자, 프로젝트 생성자 또는 팀 OWNER·ADMIN이 조회할 수 있습니다.",
        "parameters": [{ "$ref": "#/components/parameters/ResourceId" }],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "object" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "put": {
        "tags": ["preference"],
        "summary": "프로젝트 설정 수정",
        "description": "프로젝트 생성자 또는 프로젝트가 속한 팀의 OWNER·ADMIN이 수정할 수 있습니다. 팀 멤버 자격이 필요합니다.",
        "parameters": [{ "$ref": "#/components/parameters/ResourceId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "object" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/preferences/voice-channel/{id}": {
      "get": {
        "tags": ["preference"],
        "summary": "음성 채널 설정 조회",
        "description": "팀 채널은 팀 멤버 자격과 역할 권한으로 조회를 허용합니다. 텍스트는 message_read, 음성은 voice_connect를 사용합니다. DM은 대화 참여자만 조회할 수 있습니다.",
        "parameters": [{ "$ref": "#/components/parameters/ResourceId" }],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VoiceChannelSettings" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "put": {
        "tags": ["preference"],
        "summary": "음성 채널 설정 수정",
        "description": "채널이 속한 팀의 OWNER·ADMIN만 수정할 수 있습니다.",
        "parameters": [{ "$ref": "#/components/parameters/ResourceId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VoiceChannelSettings" } } } },
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VoiceChannelSettings" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/preferences/text-channel/{id}": {
      "get": {
        "tags": ["preference"],
        "summary": "텍스트 채널 설정 조회",
        "description": "팀 채널은 팀 멤버 자격과 역할 권한으로 조회를 허용합니다. 텍스트는 message_read, 음성은 voice_connect를 사용합니다. DM은 대화 참여자만 조회할 수 있습니다.",
        "parameters": [{ "$ref": "#/components/parameters/ResourceId" }],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TextChannelSettings" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "put": {
        "tags": ["preference"],
        "summary": "텍스트 채널 설정 수정",
        "description": "채널이 속한 팀의 OWNER·ADMIN만 수정할 수 있습니다.",
        "parameters": [{ "$ref": "#/components/parameters/ResourceId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TextChannelSettings" } } } },
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TextChannelSettings" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/preferences/project/{projectId}/roles": {
      "get": {
        "tags": ["project-role"],
        "summary": "프로젝트 역할 목록 조회",
        "description": "팀 멤버 중 프로젝트 read 권한이 있는 사용자, 프로젝트 생성자 또는 팀 OWNER·ADMIN이 조회할 수 있습니다.",
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ProjectRole" } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "post": {
        "tags": ["project-role"],
        "summary": "프로젝트 역할 생성",
        "description": "프로젝트 생성자 또는 프로젝트가 속한 팀의 OWNER·ADMIN이 역할을 관리할 수 있습니다. 부여 대상도 해당 팀 멤버여야 합니다.",
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateRoleRequest" } } } },
        "responses": {
          "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProjectRole" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "description": "역할 이름 중복", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/preferences/project/{projectId}/roles/{roleName}": {
      "delete": {
        "tags": ["project-role"],
        "summary": "프로젝트 역할 삭제",
        "description": "프로젝트 생성자 또는 프로젝트가 속한 팀의 OWNER·ADMIN이 역할을 관리할 수 있습니다. 부여 대상도 해당 팀 멤버여야 합니다.",
        "parameters": [
          { "$ref": "#/components/parameters/ProjectId" },
          { "$ref": "#/components/parameters/RoleName" }
        ],
        "responses": {
          "204": { "description": "삭제 성공" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/preferences/project/{projectId}/roles/members": {
      "get": {
        "tags": ["project-role"],
        "summary": "프로젝트 멤버 역할 목록 조회",
        "description": "팀 멤버 중 프로젝트 read 권한이 있는 사용자, 프로젝트 생성자 또는 팀 OWNER·ADMIN이 조회할 수 있습니다.",
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/MemberRole" } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/preferences/project/{projectId}/roles/{roleName}/members": {
      "post": {
        "tags": ["project-role"],
        "summary": "멤버에게 역할 부여",
        "description": "프로젝트 생성자 또는 프로젝트가 속한 팀의 OWNER·ADMIN이 역할을 관리할 수 있습니다. 부여 대상도 해당 팀 멤버여야 합니다.",
        "parameters": [
          { "$ref": "#/components/parameters/ProjectId" },
          { "$ref": "#/components/parameters/RoleName" }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AssignRoleRequest" } } } },
        "responses": {
          "204": { "description": "부여 성공" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/preferences/project/{projectId}/roles/{roleName}/members/{accountId}": {
      "delete": {
        "tags": ["project-role"],
        "summary": "멤버 역할 제거",
        "description": "프로젝트 생성자 또는 프로젝트가 속한 팀의 OWNER·ADMIN이 역할을 관리할 수 있습니다. 부여 대상도 해당 팀 멤버여야 합니다.",
        "parameters": [
          { "$ref": "#/components/parameters/ProjectId" },
          { "$ref": "#/components/parameters/RoleName" },
          { "name": "accountId", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" }, "description": "계정 ID" }
        ],
        "responses": {
          "204": { "description": "제거 성공" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/preferences/account/{accountId}/channels/{channelId}/notification": {
      "get": {
        "tags": ["notification"],
        "summary": "채널 알림 설정 조회",
        "description": "본인 계정이 채널 설정 조회와 같은 채널 접근 권한을 가져야 조회할 수 있으며 전역 ADMIN도 타인 계정에는 접근할 수 없습니다.",
        "parameters": [
          { "name": "accountId", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" }, "description": "계정 ID" },
          { "name": "channelId", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" }, "description": "채널 ID" }
        ],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NotificationSettings" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "put": {
        "tags": ["notification"],
        "summary": "채널 알림 설정 수정",
        "description": "본인 계정이 채널 설정 조회와 같은 채널 접근 권한을 가져야 수정할 수 있으며 전역 ADMIN도 타인 계정에는 접근할 수 없습니다.",
        "parameters": [
          { "name": "accountId", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" }, "description": "계정 ID" },
          { "name": "channelId", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" }, "description": "채널 ID" }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NotificationSettings" } } } },
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NotificationSettings" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Bearer {access_token} 형식으로 Gateway에 전달하세요. downstream 서비스는 Gateway가 주입한 사용자 헤더를 신뢰합니다."
      }
    },
    "parameters": {
      "ResourceId": {
        "name": "id", "in": "path", "required": true,
        "schema": { "type": "integer", "format": "int64" },
        "description": "리소스 ID"
      },
      "ProjectId": {
        "name": "projectId", "in": "path", "required": true,
        "schema": { "type": "integer", "format": "int64" },
        "description": "프로젝트 ID"
      },
      "TeamId": {
        "name": "teamId", "in": "path", "required": true,
        "schema": { "type": "integer", "format": "int64" },
        "description": "팀 ID"
      },
      "AccountId": {
        "name": "accountId", "in": "path", "required": true,
        "schema": { "type": "integer", "format": "int64" },
        "description": "계정 ID"
      },
      "RoleName": {
        "name": "roleName", "in": "path", "required": true,
        "schema": { "type": "string" },
        "description": "역할 이름"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "잘못된 요청",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "Forbidden": {
        "description": "접근 권한 없음",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "NotFound": {
        "description": "리소스 없음",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "ServiceUnavailable": {
        "description": "권한 판단에 필요한 projection이 아직 준비되지 않음",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "InternalServerError": {
        "description": "서버 오류",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "example": "Internal server error" }
        }
      },
      "AccountSettings": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["ONLINE", "DO_NOT_DISTURB"], "example": "ONLINE" },
          "status_expires_at": { "type": "string", "format": "date-time", "example": "2026-04-20T12:00:00Z" },
          "marketing_email": { "type": "boolean", "example": true },
          "theme": { "type": "string", "enum": ["WHITE", "BLACK"], "example": "BLACK" },
          "language": { "type": "string", "enum": ["KO", "EN"], "example": "KO" },
          "time_format": { "type": "string", "enum": ["12H", "24H"], "example": "24H" },
          "date_format": { "type": "string", "enum": ["YYYY_MM_DD", "MM_DD_YYYY", "DD_MM_YYYY", "YYYY_DD_MM", "DD_YYYY_MM", "MM_YYYY_DD"], "example": "YYYY_MM_DD" },
          "timezone": { "type": "string", "description": "IANA 시간대", "example": "Asia/Seoul" },
          "notification_level": { "type": "string", "enum": ["ALL", "MENTIONS", "NONE"], "description": "계정 기본 알림 수준", "example": "ALL" },
          "dnd_schedule": { "$ref": "#/components/schemas/DndSchedule" },
          "message_display": { "type": "string", "enum": ["COZY", "COMPACT"], "example": "COZY" },
          "enter_to_send": { "type": "boolean", "description": "Enter 키로 메시지 전송 여부", "example": true }
        }
      },
      "DndSchedule": {
        "type": "object",
        "description": "방해 금지 예약. 객체 전체를 교체하며 start/end는 timezone 기준이고 end가 start보다 이르면 자정을 넘깁니다.",
        "required": ["enabled", "start", "end"],
        "properties": {
          "enabled": { "type": "boolean", "example": true },
          "start": { "type": "string", "pattern": "^\\d{2}:\\d{2}$", "example": "22:00" },
          "end": { "type": "string", "pattern": "^\\d{2}:\\d{2}$", "example": "08:00" }
        }
      },
      "TeamSettings": {
        "type": "object",
        "properties": {
          "tag_spam_block": { "type": "boolean", "example": false },
          "nickname_format_enforced": { "type": "boolean", "example": true },
          "nickname_format_example": { "type": "string", "minLength": 1, "example": "홍길동 / 프론트엔드" },
          "default_notification_level": { "type": "string", "enum": ["ALL", "MENTIONS", "NONE"], "description": "팀 채널의 기본 알림 수준", "example": "MENTIONS" }
        }
      },
      "VoiceChannelSettings": {
        "type": "object",
        "properties": {
          "bitrate": { "type": "integer", "example": 64000 },
          "max_participants": { "type": "integer", "example": 20 }
        }
      },
      "WebhookSettings": {
        "type": "object",
        "properties": {
          "is_active": { "type": "boolean", "example": true },
          "secret_key": { "type": "string", "example": "secret-abc" },
          "retry_count": { "type": "integer", "example": 3 },
          "retry_interval_ms": { "type": "integer", "example": 1000 }
        }
      },
      "TextChannelSettings": {
        "type": "object",
        "properties": {
          "webhook": { "$ref": "#/components/schemas/WebhookSettings" },
          "slowmode_seconds": { "type": "integer", "minimum": 0, "maximum": 21600, "description": "사용자별 메시지 전송 간격(초). 0은 해제", "example": 0 }
        }
      },
      "ProjectRole": {
        "type": "object",
        "properties": {
          "roleName": { "type": "string", "example": "DEVELOPER" },
          "priority": { "type": "integer", "default": 0, "description": "높은 값이 우선하며, 같은 우선순위의 충돌은 거부합니다." },
          "permissions": { "type": "object", "additionalProperties": { "type": "boolean" }, "description": "read와 write는 별도 권한이며 누락하면 false입니다.", "example": { "read": true, "write": false } }
        }
      },
      "CreateRoleRequest": {
        "type": "object",
        "required": ["roleName"],
        "properties": {
          "roleName": { "type": "string", "example": "DEVELOPER" },
          "priority": { "type": "integer", "default": 0, "description": "높은 값이 우선하며, 같은 우선순위의 충돌은 거부합니다." },
          "permissions": { "type": "object", "additionalProperties": { "type": "boolean" }, "description": "read와 write는 별도 권한이며 누락하면 false입니다.", "example": { "read": true, "write": false } }
        }
      },
      "MemberRole": {
        "type": "object",
        "properties": {
          "accountId": { "type": "integer", "format": "int64", "example": 1 },
          "roleName": { "type": "string", "example": "DEVELOPER" }
        }
      },
      "AssignRoleRequest": {
        "type": "object",
        "required": ["accountId"],
        "properties": {
          "accountId": { "type": "integer", "format": "int64", "example": 1 }
        }
      },
      "NotificationSettings": {
        "type": "object",
        "properties": {
          "notification": { "type": "boolean", "default": true, "description": "하위 호환 값. notification_level이 NONE이 아니면 true이며 요청에 notification_level이 있으면 무시됩니다.", "example": true },
          "notification_level": { "type": "string", "enum": ["ALL", "MENTIONS", "NONE"], "default": "ALL", "example": "MENTIONS" },
          "muted_until": { "type": "string", "format": "date-time", "nullable": true, "description": "이 시각까지 채널 알림을 음소거합니다. null이면 음소거하지 않습니다.", "example": "2026-04-20T12:00:00Z" }
        }
      }
    }
  }
}
