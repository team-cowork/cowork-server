        "responses": {
          "204": { "description": "부여 성공" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/preferences/project/{projectId}/roles/{roleName}/members/{accountId}": {
      "delete": {
        "tags": ["project-role"],
        "summary": "멤버 역할 제거",
        "description": "프로젝트 생성자 또는 프로젝트가 속한 팀의 OWNER·ADMIN이 역할을 관리할 수 있습니다. 부여 대상도 해당 팀 멤버여야 합니다.",
        "parameters": [
          { "$ref": "#/components/parameters/ProjectId" },
          { "$ref": "#/components/parameters/RoleName" },
          { "name": "accountId", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" }, "description": "계정 ID" }
        ],
        "responses": {
          "204": { "description": "제거 성공" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/preferences/account/{accountId}/channels/{channelId}/notification": {
      "get": {
        "tags": ["notification"],
        "summary": "채널 알림 설정 조회",
        "description": "본인 계정이 채널 설정 조회와 같은 채널 접근 권한을 가져야 조회할 수 있으며 전역 ADMIN도 타인 계정에는 접근할 수 없습니다.",
        "parameters": [
          { "name": "accountId", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" }, "description": "계정 ID" },
          { "name": "channelId", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" }, "description": "채널 ID" }
        ],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NotificationSettings" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "put": {
        "tags": ["notification"],
        "summary": "채널 알림 설정 수정",
        "description": "본인 계정이 채널 설정 조회와 같은 채널 접근 권한을 가져야 수정할 수 있으며 전역 ADMIN도 타인 계정에는 접근할 수 없습니다.",
        "parameters": [
          { "name": "accountId", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" }, "description": "계정 ID" },
          { "name": "channelId", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" }, "description": "채널 ID" }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NotificationSettings" } } } },
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NotificationSettings" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Bearer {access_token} 형식으로 Gateway에 전달하세요. downstream 서비스는 Gateway가 주입한 사용자 헤더를 신뢰합니다."
      }
    },
    "parameters": {
      "ResourceId": {
        "name": "id", "in": "path", "required": true,
        "schema": { "type": "integer", "format": "int64" },
        "description": "리소스 ID"
      },
      "ProjectId": {
        "name": "projectId", "in": "path", "required": true,
        "schema": { "type": "integer", "format": "int64" },
        "description": "프로젝트 ID"
      },
      "TeamId": {
        "name": "teamId", "in": "path", "required": true,
        "schema": { "type": "integer", "format": "int64" },
        "description": "팀 ID"
      },
      "AccountId": {
        "name": "accountId", "in": "path", "required": true,
        "schema": { "type": "integer", "format": "int64" },
        "description": "계정 ID"
      },
      "RoleName": {
        "name": "roleName", "in": "path", "required": true,
        "schema": { "type": "string" },
        "description": "역할 이름"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "잘못된 요청",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "Forbidden": {
        "description": "접근 권한 없음",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "NotFound": {
        "description": "리소스 없음",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "ServiceUnavailable": {
        "description": "권한 판단에 필요한 projection이 아직 준비되지 않음",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "InternalServerError": {
        "description": "서버 오류",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      }
    },
    "schemas": {
        "Webhook": {
          "type": "object",
          "required": ["id", "executionId", "executionPath", "channelId", "name", "isActive", "isSecure", "createdBy", "createdAt", "updatedAt"],
          "properties": {
            "id": {
              "type": "integer",
              "format": "int64"
            },
            "executionPath": {
              "type": "string",
              "readOnly": true,
              "description": "그대로 호출할 서명된 Gateway 상대 경로입니다: /api/chat/chat/webhooks/{executionId}/{signature}/messages. signature는 독립 공유키로 HMAC-SHA256 서명한 64자리 소문자 hex입니다. 서명키가 없거나 잘못되면 응답과 변경은 503으로 차단됩니다."
            },
            "executionId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "readOnly": true,
              "description": "서명된 수신 경로에 사용하는 UUIDv4입니다. 전용 재발급 API에서만 변경되며 관리 API는 숫자 id를 계속 사용합니다."
            },
            "channelId": {
              "type": "integer",
              "format": "int64"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "avatarUrl": {
              "type": "string",
              "nullable": true,
              "maxLength": 512
            },
            "isActive": {
              "type": "boolean",
              "default": true
            },
            "isSecure": {
              "type": "boolean"
            },
            "token": {
              "type": "string",
              "nullable": true,
              "description": "일반 조회·수정에서는 null. 새 비밀키 발급 응답 및 발급 후 24시간 미만의 동일 요청 재생에서만 제공됩니다."
            },
            "createdBy": {
              "type": "integer",
              "format": "int64"
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            },
            "updatedAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "example": "Internal server error" }
        }
      },
      "AccountSettings": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["ONLINE", "DO_NOT_DISTURB"], "example": "ONLINE" },
          "status_expires_at": { "type": "string", "format": "date-time", "example": "2026-04-20T12:00:00Z" },
          "marketing_email": { "type": "boolean", "example": true },
          "theme": { "type": "string", "enum": ["WHITE", "BLACK"], "example": "BLACK" },
          "language": { "type": "string", "enum": ["KO", "EN"], "example": "KO" },
          "time_format": { "type": "string", "enum": ["12H", "24H"], "example": "24H" },
          "date_format": { "type": "string", "enum": ["YYYY_MM_DD", "MM_DD_YYYY", "DD_MM_YYYY", "YYYY_DD_MM", "DD_YYYY_MM", "MM_YYYY_DD"], "example": "YYYY_MM_DD" },
          "timezone": { "type": "string", "description": "IANA 시간대", "example": "Asia/Seoul" },
          "notification_level": { "type": "string", "enum": ["ALL", "MENTIONS", "NONE"], "description": "계정 기본 알림 수준", "example": "ALL" },
          "dnd_schedule": { "$ref": "#/components/schemas/DndSchedule" },
          "message_display": { "type": "string", "enum": ["COZY", "COMPACT"], "example": "COZY" },
          "enter_to_send": { "type": "boolean", "description": "Enter 키로 메시지 전송 여부", "example": true }
        }
      },
      "DndSchedule": {
        "type": "object",
        "description": "방해 금지 예약. 객체 전체를 교체하며 start/end는 timezone 기준이고 end가 start보다 이르면 자정을 넘깁니다.",
        "required": ["enabled", "start", "end"],
        "properties": {
          "enabled": { "type": "boolean", "example": true },
          "start": { "type": "string", "pattern": "^\\d{2}:\\d{2}$", "example": "22:00" },
          "end": { "type": "string", "pattern": "^\\d{2}:\\d{2}$", "example": "08:00" }
        }
      },
      "TeamSettings": {
        "type": "object",
        "properties": {
          "tag_spam_block": { "type": "boolean", "example": false },
          "nickname_format_enforced": { "type": "boolean", "description": "가입할 때 닉네임 형식을 안내하고 팀 닉네임 설정을 유도할지 여부. 서버는 형식을 판정하지 않으며 켜려면 nickname_format_example이 필요합니다.", "example": true },
          "nickname_format_example": { "type": "string", "minLength": 1, "description": "닉네임 형식 안내에 보여 줄 예시", "example": "홍길동 / 프론트엔드" },
          "default_notification_level": { "type": "string", "enum": ["ALL", "MENTIONS", "NONE"], "description": "팀 채널의 기본 알림 수준", "example": "MENTIONS" }
        }
      },
      "VoiceChannelSettings": {
        "type": "object",
        "properties": {
          "bitrate": { "type": "integer", "minimum": 8000, "maximum": 128000, "description": "클라이언트가 오디오 publish에 적용할 bps 값. 없으면 클라이언트 기본값을 씁니다.", "example": 64000 },
          "max_participants": { "type": "integer", "minimum": 0, "maximum": 99, "description": "동시 입장 최대 인원. 0이거나 없으면 제한하지 않습니다.", "example": 20 }
        }
      },
      "TextChannelSettings": {
        "type": "object",
        "properties": {
          "slowmode_seconds": { "type": "integer", "minimum": 0, "maximum": 21600, "description": "사용자별 메시지 전송 간격(초). 0은 해제", "example": 0 }
        }
      },
      "ProjectRole": {
        "type": "object",
        "properties": {
          "roleName": { "type": "string", "example": "DEVELOPER" },
          "priority": { "type": "integer", "default": 0, "description": "높은 값이 우선하며, 같은 우선순위의 충돌은 거부합니다." },
          "permissions": { "type": "object", "additionalProperties": { "type": "boolean" }, "description": "read와 write는 별도 권한이며 누락하면 false입니다.", "example": { "read": true, "write": false } }
        }
      },
      "CreateRoleRequest": {
        "type": "object",
        "required": ["roleName"],
        "properties": {
          "roleName": { "type": "string", "example": "DEVELOPER" },
          "priority": { "type": "integer", "default": 0, "description": "높은 값이 우선하며, 같은 우선순위의 충돌은 거부합니다." },
          "permissions": { "type": "object", "additionalProperties": { "type": "boolean" }, "description": "read와 write는 별도 권한이며 누락하면 false입니다.", "example": { "read": true, "write": false } }
        }
      },
      "MemberRole": {
        "type": "object",
        "properties": {
          "accountId": { "type": "integer", "format": "int64", "example": 1 },
          "roleName": { "type": "string", "example": "DEVELOPER" }
        }
      },
      "AssignRoleRequest": {
        "type": "object",
        "required": ["accountId"],
        "properties": {
          "accountId": { "type": "integer", "format": "int64", "example": 1 }
        }
      },
      "NotificationSettings": {
        "type": "object",
        "properties": {
          "notification": { "type": "boolean", "default": true, "description": "하위 호환 값. notification_level이 NONE이 아니면 true이며 요청에 notification_level이 있으면 무시됩니다.", "example": true },
          "notification_level": { "type": "string", "enum": ["ALL", "MENTIONS", "NONE", "DEFAULT"], "default": "DEFAULT", "description": "DEFAULT는 채널에 등급을 정하지 않고 계정 notification_level, 팀 default_notification_level 순서로 따릅니다. notification_level과 notification을 모두 보내지 않으면 DEFAULT로 저장합니다.", "example": "MENTIONS" },
          "muted_until": { "type": "string", "format": "date-time", "nullable": true, "description": "이 시각까지 채널 알림을 음소거합니다. null이면 음소거하지 않습니다.", "example": "2026-04-20T12:00:00Z" }
        }
      }
    }
  }
}
