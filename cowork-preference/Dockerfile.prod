FROM eclipse-temurin:26.0.2_10-jdk-noble@sha256:da98fe09607dbe8e70cc9c1bc3c731374762a3cf910df58e3183c42e4a50810c AS builder
RUN sed -i 's|http://|https://|g' /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get -o Acquire::Retries=3 update \
    && apt-get -o Acquire::Retries=3 install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ARG KOTLIN_CLI_VERSION=0.12.2
ARG KOTLIN_CLI_WRAPPER_SHA256=d8b5b852e54d4af5d92c6e1d3535ba60ec6485590e6d0dbc3666171e6136e040
RUN curl -fsSL -o /usr/local/bin/kotlin \
      "https://packages.jetbrains.team/maven/p/amper/amper/org/jetbrains/kotlin/kotlin-cli/${KOTLIN_CLI_VERSION}/kotlin-cli-${KOTLIN_CLI_VERSION}-wrapper" \
    && echo "${KOTLIN_CLI_WRAPPER_SHA256}  /usr/local/bin/kotlin" | sha256sum -c - \
    && chmod +x /usr/local/bin/kotlin
RUN --mount=type=cache,id=cowork-preference-toolchain,target=/root/.cache,sharing=locked \
    kotlin --version

WORKDIR /workspace/cowork-preference
COPY module.yaml module.yaml
COPY src src
RUN --mount=type=cache,id=cowork-preference-toolchain,target=/root/.cache,sharing=locked \
    kotlin package

FROM eclipse-temurin:26.0.2_10-jre-alpine-3.24@sha256:2c984601c59ac93f97947ce66d03df25c2e16bed97a28289fbc0ab157087f1b5 AS runtime
RUN addgroup -S -g 10001 app && adduser -S -u 10001 app -G app
WORKDIR /app
COPY --chown=app:app --from=builder /workspace/cowork-preference/build/tasks/_cowork-preference_executableJarJvm/cowork-preference-jvm-executable.jar app.jar
ENV PREFERENCE_LOG_DIR=/var/log/cowork/preference
RUN mkdir -p /var/log/cowork/preference && chown -R app:app /var/log/cowork
USER app
EXPOSE 9001
ENTRYPOINT ["java", "-XX:+UseContainerSupport", "-XX:MaxRAMPercentage=75.0", "-jar", "app.jar"]
