FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS builder
WORKDIR /workspace/cowork-promotion
COPY cowork-promotion/package.json cowork-promotion/package-lock.json ./
RUN --mount=type=cache,id=npm-promotion,target=/root/.npm npm ci
# The site validates links to repository source files while rendering TODO pages.
COPY . /workspace
ARG SOURCE_REVISION
RUN GITHUB_SHA="$SOURCE_REVISION" npm run build

FROM builder AS verification
RUN apk --no-cache add bash python3
COPY deploy/images/ci /ci
RUN --mount=type=cache,id=npm-promotion,target=/root/.npm \
    npm run lint -- --max-warnings=0 \
    && python3 /ci/untested.py /coverage/coverage.json "Static documentation rendering has no core-business unit tests."

FROM scratch AS verify
COPY --from=verification /coverage /

FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS runtime
RUN addgroup -S -g 10001 app && adduser -S -u 10001 app -G app
WORKDIR /app
COPY --from=builder --chown=app:app /workspace/cowork-promotion/public ./public
COPY --from=builder --chown=app:app /workspace/cowork-promotion/scripts/serve.mjs ./serve.mjs
USER app
EXPOSE 3000
ENTRYPOINT ["node", "serve.mjs", "public"]
