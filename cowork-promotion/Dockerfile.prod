FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS builder
WORKDIR /workspace/cowork-promotion
COPY cowork-promotion/package.json cowork-promotion/package-lock.json ./
RUN --mount=type=cache,id=npm-promotion,target=/root/.npm npm ci
# The site validates links to repository source files while rendering TODO pages.
COPY . /workspace
ARG SOURCE_REVISION
RUN npm run lint -- --max-warnings=0 \
    && GITHUB_SHA="$SOURCE_REVISION" npm run build

FROM builder AS verification
RUN apk --no-cache add bash python3
COPY deploy/images/ci /ci
RUN --mount=type=cache,id=npm-promotion,target=/root/.npm \
    bash /ci/run-native.sh node cowork-promotion /workspace /coverage \
    && python3 /ci/report.py collect --module cowork-promotion --snapshot pr --format istanbul --metric line --input /coverage/report.json --output /coverage/coverage.json --exit-code 0

FROM scratch AS verify
COPY --from=verification /coverage /
