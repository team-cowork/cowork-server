FROM eclipse-temurin:26.0.2_10-jdk-alpine-3.24@sha256:e5b0a876436e5d1c8ff84dfd091cb530b83a9ed4273317d24acb673695bb7e0c AS builder
WORKDIR /workspace

COPY gradlew gradlew
COPY gradle gradle
COPY build-logic build-logic
COPY settings.gradle.kts build.gradle.kts ./
COPY cowork-team/build.gradle.kts cowork-team/build.gradle.kts
COPY cowork-team/src cowork-team/src
# This image evaluates only its own module; other slots may use another toolchain.
RUN sed -i '/^include(/d' settings.gradle.kts \
    && printf 'include("cowork-team")\n' >> settings.gradle.kts
RUN --mount=type=cache,id=cowork-gradle,target=/root/.gradle,sharing=locked \
    chmod +x gradlew \
    && ./gradlew :cowork-team:bootJar -x test --no-daemon --build-cache \
    && artifact="$(find cowork-team/build/libs -maxdepth 1 -type f -name '*.jar' ! -name '*-plain.jar' -print -quit)" \
    && test -n "${artifact}" \
    && cp "${artifact}" /workspace/app.jar

RUN java -Djarmode=tools -jar /workspace/app.jar extract \
    --layers --launcher --destination /workspace/extracted

FROM builder AS verification
RUN apk --no-cache add bash python3 curl
COPY .editorconfig /workspace/.editorconfig
COPY deploy/images/ci /ci
RUN --mount=type=cache,id=cowork-gradle,target=/root/.gradle,sharing=locked \
    ./gradlew :cowork-team:check -x test --no-daemon --build-cache \
    && bash /ci/run-jvm.sh gradle cowork-team /workspace /coverage \
        com.cowork.team.domain.team.service.S3ServiceTest \
        com.cowork.team.domain.team.service.TeamIconOwnershipServiceTest \
        com.cowork.team.domain.team.service.impl.CreateTeamServiceImplTest \
        com.cowork.team.domain.team.service.impl.DeleteTeamIconServiceImplTest \
        com.cowork.team.domain.team.service.impl.DeleteTeamServiceImplTest \
        com.cowork.team.domain.team.service.impl.DisconnectGithubServiceImplTest \
        com.cowork.team.domain.team.service.impl.GenerateGithubInstallUrlServiceImplTest \
        com.cowork.team.domain.team.service.impl.UpdateTeamIconServiceImplTest \
        com.cowork.team.domain.team.service.impl.UpdateTeamServiceImplTest \
        com.cowork.team.domain.team.service.support.TeamGithubStateSupportTest \
        com.cowork.team.domain.teamInvite.service.impl.CreateInviteServiceImplTest \
        com.cowork.team.domain.teamInvite.service.impl.DeleteInviteServiceImplTest \
        com.cowork.team.domain.teamInvite.service.impl.JoinTeamServiceImplTest \
        com.cowork.team.domain.teamInvite.service.impl.QueryInvitesServiceImplTest \
        com.cowork.team.domain.teamMember.service.impl.ChangeTeamMemberRoleServiceImplTest \
        com.cowork.team.domain.teamMember.service.impl.InviteTeamMembersServiceImplTest \
        com.cowork.team.domain.teamMember.service.impl.RemoveTeamMemberServiceImplTest \
        com.cowork.team.domain.teamRole.service.TeamRoleAccessGuardTest \
        com.cowork.team.domain.teamRole.service.impl.CreateTeamRoleServiceImplTest \
    && python3 /ci/report.py collect --module cowork-team --snapshot pr --format jacoco --metric line --input /coverage/report.xml --output /coverage/coverage.json --exit-code 0

FROM scratch AS verify
COPY --from=verification /coverage /

FROM eclipse-temurin:26.0.2_10-jre-alpine-3.24@sha256:2c984601c59ac93f97947ce66d03df25c2e16bed97a28289fbc0ab157087f1b5 AS runtime
RUN addgroup -S -g 10001 app && adduser -S -u 10001 app -G app
WORKDIR /app
COPY --chown=app:app --from=builder /workspace/extracted/dependencies/ ./
COPY --chown=app:app --from=builder /workspace/extracted/spring-boot-loader/ ./
COPY --chown=app:app --from=builder /workspace/extracted/snapshot-dependencies/ ./
COPY --chown=app:app --from=builder /workspace/extracted/application/ ./
ENV COWORK_LOG_DIR=/var/log/cowork
RUN mkdir -p /var/log/cowork && chown app:app /var/log/cowork
USER app
EXPOSE 8085
ENTRYPOINT ["java", "-XX:+UseContainerSupport", "-XX:MaxRAMPercentage=75.0", "org.springframework.boot.loader.launch.JarLauncher"]
