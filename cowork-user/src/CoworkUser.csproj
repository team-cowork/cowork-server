<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CoworkUser</RootNamespace>
    <AssemblyName>CoworkUser</AssemblyName>
    <!-- Prod CD stamps this field. AssemblyVersion cannot hold the date-based version. -->
    <InformationalVersion>20261025.0</InformationalVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.4" />
    <PackageReference Include="Confluent.Kafka" Version="2.15.1" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="StackExchange.Redis" Version="2.13.17" />
  </ItemGroup>

  <ItemGroup>
    <!-- CD and Compose run these with the official Flyway CLI; the image only carries them. -->
    <None Include="db/migration/*.sql;db/flyway.toml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="openapi.json" LogicalName="openapi.json" />
    <InternalsVisibleTo Include="CoworkUser.Tests" />
  </ItemGroup>

</Project>
