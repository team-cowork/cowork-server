{
  "openapi": "3.0.3",
  "info": {
    "title": "cowork User API",
    "version": "20261111.1",
    "description": "사용자 프로필, 상태, 프로필 이미지와 사용자 검색을 관리합니다."
  },
  "servers": [{"url": "/api/user", "description": "Gateway"}],
  "security": [{"BearerAuth": []}],
  "paths": {
    "/users/me": {
      "get": {
        "summary": "내 프로필 조회",
        "responses": {
          "200": {
            "description": "사용자 프로필",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProfileResponse"}}}
          },
          "401": {
            "description": "액세스 토큰이 없거나 유효하지 않음",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error401"}}}
          },
          "404": {"description": "사용자 또는 프로필 없음", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error404"}}}},
          "429": {"description": "요청 한도 초과", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error429"}}}},
          "503": {
            "description": "사용자 또는 팀 멤버 정보를 아직 조회할 수 없음",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error503"}}}
          }
        }
      },
      "patch": {
        "summary": "내 프로필 수정",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nickname": {"type": "string", "nullable": true, "description": "생략하면 기존 값을 유지하고 null이면 값을 비웁니다."},
                  "name": {"type": "string"},
                  "description": {"type": "string", "nullable": true, "description": "생략하면 기존 값을 유지하고 null이면 값을 비웁니다."},
                  "github_id": {
                    "type": "string",
                    "nullable": true,
                    "description": "수정할 수 없습니다. DataGSM 값만 사용하며, 현재 값과 같으면 무시하고 다르면 400을 반환합니다."
                  },
                  "roles": {"type": "array", "items": {"type": "string"}, "description": "생략하면 기존 역할을 유지하고 빈 배열이면 역할을 모두 해제합니다."}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "사용자 프로필",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProfileResponse"}}}
          },
          "400": {"description": "요청 값이 올바르지 않음", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error400"}}}},
          "401": {
            "description": "액세스 토큰이 없거나 유효하지 않음",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error401"}}}
          },
          "404": {"description": "사용자 또는 프로필 없음", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error404"}}}},
          "415": {
            "description": "요청 본문이 application/json 형식이 아님",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error415"}}}
          },
          "429": {"description": "요청 한도 초과", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error429"}}}}
        }
      }
    },
    "/users/me/status": {
      "patch": {
        "summary": "사용자 상태와 상태 메시지 설정",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["custom_status"],
                "properties": {
                  "custom_status": {"type": "string", "maxLength": 30, "example": "DO_NOT_DISTURB"},
                  "message": {"type": "string", "maxLength": 100, "nullable": true, "example": "집중 중"},
                  "expiresAt": {"type": "string", "format": "date-time", "nullable": true, "example": "2026-05-26T18:00:00Z"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "사용자 프로필",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProfileResponse"}}}
          },
          "400": {"description": "요청 값이 올바르지 않음", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error400"}}}},
          "401": {
            "description": "액세스 토큰이 없거나 유효하지 않음",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error401"}}}
          },
          "404": {"description": "사용자 또는 프로필 없음", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error404"}}}},
          "415": {
            "description": "요청 본문이 application/json 형식이 아님",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error415"}}}
          },
          "429": {"description": "요청 한도 초과", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error429"}}}}
        },
        "description": "message와 expiresAt은 생략하면 기존 값을 유지하고 null을 보내면 지웁니다."
      }
    },
    "/users/me/profile-image/presigned": {
      "post": {
        "summary": "프로필 이미지 업로드 URL 발급",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {"schema": {"type": "object", "required": ["content_type"], "properties": {"content_type": {"type": "string"}}}}
          }
        },
        "responses": {
          "200": {
            "description": "파일 업로드 URL과 객체 키",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UploadResponse"}}}
          },
          "400": {"description": "요청 값이 올바르지 않음", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error400"}}}},
          "401": {
            "description": "액세스 토큰이 없거나 유효하지 않음",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error401"}}}
          },
          "404": {"description": "사용자 또는 프로필 없음", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error404"}}}},
          "415": {
            "description": "요청 본문이 application/json 형식이 아님",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error415"}}}
          },
          "429": {"description": "요청 한도 초과", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error429"}}}}
        }
      }
    },
    "/users/me/profile-image/confirm": {
      "post": {
        "summary": "프로필 이미지 업로드 확인",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {"schema": {"type": "object", "required": ["object_key"], "properties": {"object_key": {"type": "string"}}}}
          }
        },
        "responses": {
          "200": {"description": "응답 본문 없음"},
          "400": {"description": "요청 값이 올바르지 않음", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error400"}}}},
          "401": {
            "description": "액세스 토큰이 없거나 유효하지 않음",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error401"}}}
          },
          "404": {"description": "사용자 또는 프로필 없음", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error404"}}}},
          "409": {
            "description": "업로드한 파일이 없거나 변경됨",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error409"}}}
          },
          "413": {"description": "파일 크기 제한 초과", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error413"}}}},
          "415": {
            "description": "요청 본문이 application/json 형식이 아님",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error415"}}}
          },
          "429": {"description": "요청 한도 초과", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error429"}}}}
        }
      }
    },
    "/users/me/profile-image": {
      "delete": {
        "summary": "프로필 이미지 삭제",
        "responses": {
          "204": {"description": "응답 본문 없음"},
          "400": {"description": "요청 값이 올바르지 않음", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error400"}}}},
          "401": {
            "description": "액세스 토큰이 없거나 유효하지 않음",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error401"}}}
          },
          "404": {"description": "사용자 또는 프로필 없음", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error404"}}}},
          "409": {
            "description": "다른 요청이 프로필 이미지를 먼저 변경함",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error409"}}}
          },
          "415": {
            "description": "요청 본문이 application/json 형식이 아님",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error415"}}}
          },
          "429": {"description": "요청 한도 초과", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error429"}}}}
        }
      }
    },
    "/users/{user_id}": {
      "get": {
        "summary": "사용자 조회",
        "parameters": [{"in": "path", "name": "user_id", "required": true, "schema": {"type": "integer"}}],
        "responses": {
          "200": {
            "description": "사용자 프로필",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProfileResponse"}}}
          },
          "400": {"description": "요청 값이 올바르지 않음", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error400"}}}},
          "401": {
            "description": "액세스 토큰이 없거나 유효하지 않음",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error401"}}}
          },
          "404": {"description": "사용자 또는 프로필 없음", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error404"}}}},
          "429": {"description": "요청 한도 초과", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error429"}}}},
          "503": {
            "description": "사용자 또는 팀 멤버 정보를 아직 조회할 수 없음",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error503"}}}
          }
        }
      }
    },
    "/users/batch": {
      "get": {
        "summary": "사용자 표시 이름 일괄 조회",
        "parameters": [
          {
            "in": "query",
            "name": "ids",
            "required": true,
            "schema": {"type": "string"},
            "description": "쉼표로 구분한 사용자 ID입니다. 양의 정수만 사용하며 중복을 제외하고 최대 100개까지 조회합니다."
          }
        ],
        "responses": {
          "200": {
            "description": "사용자 표시 이름 목록",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DisplayNamesResponse"}}}
          },
          "400": {"description": "요청 값이 올바르지 않음", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error400"}}}},
          "401": {
            "description": "액세스 토큰이 없거나 유효하지 않음",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error401"}}}
          },
          "429": {"description": "요청 한도 초과", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error429"}}}},
          "503": {
            "description": "사용자 또는 팀 멤버 정보를 아직 조회할 수 없음",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error503"}}}
          }
        }
      }
    },
    "/users/search": {
      "get": {
        "summary": "사용자 검색",
        "parameters": [
          {
            "in": "query",
            "name": "teamId",
            "schema": {"type": "integer", "minimum": 1},
            "description": "지정한 팀의 멤버만 검색합니다. 요청자도 해당 팀의 멤버여야 합니다."
          },
          {
            "in": "query",
            "name": "q",
            "schema": {"type": "string"},
            "description": "이름이나 닉네임의 일부로 검색합니다. 대소문자를 구분하지 않으며 %, _ 및 역슬래시는 일반 문자로 취급합니다."
          },
          {"in": "query", "name": "query", "schema": {"type": "string"}, "description": "q를 생략하거나 공백으로 보내면 대신 사용합니다."},
          {"in": "query", "name": "name", "schema": {"type": "string"}, "description": "이름의 일부로 검색합니다. 대소문자를 구분하지 않습니다."},
          {"in": "query", "name": "nickname", "schema": {"type": "string"}, "description": "닉네임의 일부로 검색합니다. 대소문자를 구분하지 않습니다."},
          {"in": "query", "name": "major", "schema": {"type": "string"}},
          {"in": "query", "name": "student_role", "schema": {"type": "string"}},
          {"in": "query", "name": "status", "schema": {"type": "string", "enum": ["online", "offline"]}},
          {"in": "query", "name": "custom_status", "schema": {"type": "string", "maxLength": 30}},
          {"in": "query", "name": "role", "schema": {"type": "string"}},
          {"in": "query", "name": "page", "schema": {"type": "integer", "default": 1}},
          {
            "in": "query",
            "name": "page_size",
            "schema": {"type": "integer", "default": 20},
            "description": "페이지당 최대 100명까지 반환합니다."
          },
          {
            "in": "query",
            "name": "sort_by",
            "schema": {"type": "string", "default": "id"},
            "description": "id, name, nickname 또는 major로 정렬합니다. 그 밖의 값은 id로 처리합니다."
          },
          {"in": "query", "name": "sort_order", "schema": {"type": "string", "enum": ["asc", "desc"], "default": "asc"}}
        ],
        "responses": {
          "200": {
            "description": "페이지별 검색 결과",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SearchResponse"}}}
          },
          "400": {"description": "요청 값이 올바르지 않음", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error400"}}}},
          "401": {
            "description": "액세스 토큰이 없거나 유효하지 않음",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error401"}}}
          },
          "403": {
            "description": "팀 멤버만 검색할 수 있음",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error403"}}}
          },
          "429": {"description": "요청 한도 초과", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error429"}}}},
          "503": {
            "description": "사용자 또는 팀 멤버 정보를 아직 조회할 수 없음",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error503"}}}
          }
        }
      }
    },
    "/users/by-github/{githubUsername}": {
      "get": {
        "summary": "GitHub 사용자 이름으로 프로필 조회",
        "parameters": [{"in": "path", "name": "githubUsername", "required": true, "schema": {"type": "string"}}],
        "responses": {
          "200": {
            "description": "사용자 프로필",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProfileResponse"}}}
          },
          "401": {
            "description": "액세스 토큰이 없거나 유효하지 않음",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error401"}}}
          },
          "404": {"description": "사용자 또는 프로필 없음", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error404"}}}},
          "429": {"description": "요청 한도 초과", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error429"}}}},
          "503": {
            "description": "사용자 또는 팀 멤버 정보를 아직 조회할 수 없음",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error503"}}}
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {"BearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT", "description": "Cowork 액세스 토큰"}},
    "schemas": {
      "Success": {
        "type": "object",
        "required": ["status", "code", "message"],
        "properties": {
          "status": {"type": "string", "enum": ["200 OK"]},
          "code": {"type": "integer", "enum": [200]},
          "message": {"type": "string", "example": "OK"}
        }
      },
      "Error": {
        "type": "object",
        "required": ["status", "code", "message"],
        "properties": {
          "status": {"type": "string", "description": "HTTP 상태 코드와 이름입니다. 예: 200 OK."},
          "code": {"type": "integer", "description": "HTTP 상태 코드"},
          "message": {"type": "string"}
        }
      },
      "UserProfile": {
        "type": "object",
        "properties": {
          "id": {"type": "integer", "format": "int64"},
          "name": {"type": "string"},
          "email": {"type": "string"},
          "sex": {"type": "string"},
          "github_id": {"type": "string", "nullable": true},
          "account_description": {"type": "string", "nullable": true},
          "student_role": {"type": "string", "nullable": true},
          "student_number": {"type": "string", "nullable": true},
          "major": {"type": "string", "nullable": true},
          "specialty": {"type": "string", "nullable": true},
          "status": {"type": "string", "enum": ["online", "offline"]},
          "custom_status": {"type": "string", "maxLength": 30, "nullable": true, "example": "DO_NOT_DISTURB"},
          "status_message": {"type": "string", "maxLength": 100, "nullable": true},
          "status_expires_at": {"type": "string", "format": "date-time", "nullable": true},
          "profile_image_url": {"type": "string", "nullable": true},
          "nickname": {"type": "string", "nullable": true},
          "roles": {"type": "array", "items": {"type": "string"}},
          "description": {"type": "string", "nullable": true}
        },
        "required": [
          "id",
          "name",
          "email",
          "sex",
          "github_id",
          "account_description",
          "student_role",
          "student_number",
          "major",
          "specialty",
          "status",
          "custom_status",
          "status_message",
          "status_expires_at",
          "profile_image_url",
          "nickname",
          "roles",
          "description"
        ]
      },
      "ProfileResponse": {
        "allOf": [
          {"$ref": "#/components/schemas/Success"},
          {"type": "object", "required": ["data"], "properties": {"data": {"$ref": "#/components/schemas/UserProfile"}}}
        ]
      },
      "UploadResponse": {
        "allOf": [
          {"$ref": "#/components/schemas/Success"},
          {
            "type": "object",
            "required": ["data"],
            "properties": {
              "data": {
                "type": "object",
                "properties": {"upload_url": {"type": "string"}, "object_key": {"type": "string"}},
                "required": ["upload_url", "object_key"]
              }
            }
          }
        ]
      },
      "DisplayNamesResponse": {
        "allOf": [
          {"$ref": "#/components/schemas/Success"},
          {
            "type": "object",
            "required": ["data"],
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "users": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {"id": {"type": "integer"}, "name": {"type": "string"}, "nickname": {"type": "string", "nullable": true}}
                    }
                  }
                },
                "required": ["users"]
              }
            }
          }
        ]
      },
      "SearchResponse": {
        "allOf": [
          {"$ref": "#/components/schemas/Success"},
          {
            "type": "object",
            "required": ["data"],
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "items": {"type": "array", "items": {"$ref": "#/components/schemas/UserProfile"}},
                  "page": {"type": "integer"},
                  "page_size": {"type": "integer"},
                  "total_count": {"type": "integer"},
                  "has_next": {"type": "boolean"}
                },
                "required": ["items", "page", "page_size", "total_count", "has_next"]
              }
            }
          }
        ]
      },
      "Error401": {
        "allOf": [
          {"$ref": "#/components/schemas/Error"},
          {
            "type": "object",
            "properties": {"status": {"type": "string", "enum": ["401 UNAUTHORIZED"]}, "code": {"type": "integer", "enum": [401]}}
          }
        ]
      },
      "Error404": {
        "allOf": [
          {"$ref": "#/components/schemas/Error"},
