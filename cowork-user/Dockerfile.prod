ARG ELIXIR_IMAGE=hexpm/elixir:1.18.4-erlang-27.3.4-debian-bookworm-20250520-slim@sha256:ddd7c2a143023b873a72208ef6ae44f90ab3c2fb45cde9cc42ad0a8376f11071

FROM ${ELIXIR_IMAGE} AS builder
WORKDIR /app
ENV MIX_ENV=prod
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential cmake git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && mix local.hex --force \
    && mix local.rebar --force
ENV ERL_FLAGS="+S 1:1 +JMsingle true"

COPY mix.exs mix.lock ./
COPY config config
RUN --mount=type=cache,id=cowork-user-hex,target=/root/.hex,sharing=locked \
    mix deps.get --only prod \
    && mix deps.compile
COPY lib lib
COPY priv priv
RUN mix compile \
    && mix release

FROM debian:bookworm-20240926-slim@sha256:ad86386827b083b3d71139050b47ffb32bbd9559ea9b1345a739b14fec2d9ecf AS runtime
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl wget ca-certificates libstdc++6 libncurses5 locales \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r -g 10001 app \
    && useradd -r -u 10001 -g app app \
    && mkdir -p /var/log/cowork/user \
    && chown -R app:app /var/log/cowork

COPY --chown=app:app --from=builder /app/_build/prod/rel/cowork_user ./
ENV ELIXIR_ERL_OPTIONS="+fnu"
RUN chown app:app /app
USER app
EXPOSE 8082
ENTRYPOINT ["/app/bin/cowork_user", "start"]
