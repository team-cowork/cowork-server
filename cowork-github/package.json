{
  "name": "cowork-github",
  "version": "20261103.0.0",
  "private": true,
  "description": "GitHub App 연동 서비스.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=26.8.2 <27"
  },
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "bun dist/main.js",
    "start:dev": "bun run build && bun run start",
    "lint": "tsc --noEmit -p tsconfig.json && xo",
    "lint:fix": "bun run lint --fix",
    "test": "bun --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "bun run test --watch",
    "test:cov": "bun run test --coverage"
  },
  "dependencies": {
    "@nestjs/axios": "^12.0.1",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/microservices": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "axios": "^1.21.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.3.0",
    "ioredis": "^5.11.1",
    "joi": "^18.3.1",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "xo": "^5.0.1"
  },
  "overrides": {
    "glob": "14.0.3",
    "micromark-extension-math": {
      "katex": "0.18.2"
    }
  }
}
