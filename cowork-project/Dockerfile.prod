FROM eclipse-temurin:26.0.2_10-jdk-alpine-3.24@sha256:e5b0a876436e5d1c8ff84dfd091cb530b83a9ed4273317d24acb673695bb7e0c AS builder
WORKDIR /workspace/cowork-project

COPY cowork-project/.mvn .mvn
COPY cowork-project/mvnw cowork-project/pom.xml ./
RUN chmod +x mvnw
COPY cowork-project/src src
RUN --mount=type=cache,id=cowork-project-maven,target=/root/.m2,sharing=locked \
    ./mvnw -B -DskipTests clean package \
    && artifact="$(find target -maxdepth 1 -type f -name 'cowork-project-*.jar' -print -quit)" \
    && test -n "${artifact}" \
    && cp "${artifact}" /workspace/app.jar

RUN java -Djarmode=tools -jar /workspace/app.jar extract \
    --layers --launcher --destination /workspace/extracted


FROM builder AS verification
RUN apk --no-cache add bash python3 curl
COPY .editorconfig /workspace/.editorconfig
COPY deploy/images/ci /ci
RUN --mount=type=cache,id=cowork-project-maven,target=/root/.m2,sharing=locked \
    bash /ci/run-jvm.sh maven cowork-project /workspace /coverage \
        com.cowork.project.domain.github.service.ChatGithubIssueCommandProcessorTest \
        com.cowork.project.domain.github.service.GithubCommentAuthorizationSupportTest \
        com.cowork.project.domain.github.service.GithubIssueWriteResultHandlerTest \
        com.cowork.project.domain.github.service.GithubLabelPolicyReaderTest \
        com.cowork.project.domain.github.service.GithubRepoAccessResolverTest \
        com.cowork.project.domain.github.service.GithubRepoUrlParserTest \
        com.cowork.project.domain.github.service.UpdateGithubLabelPolicyServiceImplTest \
        com.cowork.project.domain.github.service.impl.AddProjectGithubRepoServiceImplTest \
        com.cowork.project.domain.github.service.impl.CreateGithubCommentServiceImplTest \
        com.cowork.project.domain.github.service.impl.DeleteGithubCommentServiceImplTest \
        com.cowork.project.domain.github.service.impl.QueryProjectGithubReposServiceImplTest \
        com.cowork.project.domain.github.service.impl.QueryPullRequestBoardServiceImplTest \
        com.cowork.project.domain.github.service.impl.RemoveProjectGithubRepoServiceImplTest \
        com.cowork.project.domain.github.service.impl.UpdateGithubCommentServiceImplTest \
        com.cowork.project.domain.github.service.impl.UpdateGithubIssueLabelsServiceImplTest \
        com.cowork.project.domain.project.service.ProjectAccessGuardTest \
        com.cowork.project.domain.project.service.impl.AddProjectMemberServiceImplTest \
        com.cowork.project.domain.project.service.impl.ClearProjectGithubWebhookChannelServiceImplTest \
        com.cowork.project.domain.project.service.impl.CreateProjectServiceImplTest \
        com.cowork.project.domain.project.service.impl.DeleteProjectServiceImplTest \
        com.cowork.project.domain.project.service.impl.RemoveProjectMemberServiceImplTest \
        com.cowork.project.domain.project.service.impl.ReorderTeamProjectsServiceImplTest \
        com.cowork.project.domain.project.service.impl.SetProjectGithubWebhookChannelServiceImplTest \
        com.cowork.project.domain.project.service.impl.UpdateProjectMemberRoleServiceImplTest \
        com.cowork.project.domain.project.service.impl.UpdateProjectServiceImplTest \
    && python3 /ci/report.py collect --module cowork-project --snapshot pr --format jacoco --metric line --input /coverage/report.xml --output /coverage/coverage.json --exit-code 0

FROM scratch AS verify
COPY --from=verification /coverage /

FROM eclipse-temurin:26.0.2_10-jre-alpine-3.24@sha256:2c984601c59ac93f97947ce66d03df25c2e16bed97a28289fbc0ab157087f1b5 AS runtime
RUN addgroup -S -g 10001 app && adduser -S -u 10001 app -G app
WORKDIR /app
COPY --chown=app:app --from=builder /workspace/extracted/dependencies/ ./
COPY --chown=app:app --from=builder /workspace/extracted/spring-boot-loader/ ./
COPY --chown=app:app --from=builder /workspace/extracted/snapshot-dependencies/ ./
COPY --chown=app:app --from=builder /workspace/extracted/application/ ./
ENV COWORK_LOG_DIR=/var/log/cowork
RUN mkdir -p /var/log/cowork && chown app:app /var/log/cowork
COPY --chmod=0755 cowork-project/deploy/bootstrap.sh /usr/local/bin/cowork-bootstrap
RUN test "$(stat -c %u /var/log/cowork)" = 10001
USER app
EXPOSE 8084
ENTRYPOINT ["/usr/local/bin/cowork-bootstrap", "java", "-XX:+UseContainerSupport", "-XX:MaxRAMPercentage=75.0", "org.springframework.boot.loader.launch.JarLauncher"]
