FROM eclipse-temurin:26.0.2_10-jdk-alpine-3.24@sha256:e5b0a876436e5d1c8ff84dfd091cb530b83a9ed4273317d24acb673695bb7e0c AS builder
WORKDIR /workspace

COPY gradlew gradlew
COPY gradle gradle
COPY build-logic build-logic
COPY settings.gradle.kts build.gradle.kts ./
COPY cowork-channel/build.gradle.kts cowork-channel/build.gradle.kts
COPY cowork-channel/src cowork-channel/src
# This image evaluates only its own module; other slots may use another toolchain.
RUN sed -i '/^include(/d' settings.gradle.kts \
    && printf 'include("cowork-channel")\n' >> settings.gradle.kts
RUN --mount=type=cache,id=cowork-gradle,target=/root/.gradle,sharing=locked \
    chmod +x gradlew \
    && ./gradlew :cowork-channel:bootJar -x test --no-daemon --build-cache \
    && artifact="$(find cowork-channel/build/libs -maxdepth 1 -type f -name '*.jar' ! -name '*-plain.jar' -print -quit)" \
    && test -n "${artifact}" \
    && cp "${artifact}" /workspace/app.jar

RUN java -Djarmode=tools -jar /workspace/app.jar extract \
    --layers --launcher --destination /workspace/extracted


FROM builder AS verification
RUN apk --no-cache add bash python3 curl
COPY .editorconfig /workspace/.editorconfig
COPY deploy/images/ci /ci
RUN --mount=type=cache,id=cowork-gradle,target=/root/.gradle,sharing=locked \
    ./gradlew :cowork-channel:check -x test --no-daemon --build-cache \
    && bash /ci/run-jvm.sh gradle cowork-channel /workspace /coverage \
        com.cowork.channel.domain.channel.service.impl.AddChannelMemberServiceImplTest \
        com.cowork.channel.domain.channel.service.impl.CreateChannelServiceImplTest \
        com.cowork.channel.domain.channel.service.impl.CreateDmServiceImplTest \
        com.cowork.channel.domain.channel.service.impl.DeleteChannelServiceImplTest \
        com.cowork.channel.domain.channel.service.impl.ListProjectChannelsServiceImplTest \
        com.cowork.channel.domain.channel.service.impl.ListTeamChannelsServiceImplTest \
        com.cowork.channel.domain.channel.service.impl.QueryChannelServiceImplTest \
        com.cowork.channel.domain.channel.service.impl.RemoveChannelMemberServiceImplTest \
        com.cowork.channel.domain.channel.service.impl.ReorderTeamChannelsServiceImplTest \
        com.cowork.channel.domain.channel.service.impl.SearchChannelsServiceImplTest \
        com.cowork.channel.domain.channel.service.impl.UpdateChannelServiceImplTest \
        com.cowork.channel.domain.channel.service.support.ChannelPermissionSupportTest \
        com.cowork.channel.domain.channelRolePolicy.service.ChannelMessageReadPolicyEvaluatorTest \
        com.cowork.channel.domain.channelRolePolicy.service.impl.QueryChannelRolePoliciesServiceImplTest \
        com.cowork.channel.domain.channelRolePolicy.service.impl.UpsertChannelRolePolicyServiceImplTest \
        com.cowork.channel.domain.channelRolePolicy.service.support.ChannelRolePolicyAccessSupportTest \
        com.cowork.channel.domain.channelRolePolicy.service.support.ChannelRolePolicyPermissionSchemaTest \
        com.cowork.channel.domain.meetingNote.service.impl.ActivateMeetingNoteTemplateServiceImplTest \
        com.cowork.channel.domain.meetingNote.service.impl.AddTemplateSectionServiceImplTest \
        com.cowork.channel.domain.meetingNote.service.impl.CreateDefaultMeetingNoteTemplateServiceImplTest \
        com.cowork.channel.domain.meetingNote.service.impl.CreateMeetingNoteServiceImplTest \
        com.cowork.channel.domain.meetingNote.service.impl.CreateMeetingNoteTemplateServiceImplTest \
        com.cowork.channel.domain.meetingNote.service.impl.DeleteMeetingNoteServiceImplTest \
        com.cowork.channel.domain.meetingNote.service.impl.DeleteMeetingNoteTemplateServiceImplTest \
        com.cowork.channel.domain.meetingNote.service.impl.DeleteTemplateSectionServiceImplTest \
        com.cowork.channel.domain.meetingNote.service.impl.GetMeetingNoteTemplateServiceImplTest \
        com.cowork.channel.domain.meetingNote.service.impl.ListMeetingNoteTemplatesServiceImplTest \
        com.cowork.channel.domain.meetingNote.service.impl.UpdateMeetingNoteServiceImplTest \
        com.cowork.channel.domain.meetingNote.service.impl.UpdateMeetingNoteTemplateServiceImplTest \
        com.cowork.channel.domain.meetingNote.service.impl.UpdateTemplateSectionServiceImplTest \
        com.cowork.channel.domain.sharedAccount.service.impl.BuildOAuthAuthorizeUrlServiceImplTest \
        com.cowork.channel.domain.sharedAccount.service.impl.CopySharedAccountCredentialServiceImplTest \
        com.cowork.channel.domain.sharedAccount.service.impl.CreateSharedAccountServiceImplTest \
        com.cowork.channel.domain.sharedAccount.service.impl.DeleteSharedAccountServiceImplTest \
        com.cowork.channel.domain.sharedAccount.service.impl.GetSharedAccountServiceImplTest \
        com.cowork.channel.domain.sharedAccount.service.impl.HandleOAuthCallbackServiceImplTest \
        com.cowork.channel.domain.sharedAccount.service.impl.ListSharedAccountsServiceImplTest \
        com.cowork.channel.domain.sharedAccount.service.impl.UpdateSharedAccountServiceImplTest \
        com.cowork.channel.domain.thread.service.impl.CreateThreadServiceImplTest \
        com.cowork.channel.domain.thread.service.impl.UpdateThreadServiceImplTest \
        com.cowork.channel.domain.webhook.service.WebhookAccessGuardTest \
        com.cowork.channel.domain.webhook.service.impl.CreateWebhookServiceImplTest \
        com.cowork.channel.domain.webhook.service.impl.DeleteWebhookServiceImplTest \
        com.cowork.channel.domain.webhook.service.impl.UpdateWebhookServiceImplTest \
    && python3 /ci/report.py collect --module cowork-channel --snapshot pr --format jacoco --metric line --input /coverage/report.xml --output /coverage/coverage.json --exit-code 0

FROM scratch AS verify
COPY --from=verification /coverage /

FROM eclipse-temurin:26.0.2_10-jre-alpine-3.24@sha256:2c984601c59ac93f97947ce66d03df25c2e16bed97a28289fbc0ab157087f1b5 AS runtime
RUN addgroup -S -g 10001 app && adduser -S -u 10001 app -G app
WORKDIR /app
COPY --chown=app:app --from=builder /workspace/extracted/dependencies/ ./
COPY --chown=app:app --from=builder /workspace/extracted/spring-boot-loader/ ./
COPY --chown=app:app --from=builder /workspace/extracted/snapshot-dependencies/ ./
COPY --chown=app:app --from=builder /workspace/extracted/application/ ./
ENV COWORK_LOG_DIR=/var/log/cowork
RUN mkdir -p /var/log/cowork && chown app:app /var/log/cowork
COPY --chmod=0755 cowork-channel/deploy/bootstrap.sh /usr/local/bin/cowork-bootstrap
RUN test "$(stat -c %u /var/log/cowork)" = 10001
USER app
EXPOSE 8083
ENTRYPOINT ["/usr/local/bin/cowork-bootstrap", "java", "-XX:+UseContainerSupport", "-XX:MaxRAMPercentage=75.0", "org.springframework.boot.loader.launch.JarLauncher"]
